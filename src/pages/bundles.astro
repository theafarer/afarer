---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `SUP & Watercraft Bundles – Complete Starter Kits | ${SITE.name}`,
  description:
    'Afarer SUP bundles — complete paddle board kits with board, pump, paddle, leash, and backpack. Factory-direct pricing on premium inflatable watercraft packages.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'Complete SUP & Watercraft Bundles',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
      datePublished: '2026-07-27',
      url: 'https://afarer.com/bundles/',
    }}
  />
  <JsonLd type="BreadcrumbList" data={{ itemListElement: [{ position: 1, name: 'Home', item: 'https://afarer.com/' }, { position: 2, name: 'Bundles', item: 'https://afarer.com/bundles/' }] }} />
  <JsonLd type="FAQPage" data={{ mainEntity: [{ "@type": "Question", name: "What is included in an Afarer SUP bundle?", acceptedAnswer: { "@type": "Answer", text: "Every Afarer inflatable SUP ships as a complete kit including the board, dual-action hand pump, adjustable aluminum paddle, coiled safety leash, removable fin set, travel backpack, and repair kit." } }, { "@type": "Question", name: "Can I customize the accessories in my bundle?", acceptedAnswer: { "@type": "Answer", text: "Yes. OEM bundle customization is available. You can choose different accessories, add custom branding, or configure bulk packaging for retail distribution." } }, { "@type": "Question", name: "Do you offer bundles without a pump or paddle?", acceptedAnswer: { "@type": "Answer", text: "Yes. We can create custom bundle configurations. Contact our OEM team to discuss a tailored bundle that matches your specific requirements." } }, { "@type": "Question", name: "Are SUP bundles available for bulk orders?", acceptedAnswer: { "@type": "Answer", text: "Yes. Bulk bundle orders are available for B2B partners including resorts, rental operators, retailers, and private label brands. Factory-direct pricing applies." } }, { "@type": "Question", name: "What is the bundle warranty?", acceptedAnswer: { "@type": "Answer", text: "All bundle components carry Afarer's standard warranty: 3 years for the SUP board, 1 year for accessories including pumps, paddles, and life vests." } }] }} />

  <section class="max-w-4xl mx-auto py-24 px-6">
    <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">Bundles</span>
    <h1 class="mt-4 text-4xl md:text-5xl font-bold text-secondary">Complete Starter Kits</h1>
    <p class="mt-4 text-lg text-gray-500">
      All Afarer inflatable SUPs ship as complete kits with everything you need to hit the water. Our bundles include:
    </p>
    <ul class="mt-8 space-y-4">
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Inflatable SUP Board</strong><p class="text-sm text-gray-500">
            Premium drop-stitch board with 15 PSI rigidity
          </p>
        </div>
      </li>
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Dual-Action Hand Pump</strong><p class="text-sm text-gray-500">
            High-pressure pump for fast inflation
          </p>
        </div>
      </li>
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Adjustable Paddle</strong><p class="text-sm text-gray-500">
            Aluminum paddle with ergonomic handle
          </p>
        </div>
      </li>
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Coiled Safety Leash</strong><p class="text-sm text-gray-500">
            Keep your board close at all times
          </p>
        </div>
      </li>
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Removable Fin Set</strong><p class="text-sm text-gray-500">
            Tracking fin for straight-line performance
          </p>
        </div>
      </li>
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Travel Backpack</strong><p class="text-sm text-gray-500">
            Wheeled backpack for easy transport and storage
          </p>
        </div>
      </li>
      <li class="flex gap-3 items-start">
        <span class="text-primary mt-1">✓</span><div>
          <strong class="text-gray-900">Repair Kit</strong><p class="text-sm text-gray-500">
            PVC patches and valve tool for field repairs
          </p>
        </div>
      </li>
    </ul>
    <div class="mt-10 p-6 bg-gray-50 rounded-2xl border border-gray-200">
      <h2 class="text-xl font-bold text-secondary">OEM Bundle Customization</h2>
      <p class="mt-2 text-sm text-gray-500">
        Need different accessories, custom branding, or bulk packaging? Contact our OEM team for tailored bundle
        configurations.
      </p>
      <a
        href="/contact"
        class="mt-4 inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full text-sm transition-all"
        >Request Bundle Quote <span>→</span></a
      >
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto pb-24 px-6">
    <div class="text-center mb-10">
      <span class="text-sm font-semibold text-primary tracking-[0.25em] uppercase">FAQs</span>
      <h2 class="mt-2 text-3xl font-bold text-gray-900">Bundle Questions</h2>
      <p class="mt-3 text-gray-500">Common questions about our SUP bundles and kits.</p>
    </div>
    <div class="space-y-4">
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
          <span>What is included in an Afarer SUP bundle?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">Every Afarer inflatable SUP ships as a complete kit including the board, dual-action hand pump, adjustable aluminum paddle, coiled safety leash, removable fin set, travel backpack, and repair kit.</p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
          <span>Can I customize the accessories in my bundle?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">Yes. OEM bundle customization is available. You can choose different accessories, add custom branding, or configure bulk packaging for retail distribution.</p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
          <span>Are SUP bundles available for bulk orders?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">Yes. Bulk bundle orders are available for B2B partners including resorts, rental operators, retailers, and private label brands. Factory-direct pricing applies.</p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
          <span>What is the bundle warranty?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">All bundle components carry Afarer's standard warranty: 3 years for the SUP board, 1 year for accessories including pumps, paddles, and life vests.</p>
        </div>
      </details>
    </div>
  </section>
</Layout>
