---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `OEM SUP Board Manufacturing – Custom Inflatable Paddle Boards Wholesale | ${SITE.name}`,
  description: `${SITE.name} offers OEM SUP board manufacturing with custom design, mold creation, prototyping, and bulk production. Custom inflatable paddle boards, CE-certified drop-stitch SUPs. MOQ 50 units. FOB Qingdao.`,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'OEM SUP Board' }];

const steps = [
  {
    step: '01',
    title: 'Design Brief',
    desc: 'Share your target specs, CAD drawings, or reference board. Our engineers review dimensions, materials, and compliance requirements before quoting.',
  },
  {
    step: '02',
    title: '3D Mold Design',
    desc: 'We design and CNC-machine custom molds for your SUP board shape. Prototype samples produced within 15-20 working days.',
  },
  {
    step: '03',
    title: 'Material Selection',
    desc: 'Choose from military-grade PVC (0.9mm-1.2mm), Hypalon CSM, or custom drop-stitch core fabrics. Pre-production samples with your branding produced for sign-off.',
  },
  {
    step: '04',
    title: 'Compliance & Testing',
    desc: 'Every OEM order includes CE declaration of conformity, ISO 9001 traceability records, and 24-hour pressure retention testing before shipment.',
  },
  {
    step: '05',
    title: 'Bulk Production',
    desc: 'Production runs follow our 100-point quality checklist. Each unit inspected before packing. AQL 2.5 inspection standard applied.',
  },
  {
    step: '06',
    title: 'FOB Shipping',
    desc: 'Finished goods palletized and container-loaded at Qingdao port. Full export documentation, customs clearance, and real-time shipment tracking.',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta
    name="ai-intent"
    content="oem-sup-board,custom-sup-manufacturer,oem-inflatable-paddle-board,sup-oem-production,private-label-sup-board"
  />
  <JsonLd type="BreadcrumbList" breadcrumbs={crumbs} />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is OEM SUP board manufacturing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'OEM SUP board manufacturing involves producing custom inflatable paddle boards to your specifications. We handle mold creation, material selection, production, quality control, and shipping — you receive boards ready for your brand.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the minimum order for OEM SUP boards?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Standard OEM orders start at 50 units per model. Sample orders and pilot runs are available from 5-10 units for new product development before committing to full production.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I customize the graphics on my OEM SUP boards?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Full graphic customization is available including logo heat-transfer, screen printing, custom colorways, and branded packaging. Our designers will work with your artwork files.',
          },
        },
        {
          '@type': 'Question',
          name: 'What materials can be used for OEM SUP board production?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We work with military-grade PVC (0.9mm-1.2mm), Hypalon CSM rubber, and custom drop-stitch core fabrics. Material selection depends on your target market, price point, and durability requirements.',
          },
        },
        {
          '@type': 'Question',
          name: 'How long does OEM SUP board production take?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Prototype samples: 15-20 working days from mold creation. Bulk production: 30-45 days from design approval. Total timeline including shipping: approximately 8-12 weeks.',
          },
        },
      ],
    }}
  />

  <!-- Hero -->
  <section class="relative py-24 px-6 overflow-hidden bg-secondary">
    <div class="absolute inset-0">
      <img
        src="https://assets.afarer.com/images/afarer/hero/production-dept.webp"
        alt="OEM SUP board manufacturing"
        class="w-full h-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/90 via-secondary/60 to-secondary/30"></div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <span class="text-sm font-semibold text-sky-300 tracking-[0.2em] uppercase">OEM Manufacturing</span>
      <h1 class="mt-4 text-4xl md:text-6xl font-bold text-white leading-tight">OEM SUP Board Manufacturing</h1>
      <p class="mt-6 text-lg text-white/80 max-w-3xl mx-auto">
        Turn your SUP board concept into a production-ready product. Afarer provides end-to-end OEM SUP board
        manufacturing — from mold design and prototyping to bulk production, compliance, and global shipping of custom
        inflatable paddle boards.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4 flex-wrap">
        <a
          href="/contact?subject=OEM%20SUP%20Quote"
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all"
          >Request OEM Quote <span>→</span></a
        >
        <a
          href="/oem-odm-manufacturer"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
          >Full OEM Services →</a
        >
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">OEM Process</span>
      <h2 class="mt-4 text-4xl font-bold text-gray-900">How OEM SUP Board Manufacturing Works</h2>
      <p class="mt-4 text-lg text-gray-500">
        Six steps from your design brief to finished custom SUP boards ready for your brand.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        steps.map((s) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition-shadow">
            <span class="text-4xl font-bold text-sky-200">{s.step}</span>
            <h3 class="mt-3 text-lg font-semibold text-gray-900">{s.title}</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Key benefits -->
  <section class="bg-gray-50 px-6 py-16 border-y border-gray-200">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">Why OEM with Afarer</span>
        <h2 class="mt-4 text-3xl font-bold text-gray-900">Benefits of OEM SUP Manufacturing</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-gray-200">
          <h3 class="font-semibold text-gray-900">Custom Design Freedom</h3>
          <p class="mt-2 text-sm text-gray-500">
            Full control over board dimensions, shape, graphics, accessories, and packaging. Your brand, your
            specifications.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-gray-200">
          <h3 class="font-semibold text-gray-900">Factory-Direct Pricing</h3>
          <p class="mt-2 text-sm text-gray-500">
            No middlemen. Direct from ISO 9001 certified manufacturer. Competitive pricing from 12,000 m² production
            facility.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-gray-200">
          <h3 class="font-semibold text-gray-900">IP Protection</h3>
          <p class="mt-2 text-sm text-gray-500">
            Strict NDA agreements, secure design file handling, and dedicated production lines for proprietary product
            protection.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-gray-200">
          <h3 class="font-semibold text-gray-900">Full Compliance Support</h3>
          <p class="mt-2 text-sm text-gray-500">
            CE certification, ISO 9001 traceability, BSCI compliance reports, and REACH material declarations included
            with every OEM order.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">FAQs</span>
      <h2 class="mt-4 text-3xl font-bold text-gray-900">OEM SUP Board FAQ</h2>
      <p class="mt-4 text-gray-500">Common questions about our OEM manufacturing process.</p>
    </div>
    <div class="space-y-4">
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What is OEM SUP board manufacturing?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            OEM SUP board manufacturing involves producing custom inflatable paddle boards to your specifications. We
            handle mold creation, material selection, production, quality control, and shipping — you receive boards
            ready for your brand.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What is the minimum order for OEM SUP boards?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Standard OEM orders start at 50 units per model. Sample orders and pilot runs are available from 5-10 units
            for new product development before committing to full production.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>Can I customize the graphics on my OEM SUP boards?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Yes. Full graphic customization is available including logo heat-transfer, screen printing, custom
            colorways, and branded packaging. Our designers will work with your artwork files.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What materials can be used for OEM SUP board production?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            We work with military-grade PVC (0.9mm-1.2mm), Hypalon CSM rubber, and custom drop-stitch core fabrics.
            Material selection depends on your target market, price point, and durability requirements.
          </p>
        </div>
      </details>
    </div>
  </section>

  <RelatedPages
    title="Related Services"
    subtitle="Explore more OEM/ODM capabilities"
    links={[
      {
        title: 'ODM Product Development',
        description: 'Full design-to-production service for new SUP products.',
        href: '/odm-sup-board',
        label: 'ODM',
      },
      {
        title: 'Private Label SUP',
        description: 'Complete private label service for your brand.',
        href: '/private-label-sup',
        label: 'Private Label',
      },
      {
        title: 'OEM/ODM Manufacturer',
        description: 'Full-spectrum OEM/ODM manufacturing services.',
        href: '/oem-odm-manufacturer',
        label: 'OEM/ODM',
      },
      {
        title: 'Custom Design',
        description: 'Custom mold design and product development.',
        href: '/design-powerhouse',
        label: 'Design',
      },
    ]}
  />
</Layout>
