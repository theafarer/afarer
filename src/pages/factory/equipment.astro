---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Factory', href: '/factory' }, { name: 'Equipment' }];

const metadata = {
  title: `Factory Equipment — Cutting, RF Welding & Printing | ${SITE.name}`,
  description: `Industrial-grade ${SITE.name} manufacturing equipment: PVC cutting, RF welding, digital printing, assembly, and testing for inflatable SUPs and boats.`,
};

const categories = [
  {
    title: 'Cutting & Material Preparation',
    items: [
      {
        name: 'Automatic PVC Cutting Machine',
        spec: 'CNC-controlled, 6.5 m × 2.5 m, 0.1 mm accuracy',
        desc: 'Computer-controlled automatic cutting machine for PVC, Hypalon, and drop-stitch fabrics. Nesting software optimises material utilisation to below 5% waste.',
      },
      {
        name: 'Fabric Spreader',
        spec: '3 m max width, tension-controlled feed',
        desc: 'Lays fabric in single or multiple plies with controlled tension to prevent distortion before cutting.',
      },
    ],
  },
  {
    title: 'Tube Welding & Bonding',
    items: [
      {
        name: 'Heat Sealing Machine',
        spec: 'Hot-air welding, variable 200–600 °C, 0.5–5 m/min',
        desc: 'Hot-air heat sealing machine for bonding and welding PVC and Hypalon tube seams. Used for tacking, sealing, and fusing tube chambers and float joints.',
      },
      {
        name: 'Dielectric RF Press',
        spec: '15 kW, platen 2000 × 600 mm',
        desc: 'Radio-frequency welding press for main longitudinal seams, transom-to-tube joints, and large-chamber fabrication.',
      },
      {
        name: 'CNC-Controlled RF Welder',
        spec: '8 kW, XY table 2500 × 1200 mm',
        desc: 'Programmable curved-seam welding for complex geometries, logo embossing, and precision patchwork.',
      },
    ],
  },

  {
    title: 'SUP Board Manufacturing',
    items: [
      {
        name: 'Drop-Stitch Core Lamination Press',
        spec: 'Large-format press for board cores up to 14 ft LOA',
        desc: 'Precision lamination of drop-stitch cores to outer PVC laminates. Each layer is pressure-bonded for consistent quality and strength.',
      },
      {
        name: 'CNC Router (5-axis)',
        spec: '3 m × 2 m × 1 m envelope, water-cooled spindle',
        desc: 'Machining of fin boxes, handle cutouts, and custom board components.',
      },
    ],
  },

  {
    title: 'SUP Printing & Decoration',
    items: [
      {
        name: 'Digital Printer',
        spec: 'High-resolution inkjet, up to 2 m print width',
        desc: 'Direct-to-fabric digital printing for full-colour SUP deck graphics. Prints custom patterns, gradients, and photo-quality images with UV-resistant water-based inks.',
      },
      {
        name: 'Screen Printing Machine',
        spec: 'Manual and semi-automatic, multi-colour registration',
        desc: 'Screen printing for SUP board logos, brand marks, and repeating patterns. Provides durable, opaque prints with vibrant colour saturation.',
      },
    ],
  },

  {
    title: 'Assembly & Rigging',
    items: [
      {
        name: 'Board Assembly Station',
        spec: 'Modular adjustable, multi-station layout',
        desc: 'Assembly of fin boxes, handles, D-rings, valves, and deck pads onto SUP boards.',
      },
      {
        name: 'Valve Installation Press',
        spec: 'Pneumatic, adjustable pressure',
        desc: 'Precision installation and sealing of Halkey-Roberts and Leafield valves.',
      },
      {
        name: 'Deck Pad Laminator',
        spec: '3 m × 1.5 m, temperature-controlled',
        desc: 'Heat lamination of EVA foam deck pads to SUP board tops with consistent bond strength.',
      },
    ],
  },

  {
    title: 'Testing & Quality Control',
    items: [
      {
        name: 'Universal Tensile Tester',
        spec: '50 kN, ASTM D751',
        desc: 'Breaking force, elongation at break, and tear propagation testing for fabric batches.',
      },
      {
        name: 'Air Retention Test Rig',
        spec: 'Programmable, 30-min pressure-hold',
        desc: 'Automated pressure-hold test for every tube chamber before assembly.',
      },
      {
        name: 'Seam Peel Tester',
        spec: 'Motorised 180° peel at 100 mm/min',
        desc: 'Weld and glued-seam peel strength testing per ISO 6185.',
      },
      {
        name: 'Xenon-Arc Weathering Chamber',
        spec: '2000 h exposure',
        desc: 'UV resistance testing for colour change and strength retention.',
      },
    ],
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-6 sm:px-6 py-16 sm:py-20 mx-auto max-w-5xl">
    <a href="/factory" class="text-sm text-gray-500 hover:underline">&larr; Back to Factory</a>
    <div class="mt-4 max-w-3xl">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">Equipment</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold">Manufacturing Equipment & Machinery</h1>
      <p class="mt-3 text-lg text-muted">Industrial-grade equipment across cutting, welding, printing, and assembly</p>
    </div>
  </section>

  <section class="px-6 sm:px-6 pb-20 mx-auto max-w-5xl space-y-16">
    {
      categories.map((cat) => (
        <div>
          <h2 class="text-2xl font-bold mb-6">{cat.title}</h2>
          <div class="grid gap-4">
            {cat.items.map((eq) => (
              <div class="p-5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1">
                    <h3 class="font-bold">{eq.name}</h3>
                    <p class="text-sm text-primary font-medium mt-0.5">{eq.spec}</p>
                    <p class="text-sm text-muted mt-2">{eq.desc}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <section class="px-6 sm:px-6 pb-20 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">Interested in a factory tour?</h2>
      <p class="mt-2 text-sm text-muted">
        We welcome visitors to our Qingdao facility. See our equipment and processes in person.
      </p>
      <a
        href="/contact"
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
      >
        Schedule a visit →
      </a>
    </div>
  </section>
</Layout>
