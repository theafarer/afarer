---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Factory', href: '/factory' }, { name: 'Production Process' }];

const metadata = {
  title: `Manufacturing Process –From Raw Material to Finished SUP | ${SITE.name}`,
  description: `${SITE.name} manufacturing process: material inspection, PVC automatic cutting, heat sealing, SUP digital printing, assembly, quality testing, and shipping.`,
};

const steps = [
  {
    step: '01',
    title: 'Material Receipt & Inspection',
    description:
      'Every incoming batch of PVC fabric, fiberglass mat, resin, and hardware is inspected against specification. Fabric samples are tested for tensile strength, thickness uniformity, and UV resistance before release to production. Non-conforming materials are quarantined and returned.',
    duration: '1– days',
  },
  {
    step: '02',
    title: 'Automatic PVC Cutting',
    description:
      'Approved fabrics are laid on the automatic CNC cutting machine and cut with sub-millimetre accuracy. Computer-optimised nesting arranges panels to minimise waste –typically below 5%. Cut panels are labelled by boat model and chamber, then bundled for transfer to the welding workshop.',
    duration: '2– hours per boat kit',
  },
  {
    step: '03',
    title: 'Tube Heat Sealing & Welding',
    description:
      'Panels are tacked and bonded using heat sealing machines with hot-air welding at controlled temperatures of 200–00 掳C. Main seams are reinforced with RF dielectric welding for airtight, high-strength joints. Completed chambers are inflated to 1.5脳 working pressure for 30-minute air-retention validation.',
    duration: '1– days per boat',
  },
  {
    step: '04',
    title: 'SUP Board Core Assembly',
    description:
      'Drop-stitch fabric cores are tensioned and laminated with multiple layers of PVC for structural rigidity. Valve bases are heat-sealed into the board surface, and rail bands are welded along the perimeter for impact protection. Each core undergoes a preliminary inflation test at 1.5x working pressure.',
    duration: '1– days per board',
  },
  {
    step: '05',
    title: 'SUP Printing & Decoration',
    description:
      'SUP board deck graphics are applied using digital printing for full-colour photo-quality designs, and screen printing for durable logos and repeating patterns. Prints are cured and sealed for UV and abrasion resistance.',
    duration: '1– days',
  },
  {
    step: '06',
    title: 'Final Assembly & Finishing',
    description:
      'Printed deck is bonded to the core assembly, and the traction pad is applied. Fin boxes, leash plugs, and carry handles are installed. Accessories such as repair kits, pumps, and travel bags are packed per order. Each board follows a 50-point finish checklist with mandatory sign-off.',
    duration: '1 day',
  },
  {
    step: '07',
    title: 'Quality Testing & Inspection',
    description:
      'Every completed board undergoes mandatory quality gate: chamber air-retention test, valve seal check, fastener torque verification, and cosmetic inspection. Custom and prototype builds also receive in-water stability and handling tests.',
    duration: '1– days',
  },
  {
    step: '08',
    title: 'Packing & Shipping',
    description:
      'Boards are deflated, folded per procedure, packed in heavy-duty woven bags or boxes, and loaded for shipment. Each package is labelled with model, serial number, and destination. We coordinate with freight forwarders for FCL and LCL container shipments worldwide.',
    duration: '1 day',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-6 sm:px-6 py-16 sm:py-20 mx-auto max-w-5xl">
    <a href="/factory" class="text-sm text-gray-500 hover:underline">&larr; Back to Factory</a>
    <div class="mt-4 max-w-3xl">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">Process</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold">Manufacturing Process</h1>
      <p class="mt-3 text-lg text-muted">From raw material to sea-ready board –every step under our control</p>
    </div>
  </section>

  <section class="px-6 sm:px-6 pb-20 mx-auto max-w-4xl">
    <p class="text-muted leading-relaxed mb-12">
      Unlike brands that outsource production to third-party factories, {SITE.name} owns and operates its entire manufacturing
      chain. This vertical integration allows us to maintain strict quality control at every stage, respond quickly to custom
      requirements, and deliver consistent product quality batch after batch. Here is how a SUP board is built in our facility.
    </p>

    <div class="space-y-10">
      {
        steps.map((s) => (
          <div class="relative pl-16">
            <div class="absolute left-0 top-0 w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">
              {s.step}
            </div>
            <div class="border-l-2 border-gray-200 dark:border-gray-700 pl-8 pb-2">
              <div class="flex items-start justify-between gap-4">
                <h2 class="text-xl font-bold">{s.title}</h2>
                <span class="text-xs text-muted whitespace-nowrap shrink-0 mt-1">{s.duration}</span>
              </div>
              <p class="mt-2 text-muted leading-relaxed">{s.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-6 sm:px-6 pb-20 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">See our equipment and machinery</h2>
      <p class="mt-2 text-sm text-muted">Explore the industrial-grade equipment behind every afarer board.</p>
      <a
        href="/factory/equipment"
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
      >
        View equipment →
      </a>
    </div>
  </section>
</Layout>
