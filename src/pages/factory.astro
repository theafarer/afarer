---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `SUP Factory China – 12,000m² ISO 9001 Inflatable SUP Manufacturing Facility | ${SITE.name}`,
  description: `${SITE.name}'s 12,000 m² ISO 9001 certified SUP factory in Qingdao, China. Specializing in inflatable SUP board manufacturing with advanced drop-stitch lamination, CNC mold making, and full QC labs.`,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Factory' }];

const stats = [
  { value: '12,000 m²', label: 'ISO 9001 certified production facility' },
  { value: '200+', label: 'Skilled workers across production lines' },
  { value: '15,000+', label: 'Units produced annually' },
  { value: '10', label: 'Dedicated SUP production lines' },
];

const depts = [
  {
    title: 'PVC Lamination Workshop',
    desc: 'High-temperature drop-stitch core lamination with precision thickness control. Multi-layer PVC bonding for military-grade durability.',
  },
  {
    title: 'CNC Mold Workshop',
    desc: 'Computer-controlled mold fabrication for custom SUP board shapes. Aluminum and composite molds with micron-level precision.',
  },
  {
    title: 'Assembly & Kitting Line',
    desc: 'Dedicated assembly stations for board finishing, valve installation, deck pad application, and full accessory kitting.',
  },
  {
    title: 'Quality Control Lab',
    desc: 'In-house testing for pressure retention, UV resistance, abrasion, low-temperature performance, and seam strength.',
  },
  {
    title: 'Packaging & Logistics',
    desc: 'Custom packaging design, retail-ready box assembly, and container loading at Qingdao port for global shipping.',
  },
  {
    title: 'R&D Prototype Workshop',
    desc: 'Rapid prototyping facility for new product development. 3D printing, sample fabrication, and design validation.',
  },
];

const certs = [
  {
    name: 'ISO 9001',
    desc: 'Quality management system certified for consistent product quality and continuous improvement.',
  },
  { name: 'CE', desc: 'European conformity certification for all inflatable SUP board models.' },
  {
    name: 'BSCI',
    desc: 'Business Social Compliance Initiative audit — ethical manufacturing and fair labor practices.',
  },
  { name: 'REACH', desc: 'EU chemical safety compliance — all materials meet REACH substance restrictions.' },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta
    name="ai-intent"
    content="afarer-factory,sup-board-factory,inflatable-sup-manufacturing-plant,qingdao-sup-factory,iso-9001-sup-manufacturer"
  />
  <JsonLd type="BreadcrumbList" breadcrumbs={crumbs} />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: "Where is Afarer's factory located?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Our factory is located in Qingdao, Shandong Province, China — a major port city with direct access to global shipping routes. Address: Qingdao Vatrad Group, Chengyang District, Qingdao.',
          },
        },
        {
          '@type': 'Question',
          name: "Is Afarer's factory ISO 9001 certified?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Our 12,000 m² facility is ISO 9001 certified for quality management systems. We undergo regular audits to maintain certification.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I visit the factory for an audit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. We welcome factory visits and third-party audits. Contact our sales team to schedule a tour of our production facility in Qingdao.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the production capacity of the factory?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Our factory produces over 15,000 units annually across 10 dedicated SUP production lines. Capacity can be scaled during peak seasons.',
          },
        },
        {
          '@type': 'Question',
          name: 'What certifications does the factory hold?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'ISO 9001 (quality management), CE (European conformity), BSCI (social compliance), and REACH (chemical safety). All certifications are current and audited annually.',
          },
        },
      ],
    }}
  />

  <!-- Hero -->
  <section class="relative py-24 px-6 overflow-hidden bg-secondary">
    <div class="absolute inset-0">
      <img
        src="https://assets.afarer.com/images/afarer/factory/afarer-factory-exterior.webp"
        alt="Afarer factory exterior"
        class="w-full h-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/90 via-secondary/60 to-secondary/30"></div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <span class="text-sm font-semibold text-sky-300 tracking-[0.2em] uppercase">Our Factory</span>
      <h1 class="mt-4 text-4xl md:text-6xl font-bold text-white leading-tight">
        Inflatable SUP Manufacturing Facility
      </h1>
      <p class="mt-6 text-lg text-white/80 max-w-3xl mx-auto">
        12,000 m² ISO 9001 certified SUP factory in Qingdao, China. Advanced manufacturing lines for inflatable SUP
        boards with complete quality control and global shipping capabilities for wholesale and custom orders.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4 flex-wrap">
        <a
          href="/contact?subject=Factory%20Visit"
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all"
          >Schedule a Factory Tour <span>→</span></a
        >
        <a
          href="/oem-odm-manufacturer"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
          >Manufacturing Services →</a
        >
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-white px-6 py-16 border-b border-gray-200">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      {
        stats.map((s) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-primary">{s.value}</div>
            <div class="mt-2 text-sm text-gray-500">{s.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Departments -->
  <section class="bg-gray-50 px-6 py-16">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">Production Departments</span>
        <h2 class="mt-4 text-4xl font-bold text-gray-900">Inside Our Factory</h2>
        <p class="mt-4 text-lg text-gray-500">
          Six specialized departments working together to produce premium inflatable SUP boards.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          depts.map((d) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
              <h3 class="text-lg font-semibold text-gray-900">{d.title}</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{d.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">Certifications</span>
      <h2 class="mt-4 text-4xl font-bold text-gray-900">Factory Certifications & Compliance</h2>
      <p class="mt-4 text-lg text-gray-500">
        Our manufacturing facility meets international quality, safety, and social compliance standards.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        certs.map((c) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center hover:shadow-md transition-shadow">
            <div class="text-xl font-bold text-primary">{c.name}</div>
            <p class="mt-2 text-sm text-gray-500">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-gray-50 px-6 py-16 border-y border-gray-200">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">FAQs</span>
        <h2 class="mt-4 text-3xl font-bold text-gray-900">Factory FAQ</h2>
        <p class="mt-4 text-gray-500">Common questions about our manufacturing facility.</p>
      </div>
      <div class="space-y-4">
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>Where is Afarer's factory located?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Our factory is located in Qingdao, Shandong Province, China — a major port city with direct access to
              global shipping routes. Address: Qingdao Vatrad Group, Chengyang District, Qingdao.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>Is Afarer's factory ISO 9001 certified?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Yes. Our 12,000 m² facility is ISO 9001 certified for quality management systems. We undergo regular
              audits to maintain certification.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>Can I visit the factory for an audit?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Yes. We welcome factory visits and third-party audits. Contact our sales team to schedule a tour of our
              production facility in Qingdao.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What certifications does the factory hold?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              ISO 9001 (quality management), CE (European conformity), BSCI (social compliance), and REACH (chemical
              safety). All certifications are current and audited annually.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <RelatedPages
    title="Related Pages"
    subtitle="Explore more about Afarer manufacturing"
    links={[
      {
        title: 'OEM/ODM Manufacturer',
        description: 'Full-spectrum OEM and ODM manufacturing services.',
        href: '/oem-odm-manufacturer',
        label: 'OEM/ODM',
      },
      {
        title: 'SUP Manufacturer',
        description: 'Factory-direct SUP board manufacturing.',
        href: '/sup-manufacturer',
        label: 'Manufacturer',
      },
      {
        title: 'Quality Control',
        description: 'ISO 9001 certified quality management system.',
        href: '/quality',
        label: 'Quality',
      },
      {
        title: 'Quality Testing',
        description: 'Comprehensive product testing and certification.',
        href: '/quality-testing',
        label: 'Testing',
      },
    ]}
  />
</Layout>
