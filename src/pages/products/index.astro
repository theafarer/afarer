---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import QuickViewModal from '~/components/widgets/QuickViewModal.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Icon from '~/components/ui/Icon.astro';

import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import {
  getProducts,
  getProductCategories,
  isProductsEnabled,
  isProductsListEnabled,
  CATEGORY_SLUG_TO_URL,
} from '~/utils/products';
import { PRODUCT_LIST, getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';

const products = await getProducts();
const categories = await getProductCategories();
const rawCategory = (Astro.url?.searchParams?.get('category') ?? '') as 'accessory' | 'sup' | '';
const activeCategory = rawCategory === 'accessory' || rawCategory === 'sup' ? rawCategory : null;
const filteredProducts = activeCategory ? products.filter((p) => p.category === activeCategory) : products;
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();

const metadata = merge(
  {
    title: `Inflatable SUP Products –OEM Manufacturer | ${SITE.name}`,
    description: `Browse the full ${SITE.name} product catalog –inflatable SUP boards and accessories. OEM/ODM available for bulk wholesale orders. Factory-direct pricing.`,
    canonical: getCanonical(getPermalink(PRODUCT_LIST)),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Products', item: 'https://afarer.com/products/' },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What products does afarer manufacture?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Afarer manufactures inflatable SUP boards (all-around, touring, fishing, yoga, racing, kids), marine accessories (life vests, pumps, paddles, repair kits, bags), and commercial inflatable boats and RIBs.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I get custom manufacturing for my product needs?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. We offer OEM/ODM services including custom design, private label, bulk wholesale, and contract manufacturing for all our product categories.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are afarer products available for bulk orders?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Factory-direct and wholesale pricing is available for bulk orders. Contact our B2B team for quantity-based pricing and lead times.',
          },
        },
        {
          '@type': 'Question',
          name: 'What certifications do afarer products carry?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All afarer products are CE certified. Life vests comply with ISO 12402. Boats and SUPs are designed to ISO 6185 standards. Our factory is ISO 9001 and BSCI certified.',
          },
        },
      ],
    }}
  />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Catalog</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">afarer products</h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        Premium inflatable boats, RIBs, accessories and engineered products –built for life on the water.
      </p>
    </header>

    {
      categories.length > 0 && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href={getPermalink(PRODUCT_LIST)}
              class:list={[
                'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                !activeCategory
                  ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                  : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
              ]}
            >
              <Icon name="tabler:layout-grid" class="w-4 h-4" />
              All ({totalCount})
            </a>
            {categories.map((c) => (
              <a
                href={`/${CATEGORY_SLUG_TO_URL[c.slug]}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                  activeCategory === c.slug
                    ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                    : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                ]}
              >
                {c.title} ({c.count})
              </a>
            ))}
          </div>
        </WidgetWrapper>
      )
    }

    {
      filteredProducts.length === 0 ? (
        <div class="text-center py-16 text-muted dark:text-slate-400">
          <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4" />
          <p class="text-lg">No products in this category yet.</p>
          <a
            class="text-primary dark:text-blue-400 hover:underline mt-2 inline-block"
            href={getPermalink(PRODUCT_LIST)}
          >
            View all products
          </a>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {filteredProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      )
    }
  </section>

  {filteredProducts.map((p) => <QuickViewModal productId={p.slug} />)}

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      afarer product catalog: inflatable SUP boards (all-around, touring, yoga, fishing, adventure, surf), marine
      accessories (life jackets, pumps, paddles, repair kits, bags), OEM/ODM services (custom design, private label,
      contract manufacturing). All products CE certified, compliant. Factory-direct and wholesale pricing available.
    </p>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto pb-20 px-6">
    <div class="text-center mb-10">
      <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">FAQs</span>
      <h2 class="mt-2 text-3xl font-bold text-gray-900">Product FAQ</h2>
      <p class="mt-3 text-gray-500">Common questions about our product range and manufacturing.</p>
    </div>
    <div class="space-y-4">
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What products does afarer manufacture?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Afarer manufactures inflatable SUP boards (all-around, touring, fishing, yoga, racing, kids), marine
            accessories (life vests, pumps, paddles, repair kits, bags), and commercial inflatable boats and RIBs.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>Can I get custom manufacturing for my product needs?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Yes. We offer OEM/ODM services including custom design, private label, bulk wholesale, and contract
            manufacturing for all our product categories.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>Are afarer products available for bulk orders?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Yes. Factory-direct and wholesale pricing is available for bulk orders. Contact our B2B team for
            quantity-based pricing and lead times.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What certifications do afarer products carry?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            All afarer products are CE certified. Life vests comply with ISO 12402. Boats and SUPs are designed to ISO
            6185 standards. Our factory is ISO 9001 and BSCI certified.
          </p>
        </div>
      </details>
    </div>
  </section>
</Layout>
