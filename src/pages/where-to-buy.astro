---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/where-to-buy.ts';
import __contactData from '~/i18n/generated/pages/contact.ts';
import countryData from '~/data/site/countries.yaml';
import formTextData from '~/data/site/contact-form-text.yaml';
import cfg from '~/config.yaml';

const lang = Astro.locals.lang || 'en';

setPageContentData(__pageData);
const page = getPageContent(lang, 'where-to-buy') || {};
const hero = page.hero || {};
const channels = page.channels?.items || [];
const formIntro = page.form_intro || {};
const businessNote = page.business_note || {};

setPageContentData(__contactData);
const contactPage = getPageContent(lang, 'contact') || {};
const branding = (cfg as any)?.branding || {};
const ft: any = formTextData ?? {};
const form = contactPage.contact_form ?? {};

function t(record: Record<string, string> | undefined, fallback = ''): string {
  return record?.[lang] || record?.en || fallback;
}

const fields = (form.fields ?? []).map((f: any) => {
  const trans = (ft.fields ?? []).find((tf: any) => tf.name === f.name);
  if (trans) {
    return {
      ...f,
      label: t(trans.label, f.label),
      placeholder: t(trans.placeholder, f.placeholder ?? ''),
    };
  }
  return f;
});

const countries =
  (countryData as any).countries?.map((c: any) => ({
    value: c.value,
    label: c.label?.[lang] || c.label?.en || c.value,
  })) ?? [];

const countryCodes =
  (countryData as any).countries?.map((c: any) => ({
    code: c.tel,
    label: `${c.label?.[lang] || c.label?.en || c.value} ${c.tel}`,
  })) ?? [];

const submitButton = t(ft.submit_button) || form.submit_button || 'Send message';
const successMessage = t(ft.success_message) || form.success_message || 'Thanks!';
const errorMessage = t(ft.error_message) || form.error_message || 'Something went wrong.';
const consentText = t(ft.consent_text) || form.consent?.text;
const consentLinkText = t(ft.consent_link_text) || form.consent?.link_text;

const consent = form.consent
  ? {
      ...form.consent,
      text: consentText,
      link_text: consentLinkText,
    }
  : undefined;

const brandingData: any = branding ?? {};
const resolvedEmailTo =
  (form.email_to && String(form.email_to).trim()) || (brandingData.contact_email_to as string) || '';

const metadata = {
  title: page.meta?.title || `Where to Buy — ${SITE.name}`,
  description: page.meta?.description || 'Find out how to buy an Afarer inflatable paddle board.',
};
---

<Layout metadata={metadata} breadcrumbs={[{ name: 'Home', href: '/' }, { name: hero.tagline || 'Where to Buy' }]}>
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Where to Buy', item: 'https://afarer.com/where-to-buy/' },
      ],
    }}
  />

  <section class="bg-gradient-to-br from-sky-600 via-sky-700 to-blue-800 text-white py-20 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <span class="text-sm font-semibold tracking-widest uppercase text-sky-200">{hero.tagline || 'Where to Buy'}</span>
      <h1 class="mt-4 text-4xl md:text-5xl font-bold">{hero.title || 'Get Your Afarer SUP on the Water'}</h1>
      <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">{hero.subtitle || ''}</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="grid md:grid-cols-2 gap-8">
      {
        channels.map((item: any, i: number) => (
          <div class="bg-white rounded-2xl border border-gray-200 p-8 flex flex-col shadow-sm">
            <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center text-sky-600 mb-6">
              {i === 0 ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              )}
            </div>
            <h2 class="text-xl font-semibold text-gray-900">{item.title}</h2>
            <p class="mt-3 text-gray-500">{item.description}</p>
            <div class="mt-6 pt-6 border-t border-gray-100 mt-auto">
              <a
                href="#availability"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-sky-600 text-white text-sm font-semibold hover:bg-sky-700 transition-colors"
              >
                {item.cta}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="availability" class="max-w-6xl mx-auto py-16 px-6 scroll-mt-20">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-semibold text-gray-900">{formIntro.title || 'Ask About Availability'}</h2>
      <p class="mt-4 text-lg text-gray-500">{formIntro.subtitle || ''}</p>
    </div>
    <div class="mt-10">
      <ContactUs
        id={form.id ?? 'form'}
        title={form.title}
        subtitle={form.subtitle}
        emailTo={resolvedEmailTo}
        submitButton={submitButton}
        successMessage={successMessage}
        errorMessage={errorMessage}
        fields={fields}
        consent={consent}
        defaultCountryCode={form.default_country_code ?? '+1'}
        countryCodes={countryCodes}
        countries={countries}
      />
    </div>
  </section>

  <section class="bg-gray-50 py-14 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-lg text-gray-600">{businessNote.text || ''}</p>
      {
        businessNote.cta && (
          <a
            href={(businessNote.href as string) || '/solutions/'}
            class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-full border border-sky-600 text-sky-700 text-sm font-semibold hover:bg-sky-50 transition-colors"
          >
            {businessNote.cta}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        )
      }
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Afarer where-to-buy page explaining how to purchase an Afarer inflatable paddle board: through official country
      distributors or by ordering directly from the Afarer team.
    </p>
  </section>
</Layout>
