---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import { products } from '../data/products';

import cfg from '~/config.yaml';
import { getEntityGraphJsonLd } from '~/lib/geo-v7/entity-graph';
const branding = (cfg as any)?.branding || {};
import techCardsData from '~/data/site/tech-cards.yaml';
import productVisualsData from '~/data/site/product-visuals.yaml';

const metadata = {
  title: 'Afarer — Performance Inflatable SUP Boards & Water Sports Gear',
  description:
    'Afarer builds performance inflatable SUP boards and water sports gear for all-round, touring, fitness, and family paddling. Rigid drop-stitch construction at 12–15 PSI, pressure-tested board by board, with exclusive country partnerships and limited co-branded collections.',
  ignoreTitleTemplate: true,
};

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11': 'https://assets.afarer.com/images/afarer/products/sup-series/sup-jungle-mandala-app-1-1200w.webp',
  'airdeck-360': 'https://assets.afarer.com/images/afarer/products/afarer-inflatable-boat.webp',

  'life-vest-classic': 'https://assets.afarer.com/images/afarer/products/afarer-life-vest-classic.webp',
  'life-vest-pro': 'https://assets.afarer.com/images/afarer/products/afarer-life-vest-pro-front.webp',
  'oars-pump-set': 'https://assets.afarer.com/images/afarer/products/afarer-electric-pump.webp',
};
const rawVisuals = ((productVisualsData as any)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

interface FaqItem {
  q: string;
  a: string;
  category?: string;
}
const defaultFaqItems: FaqItem[] = [
  {
    q: 'What makes Afarer different?',
    a: 'Afarer is a global inflatable SUP brand, operated by Aquafarer LLC (USA). Our Qingdao Operation Team builds every board at a 12,000 m² ISO 9001 certified facility, with in-house engineering, board-by-board pressure testing, and a small number of exclusive country partnerships worldwide.',
    category: 'sup',
  },
  {
    q: 'What quality control does Afarer apply?',
    a: 'Afarer applies quality inspection throughout the process: incoming material inspection, in-process production QC, 24-hour pressure retention testing, seam peel verification, and final shipment inspection. Every product carries a CE declaration of conformity.',
    category: 'sup',
  },
  {
    q: 'What are the typical lead times and payment terms?',
    a: 'Sample orders ship within 15–20 working days. Standard partner orders are 30–45 days from design approval to FOB Qingdao. Payment terms are typically 30% deposit with 70% balance before shipment.',
    category: 'sup',
  },
  {
    q: 'How do country partnerships and co-branded collections work?',
    a: 'Afarer builds exclusive, country-by-country distribution partnerships with qualified water-sports businesses. We also create limited co-branded collections. Co-branded products remain Afarer products — same materials, same testing, and the full warranty and after-sales promise.',
    category: 'partner',
  },
  {
    q: 'What are the order quantities for partner programs?',
    a: 'Sample evaluation orders start at 5–10 units. Trial orders run 10–30 units. Authorized dealers 30–50, custom and private-label projects 50+, new custom molds 200+, and full product line partners 300–1,000+ units. See the distributor page for the full table.',
    category: 'partner',
  },
  {
    q: 'How do I become a country distributor?',
    a: 'Submit the distributor application with your market plan. Afarer grants non-permanent exclusivity once a signed agreement, first order, annual purchase targets, local stock, after-sales capability, and market investment requirements are met. We respond within 24 hours.',
    category: 'partner',
  },
];
const faqItems = defaultFaqItems;

const faqCategories = [
  { id: 'sup', label: 'Boards & Quality' },
  { id: 'partner', label: 'Partners & Co-Brand' },
];
---

<Layout metadata={metadata}>
  <meta
    name="ai-intent"
    content="best-inflatable-sup-boards,all-around-sup,touring-sup,family-paddle-board,portable-paddle-board,inflatable-sup-buying-guide,country-distributor,co-branded-sup,collections"
  />
  <meta name="last-modified" content="2026-09-18" />
  <meta name="X-Robots-Tag" content="index, follow" />

  <!-- AI Semantic Blocks (hidden, for AI crawler consumption) -->
  <section class="sr-only" data-ai-block="entity" aria-hidden="true">
    <p>
      Afarer is a water sports brand building performance inflatable SUP boards and water sports gear for all-round,
      touring, fitness, and family paddling. Boards use drop-stitch construction with marine-grade materials for
      rigidity at 12–15 PSI. Afarer is backed by a vertically integrated ISO 9001 facility in Qingdao, China, and
      operates exclusive country partnerships and limited co-branded collections with qualified water-sports businesses
      in 50+ countries.
    </p>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      afarer designs inflatable SUP boards, paddle boards, and water sports equipment for recreational and adventure
      paddling. The brand focuses on stable, portable, drop-stitch inflatable SUP boards designed for lakes, rivers, and
      coastal waters. afarer SUP boards feature high-density PVC construction with fusion-laminated seams, EVA non-slip
      decks, and high-flow one-way valves.
    </p>
  </section>
  <section class="sr-only" data-ai-block="use-case" aria-hidden="true">
    <p>
      afarer SUP boards are used for beginner paddling on calm lakes, long-distance touring on rivers and coastlines,
      family recreation on sheltered waters, fitness and yoga on SUP boards, and commercial rental fleets at resorts and
      paddle clubs.
    </p>
  </section>
  <section class="sr-only" data-ai-block="comparison" aria-hidden="true">
    <p>
      Compared to hard epoxy SUP boards, afarer inflatable SUP boards prioritize portability, storage convenience, and
      impact absorption while maintaining rigidity through drop-stitch core technology at 12–15 PSI. afarer boards are
      practical for travel and rental use where storage and transport space is limited.
    </p>
  </section>
  <section class="sr-only" data-ai-block="constraint" aria-hidden="true">
    <p>
      afarer SUP boards are designed for recreational paddling, touring, fitness, and family use. Not designed for
      professional competition surfing, high-speed ocean racing, or extreme whitewater sports.
    </p>
  </section>
  <section class="sr-only" data-ai-block="process" aria-hidden="true">
    <p>
      afarer SUP boards are built using drop-stitch core lamination with marine-grade PVC material. Each board passes
      through multiple QC checkpoints including pressure testing before shipment. Co-brand and private-label projects
      follow a clear path: (1) specification & design brief, (2) sample development with in-house 3D prototyping, (3)
      sample approval and certification, (4) bulk production with inline QC testing. Sample orders start at 5 units;
      standard co-brand orders from 50 units, and custom molds from 200+ units.
    </p>
  </section>

  <!-- 01 Hero Banner -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-secondary">
    <div class="absolute inset-0">
      <img
        src="https://assets.afarer.com/images/afarer/hero/production-dept.webp"
        alt="Afarer inflatable SUP board production line in Qingdao"
        class="w-full h-full object-cover opacity-30"
        style="object-position: center 40%;"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/90 via-secondary/60 to-secondary/30"></div>
    </div>
    <div class="absolute top-1/4 -right-1/4 w-[600px] h-[600px] rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute -bottom-1/4 left-1/4 w-[500px] h-[500px] rounded-full bg-primary/5 blur-3xl"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="max-w-4xl">
        <div class="reveal">
          <span
            class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-white/50 mb-6"
          >
            <span class="w-8 h-px bg-primary"></span>
            Performance Inflatable SUP Boards &amp; Water Sports Gear
          </span>
          <h1
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.05] text-balance text-white"
          >
            Go Farther.<br class="hidden sm:block" /> Ride Stronger.
          </h1>
          <p class="sr-only">
            Afarer designs performance inflatable SUP boards for all-round, touring, fitness, and adventure paddling.
          </p>
          <p class="mt-6 text-lg md:text-xl text-white/70 max-w-3xl text-pretty leading-relaxed">
            Rigid at 12–15 PSI, pressure-tested board by board, and built to pack down and go anywhere —<br
              class="hidden md:block"
            />
            on lakes, rivers, and coastlines.
          </p>
          <div class="mt-10 flex items-center gap-4 flex-wrap">
            <a
              href="/inflatable-sup"
              class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-xl hover:shadow-2xl transition-all hover:-translate-y-0.5"
            >
              Explore Boards
              <span class="text-lg">→</span>
            </a>
            <a
              href="/size-guide"
              class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 text-white/80 font-medium rounded-full hover:bg-white/10 hover:text-white transition-all backdrop-blur-sm"
            >
              Find Your Ride
            </a>
            <a
              href="/afarer-story"
              class="inline-flex items-center gap-2 px-8 py-4 border border-white/10 text-white/60 font-medium rounded-full hover:bg-white/10 hover:text-white transition-all backdrop-blur-sm text-sm"
            >
              Why Afarer
            </a>
          </div>
          <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-white/60">
            <span class="flex items-center gap-2"
              ><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> 12–15 PSI Drop-Stitch Rigidity</span
            >
            <span class="flex items-center gap-2"
              ><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Pressure-Tested Board by Board</span
            >
            <span class="flex items-center gap-2"
              ><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> CE &amp; ISO 9001 Quality Standards</span
            >
            <span class="flex items-center gap-2"
              ><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Ships to 50+ Countries</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Products We Manufacture -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">Boards &amp; Gear</span>
      <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary">Find the Board That Fits Your Water</h2>
      <p class="mt-4 text-lg text-gray-500">
        From stable all-around boards to fast touring shapes — plus the gear that goes with them.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <a
        href="/all-around-sup"
        class="group relative rounded-2xl overflow-hidden bg-white border border-gray-200 hover:shadow-xl transition-all duration-300"
      >
        <div class="aspect-[4/3] bg-gradient-to-br from-blue-50 to-cyan-50 flex items-center justify-center p-6">
          <img
            src="https://assets.afarer.com/images/afarer/products/sup-series/sup-cheetah-surge-1-1200w.webp"
            alt="All-Around SUP"
            class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">All-Around SUP</span>
          <h3 class="mt-2 text-xl font-bold text-secondary">All-Around SUP</h3>
          <p class="mt-2 text-sm text-gray-500">
            Stable, versatile boards for beginners, families, and casual paddlers.
          </p>
        </div>
      </a>
      <a
        href="/touring-sup"
        class="group relative rounded-2xl overflow-hidden bg-white border border-gray-200 hover:shadow-xl transition-all duration-300"
      >
        <div class="aspect-[4/3] bg-gradient-to-br from-blue-50 to-sky-50 flex items-center justify-center p-6">
          <img
            src="https://assets.afarer.com/images/afarer/products/sup-series/sup-ocean-voyager-1-1200w.webp"
            alt="Touring SUP"
            class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">Touring SUP</span>
          <h3 class="mt-2 text-xl font-bold text-secondary">Touring SUP</h3>
          <p class="mt-2 text-sm text-gray-500">
            Longer, narrower shapes built for distance paddling, with cargo tie-downs for multi-day trips.
          </p>
        </div>
      </a>
      <a
        href="/fishing-sup"
        class="group relative rounded-2xl overflow-hidden bg-white border border-gray-200 hover:shadow-xl transition-all duration-300"
      >
        <div class="aspect-[4/3] bg-gradient-to-br from-blue-50 to-teal-50 flex items-center justify-center p-6">
          <img
            src="https://assets.afarer.com/images/afarer/products/sup-series/sup-leviathan-wake-1-1200w.webp"
            alt="Fishing SUP"
            class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">Fishing SUP</span>
          <h3 class="mt-2 text-xl font-bold text-secondary">Fishing SUP</h3>
          <p class="mt-2 text-sm text-gray-500">
            Wide, stable platforms for anglers with rod holder mounts, gear tracks, and generous weight capacity.
          </p>
        </div>
      </a>
      <a
        href="/yoga-sup"
        class="group relative rounded-2xl overflow-hidden bg-white border border-gray-200 hover:shadow-xl transition-all duration-300"
      >
        <div class="aspect-[4/3] bg-gradient-to-br from-blue-50 to-gray-50 flex items-center justify-center p-6">
          <img
            src="https://assets.afarer.com/images/afarer/products/sup-series/sup-dolphin-wave-1-1200w.webp"
            alt="Yoga SUP"
            class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">Yoga SUP</span>
          <h3 class="mt-2 text-xl font-bold text-secondary">Yoga SUP</h3>
          <p class="mt-2 text-sm text-gray-500">
            Extra-wide, ultra-stable decks for fitness and yoga, with grippy EVA padding and secure tie-downs.
          </p>
        </div>
      </a>
    </div>
    <div class="text-center mt-12">
      <a
        href="/inflatable-sup"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all"
      >
        View All SUP Categories <span>→</span>
      </a>
    </div>
  </section>

  <!-- 07 Featured Products -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">Featured Products</span>
      <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary">Popular Afarer Models</h2>
      <p class="mt-4 text-lg text-gray-500">
        Our most-loved platforms, ready to ride. Pick your size or fine-tune the details.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        products
          .filter((p) => ['sup-explorer-11', 'sup-ocean-voyager', 'sup-dolphin-wave'].includes(p.id))
          .map((p) => {
            const img =
              productVisuals[p.id] ||
              'https://assets.afarer.com/images/afarer/products/sup-series/sup-jungle-mandala-app-1-1200w.webp';
            return (
              <a
                href={'/products/' + p.id}
                class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              >
                <div class="aspect-[4/3] bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
                  <img
                    src={img}
                    alt={p.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <div class="flex flex-wrap gap-2 mb-3">
                    <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-medium rounded-full">
                      {p.use_case}
                    </span>
                    <span class="px-3 py-1 bg-gray-100 text-gray-600 text-xs font-medium rounded-full">{p.skill}</span>
                  </div>
                  <h3 class="text-xl font-bold text-secondary">{p.name}</h3>
                  <p class="mt-2 text-sm text-gray-500">{p.desc}</p>
                </div>
              </a>
            );
          })
      }
    </div>
    <div class="text-center mt-12">
      <a
        href="/compare/sup-vs-hardboard"
        class="inline-flex items-center gap-2 px-8 py-4 border-2 border-gray-300 text-gray-700 font-semibold rounded-full hover:border-primary hover:text-primary transition-all"
      >
        Compare SUP Models <span>→</span>
      </a>
    </div>
  </section>

  <!-- 05 Technology -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">Technology</span>
      <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary">Innovation Behind Every Board</h2>
      <p class="mt-4 text-lg text-gray-500">
        Afarer combines advanced inflatable technology with practical outdoor design. Our engineering focuses on
        stiffness, stability, portability and durability — creating SUP boards that perform wherever adventure happens.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        ((techCardsData as any)?.cards || []).map((card: any) => (
          <div class="relative bg-white border border-gray-200 rounded-2xl p-8 text-center hover:shadow-md transition-shadow overflow-hidden">
            <div class="absolute inset-0">
              <img
                src={card.image || 'https://assets.afarer.com/images/afarer/products/sup-series/sup-jungle-mandala-app-1-1200w.webp'}
                alt={card.title || 'afarer technology'}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-white/75" />
            </div>
            <div class="relative">
              <div class="w-20 h-20 bg-white/90 border border-gray-200 rounded-2xl flex items-center justify-center mx-auto text-3xl font-bold text-gray-700">
                {card.badge || '?'}
              </div>
              <h3 class="mt-6 text-lg font-semibold text-gray-900">{card.title || ''}</h3>
              <p class="mt-3 text-gray-500 text-sm leading-relaxed">{card.description || ''}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="text-center mt-12">
      <a href="/research/drop-stitch-technology" class="text-sm font-medium text-primary hover:text-[#0088B3]"
        >Explore SUP Technology →</a
      >
    </div>
  </section>

  <!-- 02 Manufacturing Overview -->
  <section class="relative py-28 md:py-36 px-6 bg-white overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-4xl mx-auto">
        <div class="reveal">
          <span
            class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-6"
          >
            <span class="w-8 h-px bg-primary"></span>
            Quality &amp; Manufacturing
          </span>
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] text-balance text-secondary"
          >
            Quality You Can Verify
          </h2>
          <p class="mt-8 text-lg text-gray-500 leading-relaxed max-w-3xl mx-auto">
            Afarer is operated by Aquafarer LLC (USA). Our Qingdao Operation Team runs a 12,000 m² ISO 9001 certified
            facility producing 15,000+ inflatable boats, SUPs, and RIBs annually. It is the same facility that builds
            every Afarer board, and it also serves exclusive country partners in 50+ countries.
          </p>
        </div>
      </div>
      <div class="mt-16 grid md:grid-cols-4 gap-6">
        <div class="bg-[#F8FAFB] rounded-2xl p-8 text-center">
          <span class="text-4xl font-bold text-primary">12,000 m²</span>
          <p class="mt-2 text-sm text-gray-500">ISO 9001 certified production facility in Qingdao, China</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-2xl p-8 text-center">
          <span class="text-4xl font-bold text-primary">200+</span>
          <p class="mt-2 text-sm text-gray-500">Skilled manufacturing workers and production engineers</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-2xl p-8 text-center">
          <span class="text-4xl font-bold text-primary">15,000+</span>
          <p class="mt-2 text-sm text-gray-500">Units produced annually — SUPs, boats, and RIBs</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-2xl p-8 text-center">
          <span class="text-4xl font-bold text-primary">50+</span>
          <p class="mt-2 text-sm text-gray-500">Countries served across Europe, Americas, Asia, and Oceania</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 Manufacturing Knowledge -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-sm font-semibold text-primary tracking-[0.15em] uppercase">Buyer's Knowledge</span>
        <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary">Resources for SUP Buyers</h2>
        <p class="mt-4 text-lg text-gray-500">
          Guides and resources to help you make confident decisions — as a paddler or a partner.
        </p>
      </div>
      <div class="grid md:grid-cols-4 gap-6">
        <a
          href="/research/how-to-choose-sup-manufacturer"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all hover:-translate-y-0.5"
        >
          <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              ></path></svg
            >
          </div>
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            How to Choose a SUP Partner
          </h3>
          <p class="mt-2 text-sm text-gray-500">10 questions to ask before selecting a production partner.</p>
        </a>
        <a
          href="/research/oem-vs-odm-sup-manufacturing"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all hover:-translate-y-0.5"
        >
          <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
