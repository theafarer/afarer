---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';

const metadata = {
  title: 'Fishing SUP Board | Inflatable Paddle Board for Fishing | Afarer OEM Manufacturer',
  description:
    'Afarer fishing SUP boards — stable, wide inflatable paddle boards designed for anglers. Mount accessories, store gear, and access remote fishing spots silently. OEM/ODM manufacturing available for brands, resorts, and clubs.',
  ignoreTitleTemplate: true,
};
const pageUrl = 'https://afarer.com/fishing-sup/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: "Fishing SUP Board — The Angler's Floating Platform",
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: 'https://afarer.com/inflatable-sup/' },
        { position: 3, name: 'Fishing SUP', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        { '@type': 'Question', name: 'What makes a good fishing SUP board?', acceptedAnswer: { '@type': 'Answer', text: 'A good fishing SUP needs a wide stable platform (34"+), sufficient weight capacity for angler plus gear, D-ring grid for mounting accessories, and durable multi-chamber construction for safety. Quiet approach and shallow draft are key advantages over boats.' } },
        { '@type': 'Question', name: 'Can you stand up and fish on a SUP?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Fishing SUPs are designed with extra-wide decks (34"–36") that provide the stability needed for stand-up casting. The broad platform distributes weight evenly, allowing anglers to stand, kneel, or sit while fishing.' } },
        { '@type': 'Question', name: 'What accessories do I need for SUP fishing?', acceptedAnswer: { '@type': 'Answer', text: 'Essential SUP fishing accessories include a rod holder, anchor system, cooler or crate for gear, a personal flotation device, and a waterproof bag for electronics. Many fishing SUPs come with a D-ring grid for easy accessory mounting.' } },
        { '@type': 'Question', name: 'Is SUP fishing safe?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Choose a multi-chamber inflatable SUP for redundancy, always wear a life vest, use a leash, and check weather conditions before heading out. Avoid strong currents, wind, and boat traffic.' } },
        { '@type': 'Question', name: 'Do you manufacture fishing SUPs for private label?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Afarer offers OEM/ODM manufacturing for fishing SUP boards with custom accessory mounting systems, deck graphics, color matching, and compliance documentation for brands and retail partners worldwide.' } },
      ]
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href="/inflatable-sup/"
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← SUP Product Center</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">SUP Category</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        Fishing SUP Board
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Fishing from a SUP gives anglers silent access to shallow coves, reed beds, and remote shorelines that boats
        cannot reach. Afarer fishing SUPs provide the stability, deck space, and mounting options needed for a
        productive day on the water. Stand, kneel, or sit while casting — the wide platform keeps you steady.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Why SUP Fishing?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Silent Approach</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            No motor noise, no hull slap. Glide silently into fishing spots without spooking fish. The ultimate stealth
            angling platform.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Shallow Water Access</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            With only 4–6 inches of draft, navigate ultra-shallow waters, marshes, and flats that motorized boats cannot
            reach.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Customizable Setup</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            D-ring grid and bungee deck rigging accommodate cooler mounts, rod holders, crate systems, and anchor
            attachments.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">Best Fishing SUP Boards</h2>
      <p class="text-gray-500 mb-8">
        Our ultra-stable SUPs provide the ideal fishing platform. Wide decks support standing casts and gear storage.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href="/products/sup-tropical-breeze"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-amber-50 to-orange-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-tropical-breeze-1.webp"
              alt="Tropical Breeze Series"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Tropical Breeze Island Escape
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              Extra-wide SUP with maximum primary stability. Ideal for stand-up casting and gear organization.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
        <a
          href="/products/sup-explorer-11"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-blue-50 to-cyan-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/afarer-sup-allround-board.webp"
              alt="SUP Explorer 11'"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">SUP Explorer 11'</h3>
            <p class="mt-2 text-sm text-gray-500">
              Versatile all-around SUP with great stability. Bungee deck rigging for securing fishing gear and coolers.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Who Is a Fishing SUP For?</h2>
        <p class="mt-4 text-lg text-gray-500">Built for anglers who want to fish where boats cannot go.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Kayak Anglers Exploring SUP</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Stand-up casting gives you a visibility advantage over kayak fishing. Spot fish, structure, and cover from an elevated position while accessing the same shallow waters.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Fly Fishing Enthusiasts</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">The silent, draft-free platform is perfect for fly fishing still water. Drift quietly across flats and sight-cast to cruising fish without spooking them.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Weekend Sport Anglers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Carry your fishing SUP in a backpack to remote lakes and rivers. No trailer needed. Set up, launch, and start fishing in minutes.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Resort & Guide Services</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Offer SUP fishing as a guided experience. Durable, easy to store, and customizable with resort branding. OEM programs available.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">OEM/ODM Manufacturing for Fishing SUPs</h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Afarer manufactures fishing SUP boards for global brands, outfitters, and retail chains. Our production lines produce CE-certified fishing SUPs with custom accessory mounting, deck graphics, and packaging. MOQ from 50 units. Lead times from 30 days.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">Custom</span>
          <p class="mt-1 text-sm text-gray-500">Graphics, accessories, packaging</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">Units minimum order</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">30 Days</span>
          <p class="mt-1 text-sm text-gray-500">Typical lead time</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/oem-odm-manufacturer" class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all">Request OEM Quote <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">Fishing SUP — Frequently Asked Questions</h2>
      <p class="text-lg text-gray-500 text-center mb-12">Common questions about selecting, using, and manufacturing fishing paddle boards.</p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What makes a good fishing SUP board?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">A good fishing SUP needs a wide stable platform (34"+), sufficient weight capacity for angler plus gear, D-ring grid for mounting accessories, and durable multi-chamber construction for safety. Quiet approach and shallow draft are key advantages over boats.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can you stand up and fish on a SUP?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Fishing SUPs are designed with extra-wide decks (34"–36") that provide the stability needed for stand-up casting. The broad platform distributes weight evenly, allowing anglers to stand, kneel, or sit while fishing.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What accessories do I need for SUP fishing?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Essential SUP fishing accessories include a rod holder, anchor system, cooler or crate for gear, a personal flotation device, and a waterproof bag for electronics. Many fishing SUPs come with a D-ring grid for easy accessory mounting.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Is SUP fishing safe?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Choose a multi-chamber inflatable SUP for redundancy, always wear a life vest, use a leash, and check weather conditions before heading out. Avoid strong currents, wind, and boat traffic.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture fishing SUPs for private label?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Afarer offers OEM/ODM manufacturing for fishing SUP boards with custom accessory mounting systems, deck graphics, color matching, and compliance documentation for brands and retail partners worldwide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary">Fishing SUP Resources</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a href="/compare/single-chamber-vs-multi-chamber" class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Safety for Anglers</h3>
        <p class="mt-2 text-sm text-gray-500">Why multi-chamber SUPs are safer for fishing.</p>
      </a>
      <a href="/compare/pvc-vs-hypalon" class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Durable SUP Materials</h3>
        <p class="mt-2 text-sm text-gray-500">PVC vs Hypalon for fishing applications.</p>
      </a>
      <a href="/compare/inflatable-vs-hardboard" class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Inflatable vs Hard for Fishing</h3>
        <p class="mt-2 text-sm text-gray-500">Why inflatable SUPs excel for anglers.</p>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Explore Fishing SUP Options</h2>
    <p class="mt-4 text-lg text-gray-500">
      Contact us for custom fishing SUP configurations, bulk orders, or OEM production.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >Get a Quote <span>→</span></a
    >
  </section>
</Layout>
