---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';

const metadata = {
  title: 'Kids SUP Board | Best Inflatable Paddle Board for Children | Afarer OEM Manufacturer',
  description:
    'Afarer kids SUP boards — smaller, lighter inflatable paddle boards designed for children. Shorter length, lower volume, and kid-friendly designs for safe family paddling. OEM/ODM manufacturing available for brands and retailers.',
  ignoreTitleTemplate: true,
};
const pageUrl = 'https://afarer.com/kids-sup/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'Kids SUP Board — Introducing Children to Paddle Boarding',
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: 'https://afarer.com/inflatable-sup/' },
        { position: 3, name: 'Kids SUP', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What age is appropriate for a kids SUP board?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Children as young as 5–6 years old can start on a kids SUP board with adult supervision. Boards for young children are typically 8'–9' long with lower volume and lighter weight for easy handling.",
          },
        },
        {
          '@type': 'Question',
          name: 'What size SUP does a child need?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "A kids SUP should match the child's weight and height. For children under 80 lbs, an 8'–9' board with 26\"–28\" width is appropriate. For teens and larger children, a 9'–10' board with 28\"–30\" width works well.",
          },
        },
        {
          '@type': 'Question',
          name: 'Are inflatable SUPs safe for children?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Inflatable SUPs are actually safer for children than hard boards because they have no sharp edges or hard rails. The soft inflatable construction cushions falls and reduces injury risk. Always pair with a life vest and adult supervision.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can adults use kids SUP boards?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Kids SUPs are designed for lower weight ranges and shorter heights. Adults generally exceed the weight capacity and will find the board unstable and underperforming. Adults should use appropriately sized boards.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you manufacture kids SUPs for private label?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Afarer offers OEM/ODM manufacturing for kids SUP boards with kid-friendly graphics, smaller form factors, and custom packaging for brands and retailers targeting family paddlers.',
          },
        },
      ],
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href="/inflatable-sup/"
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← SUP Product Center</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">SUP Category</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        Kids SUP Board
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Introducing children to paddle boarding builds confidence, balance, and a lifelong connection to the water.
        Afarer kids SUPs are designed with shorter lengths, lower volume, and kid-friendly proportions that make
        learning natural and fun. Lighter and easier to handle than adult boards, they give young paddlers the
        independence they crave.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">What Makes a Great Kids SUP?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-50 to-green-100 flex items-center justify-center mx-auto mb-4"
          >
            <svg class="w-7 h-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 12h2m2 0h2m2 0h2m2 0h2m2 0h2"></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-secondary">Right-Sized Proportions</h3>
          <p class="mt-3 text-sm text-gray-500">
            Shorter length (8'–9') and narrower width match a child's height, weight, and paddle reach for natural
            technique development.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center mx-auto mb-4"
          >
            <svg class="w-7 h-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 3v2.25M12 21v-2.25M3 12h2.25M18.75 12H21M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-secondary">Lightweight Design</h3>
          <p class="mt-3 text-sm text-gray-500">
            At 12–15 lbs, kids can carry their own board from car to water. Builds responsibility and independence from
            day one.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-red-50 to-red-100 flex items-center justify-center mx-auto mb-4"
          >
            <svg class="w-7 h-7 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-secondary">Soft Safe Construction</h3>
          <p class="mt-3 text-sm text-gray-500">
            Inflatable construction means no sharp edges or hard rails. Soft EVA deck provides grip and cushion for
            active kids.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">Kids SUP Safety Tips</h2>
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-gray-200 p-6">
          <h3 class="font-semibold text-gray-900">Always Wear a Life Vest</h3>
          <p class="mt-2 text-sm text-gray-500">
            Children should wear a properly fitted USCG-approved life vest at all times on the water. Check our <a
              href="/products/life-vest-classic"
              class="text-primary hover:underline">Life Vest Classic</a
            > for kid-friendly options.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-6">
          <h3 class="font-semibold text-gray-900">Start in Calm Shallow Water</h3>
          <p class="mt-2 text-sm text-gray-500">
            Choose protected lakes or gentle rivers with sandy entry. Avoid wind, current, and boat traffic for early
            sessions.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-6">
          <h3 class="font-semibold text-gray-900">Use a Leash & SUP Buddy</h3>
          <p class="mt-2 text-sm text-gray-500">
            A coiled leash keeps the board close. Children should always paddle with an adult SUP buddy within arm's
            reach.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Who Is a Kids SUP For?</h2>
        <p class="mt-4 text-lg text-gray-500">Built for young paddlers and the families who love the water.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Active Families</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Give your children the same water experiences you enjoy. A kids SUP lets the whole family paddle together
            with age-appropriate equipment.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">SUP Schools & Camps</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Youth paddle programs need small, lightweight boards that children can handle independently. Durable
            construction withstands heavy use across multiple seasons.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Confidence Building</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Paddle boarding builds balance, coordination, and water confidence in children. The sense of independence
            from paddling their own board is invaluable.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Resort Family Programs</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Family-friendly resorts stock kids SUPs for young guests. Lightweight and easy to store, they expand water
            activity offerings without significant investment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">OEM/ODM Manufacturing for Kids SUPs</h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Afarer manufactures kids SUP boards for global brands, outdoor retailers, and family-focused resort chains. Our
        production lines produce CE-certified kids SUPs with child-friendly graphics, lighter construction, and custom
        packaging. MOQ from 50 units. Lead times from 30 days.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">Custom</span>
          <p class="mt-1 text-sm text-gray-500">Graphics, size, packaging</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">Units minimum order</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">30 Days</span>
          <p class="mt-1 text-sm text-gray-500">Typical lead time</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a
          href="/oem-odm-manufacturer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
          >Request OEM Quote <span>→</span></a
        >
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        Kids SUP — Frequently Asked Questions
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        Common questions about selecting, using, and manufacturing kids paddle boards.
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What age is appropriate for a kids SUP board?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Children as young as 5–6 years old can start on a kids SUP board with adult supervision. Boards for young
            children are typically 8'–9' long with lower volume and lighter weight for easy handling.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What size SUP does a child need?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            A kids SUP should match the child's weight and height. For children under 80 lbs, an 8'–9' board with
            26"–28" width is appropriate. For teens and larger children, a 9'–10' board with 28"–30" width works well.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Are inflatable SUPs safe for children?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Yes. Inflatable SUPs are actually safer for children than hard boards because they have no sharp edges or
            hard rails. The soft inflatable construction cushions falls and reduces injury risk. Always pair with a life
            vest and adult supervision.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can adults use kids SUP boards?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Kids SUPs are designed for lower weight ranges and shorter heights. Adults generally exceed the weight
            capacity and will find the board unstable and underperforming. Adults should use appropriately sized boards.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture kids SUPs for private label?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Yes. Afarer offers OEM/ODM manufacturing for kids SUP boards with kid-friendly graphics, smaller form
            factors, and custom packaging for brands and retailers targeting family paddlers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary">Family SUP Resources</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a
        href="/compare/single-chamber-vs-multi-chamber"
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Family Safety Guide</h3>
        <p class="mt-2 text-sm text-gray-500">Multi-chamber safety for family paddling.</p>
      </a>
      <a
        href="/compare/pvc-vs-hypalon"
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Durable Materials</h3>
        <p class="mt-2 text-sm text-gray-500">Why PVC is ideal for kids boards.</p>
      </a>
      <a
        href="/compare/inflatable-vs-hardboard"
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Inflatable for Families</h3>
        <p class="mt-2 text-sm text-gray-500">Why inflatable SUPs are safer for children.</p>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Find the Perfect Kids SUP Board</h2>
    <p class="mt-4 text-lg text-gray-500">
      Contact us about kids SUP board availability, bulk family sets, and OEM production.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >Contact Us <span>→</span></a
    >
  </section>
</Layout>
