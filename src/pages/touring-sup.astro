---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';

  const metadata = {
    title: 'Touring SUP Board | Long-Distance Inflatable Paddle Board | Afarer OEM Manufacturer',
    description:
      'Afarer touring SUP boards — long-distance inflatable paddle boards with superior glide, pointed bows, and efficient tracking for lakes, coastal exploration, and multi-day expeditions. OEM/ODM manufacturing available for brands, resorts, and clubs.',
    ignoreTitleTemplate: true,
  };
const pageUrl = 'https://afarer.com/touring-sup/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'Touring SUP Board — Engineered for Long-Distance Exploration',
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: 'https://afarer.com/inflatable-sup/' },
        { position: 3, name: 'Touring SUP', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        { '@type': 'Question', name: 'What is a touring SUP board?', acceptedAnswer: { '@type': 'Answer', text: 'A touring SUP board is a longer inflatable paddle board (12\'–14\') designed for efficient long-distance paddling on open water. It features a pointed displacement bow, deeper keel lines for tracking, and higher volume for carrying expedition gear.' } },
        { '@type': 'Question', name: 'Is a touring SUP good for beginners?', acceptedAnswer: { '@type': 'Answer', text: 'Touring SUPs can be used by beginners on calm water, but their longer length makes them less maneuverable than all-around boards. Beginners comfortable with basic paddling technique will appreciate the superior tracking.' } },
        { '@type': 'Question', name: 'How long should a touring SUP be?', acceptedAnswer: { '@type': 'Answer', text: 'Touring SUPs typically range from 12\' to 14\'. A 12\' board works well for day trips and lighter paddlers. A 14\' board offers maximum glide for long-distance expeditions and heavier paddlers.' } },
        { '@type': 'Question', name: 'Can you use a touring SUP for racing?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Many touring SUPs are suitable for recreational racing and endurance events. Dedicated racing boards are lighter and narrower, but touring boards offer a good balance of speed and stability.' } },
        { '@type': 'Question', name: 'Do you manufacture touring SUPs for private label?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Afarer offers OEM/ODM manufacturing for touring SUP boards with custom lengths, deck graphics, color matching, and compliance documentation for brands and retail partners worldwide.' } },
      ]
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href="/inflatable-sup/"
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← SUP Product Center</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">SUP Category</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        Touring SUP Board
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Touring SUPs are purpose-built for long-distance paddling. Afarer touring boards feature longer hulls (12'–14'),
        pronounced displacement bows, and efficient glide profiles that track straight through open water. Whether
        crossing a lake or exploring coastal shorelines, a touring SUP delivers the speed and range that recreational
        boards cannot match.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Why Choose a Touring SUP?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Superior Glide Efficiency</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Longer waterline length and a sharp displacement bow cut through chop and reduce drag. Each paddle stroke
            moves you farther with less effort.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Precise Tracking</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Deep keel lines and straight hull profiles keep the board on course without constant correction strokes.
            Ideal for covering distance efficiently.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Expedition-Ready Capacity</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Higher volume and weight capacity allow carrying gear for multi-day trips. Bungee deck rigging secures dry
            bags and equipment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">Best Touring SUP Products</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href="/products/sup-ocean-pulse"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-indigo-50 to-blue-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-ocean-pulse-1.webp"
              alt="Ocean Pulse Series"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Ocean Pulse Series
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              Performance touring SUP with 12' hull, displacement nose, and intermediate skill rating. Ideal for fitness
              paddling and coastal exploration.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
        <a
          href="/products/sup-ocean-voyager"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-sky-50 to-cyan-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-ocean-voyager-1.webp"
              alt="Ocean Voyager Series"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Ocean Voyager Series
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              Advanced touring SUP for experienced paddlers. Longer hull, aggressive displacement bow, designed for
              open-water expeditions.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Who Is a Touring SUP For?</h2>
        <p class="mt-4 text-lg text-gray-500">Purpose-built for paddlers who want to cover distance.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Distance Paddlers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">If you regularly paddle 5–15 miles per session, a touring SUP reduces fatigue and makes each stroke count. Superior glide means more water covered with less effort.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Expedition & Multi-Day Trips</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Higher volume and weight capacity allow carrying camping gear, food, and water for overnight trips. Bungee deck rigging secures dry bags and equipment.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Fitness-Focused Paddlers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Longer waterline and efficient hull design provide a better workout at higher speeds. Touring SUPs reward proper technique with noticeably faster paddling.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Resort & Rental Programs</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Guided tours and excursion programs benefit from touring SUPs. Their tracking and efficiency make group paddling easier. OEM branding available for custom programs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">OEM/ODM Manufacturing for Touring SUPs</h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Afarer manufactures touring SUP boards for global brands, expedition outfitters, and retail chains. Our drop-stitch production lines produce CE-certified touring boards with custom length options, deck graphics, and packaging. MOQ from 50 units. Lead times from 30 days.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">Custom</span>
          <p class="mt-1 text-sm text-gray-500">Length, graphics, color, packaging</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">Units minimum order</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">30 Days</span>
          <p class="mt-1 text-sm text-gray-500">Typical lead time</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/oem-odm-manufacturer" class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all">Request OEM Quote <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">Touring SUP — Frequently Asked Questions</h2>
      <p class="text-lg text-gray-500 text-center mb-12">Common questions about selecting, using, and manufacturing touring paddle boards.</p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What is a touring SUP board?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">A touring SUP board is a longer inflatable paddle board (12'–14') designed for efficient long-distance paddling on open water. It features a pointed displacement bow, deeper keel lines for tracking, and higher volume for carrying expedition gear.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Is a touring SUP good for beginners?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Touring SUPs can be used by beginners on calm water, but their longer length makes them less maneuverable than all-around boards. Beginners comfortable with basic paddling technique will appreciate the superior tracking.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">How long should a touring SUP be?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Touring SUPs typically range from 12' to 14'. A 12' board works well for day trips and lighter paddlers. A 14' board offers maximum glide for long-distance expeditions and heavier paddlers.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can you use a touring SUP for racing?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Many touring SUPs are suitable for recreational racing and endurance events. Dedicated racing boards are lighter and narrower, but touring boards offer a good balance of speed and stability.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture touring SUPs for private label?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Afarer offers OEM/ODM manufacturing for touring SUP boards with custom lengths, deck graphics, color matching, and compliance documentation for brands and retail partners worldwide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related CTA -->
  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Explore Further with a Touring SUP</h2>
    <p class="mt-4 text-lg text-gray-500">
      Contact our team for bulk pricing, OEM options, or technical specifications.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
    >
      Inquire About Touring SUPs <span>→</span>
    </a>
  </section>
</Layout>
