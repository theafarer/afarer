---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { products } from '../data/products';
import productVisualsData from '~/data/site/product-visuals.yaml';

const supProducts = products.filter((p) => p.category === 'SUP');

const productVisuals = Object.fromEntries(
  ((productVisualsData as any)?.visuals || []).filter((v: any) => v?.id && v?.image).map((v: any) => [v.id, v.image])
);

const metadata = {
  title: 'Inflatable SUP Boards | Premium Paddle Boards | Afarer',
  description:
    'Discover Afarer premium inflatable SUP boards — beginner-friendly all-around boards, touring SUPs, ultra-stable platforms, and adventure-ready designs. CE-certified drop-stitch construction.',
  ignoreTitleTemplate: true,
};
const pageUrl = 'https://afarer.com/inflatable-sup/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'Inflatable SUP Boards — Premium Paddle Boards for Every Adventure',
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        { "@type": "Question", name: "What type of inflatable SUP board should I choose?", acceptedAnswer: { "@type": "Answer", text: "The best type depends on your paddling style. All-around SUPs are most versatile for recreation. Touring SUPs excel at long-distance paddling. Ultra-stable SUPs prioritize stability for yoga, fishing, or larger paddlers. Whitewater SUPs handle river rapids. Consider where and how you will paddle most." } },
        { "@type": "Question", name: "Are inflatable SUPs as good as hard boards?", acceptedAnswer: { "@type": "Answer", text: "Modern inflatable SUPs offer performance comparable to hard boards. Advances in drop-stitch construction, higher PSI ratings, and fusion-laminated seams have closed the gap. Inflatables are more portable, durable, and easier to store than hard boards." } },
        { "@type": "Question", name: "How long do inflatable SUPs last?", acceptedAnswer: { "@type": "Answer", text: "With proper care, a quality inflatable SUP can last 5-10 years or more. Key factors: storage away from direct UV, proper inflation to recommended PSI, rinsing after saltwater use, and avoiding sharp objects. Afarer boards use military-grade PVC for extended lifespan." } },
        { "@type": "Question", name: "What PSI should I inflate my SUP to?", acceptedAnswer: { "@type": "Answer", text: "Most inflatable SUPs should be inflated to 12-15 PSI for optimal rigidity and performance. Afarer boards are rated for 15 PSI maximum. Use the included pump with pressure gauge to achieve consistent inflation." } },
        { "@type": "Question", name: "Do you manufacture inflatable SUPs for private label brands?", acceptedAnswer: { "@type": "Answer", text: "Yes. Afarer is a leading OEM/ODM manufacturer of inflatable SUP boards. We offer custom designs, private labeling, bulk production, and CE certification for brands worldwide. MOQ from 50 units." } },
      ]
    }}
  />
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← Home</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">SUP Product Center</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        Inflatable SUP Boards
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Afarer inflatable SUP boards combine premium drop-stitch construction with adventure-ready design. Whether you
        are a first-time paddler, a touring enthusiast, or a professional outfitter, our SUP lineup delivers stability,
        portability, and lasting performance on lakes, rivers, and coastal waters.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Our SUP Collection</h2>
        <p class="mt-4 text-lg text-gray-500">Every board engineered for a specific style of paddling.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          supProducts.map((p) => {
            const img =
              productVisuals[p.id] || 'https://assets.afarer.com/images/afarer/products/afarer-sup-allround-board.webp';
            const useCaseTags = (p.ai_use_cases || []).slice(0, 3);
            return (
              <a
                href={'/products/' + p.id}
                class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              >
                <div class="aspect-[4/3] bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
                  <img
                    src={img}
                    alt={p.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <div class="flex flex-wrap gap-2 mb-3">
                    {useCaseTags.map((tag) => (
                      <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-medium rounded-full">{tag}</span>
                    ))}
                  </div>
                  <h3 class="text-xl font-bold text-secondary group-hover:text-primary transition-colors">{p.name}</h3>
                  <p class="mt-2 text-sm text-gray-500 line-clamp-2">{p.desc}</p>
                  <div class="mt-4 flex flex-wrap gap-2 text-xs">
                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full">{p.skill}</span>
                    {p.environment.slice(0, 2).map((e) => (
                      <span class="px-2 py-1 bg-gray-100 text-gray-500 rounded-full">{e}</span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">Why Choose an Inflatable SUP?</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Portable & Travel-Friendly</h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            Every Afarer SUP packs into a backpack-sized carrying case. At just 18–22 lbs, it is easy to carry to the
            beach, lake, or through airport terminals.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Drop-Stitch Rigidity</h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            Thousands of internal threads connect the deck and hull at 12–15 PSI, creating a stiff platform that
            performs like a hard board but stores in a closet.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Durable & Impact-Resistant</h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            Military-grade PVC with fusion-laminated seams withstands rocks, docks, and shallow water better than epoxy
            boards. No dings, no cracks.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">CE Certified Safety</h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            Every board meets CE safety standards with clear water-condition ratings, skill-level guidance, and safety
            rules printed on every product.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary">SUP Knowledge Center</h2>
        <p class="mt-4 text-lg text-gray-500">Guides and resources to help you choose the right board.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href="/compare/inflatable-vs-hardboard"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Inflatable vs Hard SUP</h3>
          <p class="mt-2 text-sm text-gray-500">Compare portability, durability, performance, and cost.</p>
        </a>
        <a
          href="/research/sup-thickness-guide"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">SUP Thickness Guide</h3>
          <p class="mt-2 text-sm text-gray-500">How board thickness affects stability and performance.</p>
        </a>
        <a
          href="/research/ce-certification-guide"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">CE Certification Guide</h3>
          <p class="mt-2 text-sm text-gray-500">What CE marking means and how to verify compliance.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Ready to Find Your Perfect SUP?</h2>
    <p class="mt-4 text-lg text-gray-500">Browse our full collection or get in touch with our team.</p>
    <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
      <a
        href="/products"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >
        Browse All Products <span>→</span>
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-4 border-2 border-gray-300 text-gray-700 font-semibold rounded-full hover:border-primary hover:text-primary transition-all"
      >
        Contact Us
      </a>
    </div>
  </section>
  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">Inflatable SUP — Frequently Asked Questions</h2>
      <p class="text-lg text-gray-500 text-center mb-12">Common questions about choosing and using inflatable paddle boards.</p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What type of inflatable SUP board should I choose?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">The best type depends on your paddling style. All-around SUPs are most versatile for recreation. Touring SUPs excel at long-distance paddling. Ultra-stable SUPs prioritize stability for yoga, fishing, or larger paddlers. Whitewater SUPs handle river rapids. Consider where and how you will paddle most.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Are inflatable SUPs as good as hard boards?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Modern inflatable SUPs offer performance comparable to hard boards. Advances in drop-stitch construction, higher PSI ratings, and fusion-laminated seams have closed the gap. Inflatables are more portable, durable, and easier to store than hard boards.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">How long do inflatable SUPs last?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">With proper care, a quality inflatable SUP can last 5–10 years or more. Key factors: storage away from direct UV, proper inflation to recommended PSI, rinsing after saltwater use, and avoiding sharp objects. Afarer boards use military-grade PVC for extended lifespan.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What PSI should I inflate my SUP to?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Most inflatable SUPs should be inflated to 12–15 PSI for optimal rigidity and performance. Afarer boards are rated for 15 PSI maximum. Use the included pump with pressure gauge to achieve consistent inflation.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture inflatable SUPs for private label brands?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Afarer is a leading OEM/ODM manufacturer of inflatable SUP boards. We offer custom designs, private labeling, bulk production, and CE certification for brands worldwide. MOQ from 50 units.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Need Help Choosing Your SUP?</h2>
    <p class="mt-4 text-lg text-gray-500">Contact our team for personalized recommendations based on your height, weight, and paddling goals.</p>
    <a href="/contact" class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all">Get Expert Advice <span>→</span></a>
  </section>
</Layout>
