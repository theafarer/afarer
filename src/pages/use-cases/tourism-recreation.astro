---
import PageLayout from '~/layouts/PageLayout.astro';
import { articleSchema } from '~/lib/seo/schema';
import { nodes } from '~/content/graph/nodes';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/tourism-recreation.ts';

const lang = 'en';
setPageContentData(__pageData);
const page = getPageContent(lang, 'tourism-recreation');
const tourismNode = nodes.find((n) => n.id === 'tourism-recreation');

const graphJsonLd = tourismNode
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        articleSchema({
          headline: page.seo?.headline || 'Inflatable SUPs for Tourism & Recreation — OEM Manufacturing',
          description:
            page.seo?.description ||
            'afarer manufactures premium inflatable SUPs for tourism and recreation: touring boards, fishing boards, and yoga boards. OEM/ODM with CE certification.',
          datePublished: page.seo?.datePublished || '2024-06-01',
          dateModified: page.seo?.dateModified || '2026-06-01',
          author: 'afarer',
          publisher: 'afarer',
        }),
        {
          '@type': 'Product',
          name: tourismNode?.name?.en || 'Tourism & Recreation Inflatable SUPs',
          description:
            tourismNode?.description?.en || 'Premium inflatable SUPs for tourism and recreation applications.',
          brand: { '@type': 'Brand', name: 'afarer' },
          category: 'Tourism & Recreation Equipment',
        },
      ],
    }
  : null;

const metadata = {
  title: page.seo?.headline || 'Inflatable SUPs for Tourism & Recreation — OEM Manufacturing',
  description:
    page.seo?.description ||
    'afarer manufactures premium inflatable SUPs for tourism and recreation: touring boards, fishing boards, and yoga boards. OEM/ODM with CE certification.',
};
---

<PageLayout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={graphJsonLd ? JSON.stringify(graphJsonLd) : ''} />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{page.label || 'Use Case'}</span>
    <h1 class="font-semibold text-gray-900 dark:text-gray-100 mt-4 text-4xl">
      {page.headline || 'Engineering Perfection in Inflatable SUP Manufacturing'}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mt-3">
      {
        page.subtitle ||
          'From guided fishing excursions to coastal cruising, afarer sets the benchmark for durability and performance.'
      }
    </p>

    <div class="mt-12 prose prose-gray dark:prose-invert max-w-none" set:html={page.body || ''} />
  </section>
</PageLayout>
