---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import useCasesData from '~/data/site/use-cases.yaml';

interface UseCaseEntry {
  id: string;
  title: string;
  desc: string;
  image: string;
}

const d = useCasesData as any;
const caseSlugMap: Record<string, string> = { family: 'family-recreation', outdoor: 'river-touring' };
const useCases: UseCaseEntry[] = (d.cases ?? []).map((c: any) => ({
  id: c.id,
  title: c.title,
  desc: c.desc,
  image: c.image,
}));

const staticUseCases = [
  {
    id: 'tourism-recreation',
    title: 'Tourism & Recreation',
    desc: 'Whitewater rafts, fishing boats, dinghies, and SUP boards for tourism operators and rental fleets.',
    image: 'https://assets.afarer.com/images/afarer/use-cases/afarer-professional-use-case.webp',
  },
  {
    id: 'search-and-rescue',
    title: 'Search & Rescue',
    desc: 'Inflatable rescue boats for emergency response, coast guard, and water rescue operations.',
    image: 'https://assets.afarer.com/images/afarer/categories/afarer-rescue-operations.webp',
  },
  {
    id: 'maritime-safety-defense',
    title: 'Maritime Safety & Defense',
    desc: 'Military-grade inflatable craft for patrol, defense, and maritime security applications.',
    image: 'https://assets.afarer.com/images/afarer/hero/hero-5.webp',
  },
  {
    id: 'fishing',
    title: 'Fishing',
    desc: 'Stable inflatable SUP boards and boats for recreational and commercial fishing in lakes, rivers, and coastal waters.',
    image: 'https://assets.afarer.com/images/afarer/products/afarer-inflatable-boat.webp',
  },
  {
    id: 'disaster-relief',
    title: 'Disaster Relief & Humanitarian Aid',
    desc: 'Deployable inflatable craft for flood rescue, humanitarian aid delivery, and emergency response.',
    image: 'https://assets.afarer.com/images/afarer/use-cases/rescue-1.webp',
  },
  {
    id: 'commercial-workboats',
    title: 'Commercial Workboats',
    desc: 'Heavy-duty inflatable workboats for diving support, transport, and commercial marine operations.',
    image: 'https://assets.afarer.com/images/afarer/factory/afarer-stock-boat-inventory.webp',
  },
];

const allUseCases = [...useCases, ...staticUseCases];

const metadata = {
  title: `Use Cases & Applications | ${SITE.name}`,
  description: `Explore how afarer inflatable watercraft are used across tourism, rescue, fishing, recreation, defense, disaster relief, and commercial operations.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Use Cases', item: 'https://afarer.com/use-cases/' },
      ],
    }}
  />
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Use Cases & Applications',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What use cases does afarer manufacture for?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Afarer manufactures inflatable watercraft for tourism and recreation, search and rescue, maritime safety and defense, fishing, disaster relief and humanitarian aid, and commercial workboat operations.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can afarer build custom craft for specific use cases?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Our OEM/ODM team can design and manufacture custom inflatable boats and SUPs tailored to your specific operational requirements and industry standards.',
          },
        },
        {
          '@type': 'Question',
          name: 'What certifications apply to different use cases?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All afarer craft are CE certified. SAR craft can be configured with SOLAS compliance. Military-grade Hypalon is available for defense. Commercial fleet-grade construction is standard for tourism and rental operations.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the MOQ for use-case-specific orders?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'MOQ is 50 units per model for standard custom SUP orders, with samples and pilot runs from 5-10 units. Contact our team with your requirements for a detailed quotation.',
          },
        },
      ],
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">Use Cases</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">Use Cases</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">Applications & Use Cases</h1>
      <p class="mt-4 text-lg text-gray-500">
        From first-time paddlers to professional operators — afarer equips every water adventure.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        allUseCases.map((uc) => (
          <a
            href={`/use-cases/${caseSlugMap[uc.id] || uc.id}`}
            class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
          >
            <div class="h-44 bg-gray-100 overflow-hidden">
              <img
                src={uc.image}
                alt={uc.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h2 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                {uc.title}
              </h2>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{uc.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                View use case &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- FAQ Section -->
    <section class="mt-20">
      <div class="text-center mb-10">
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">FAQs</span>
        <h2 class="mt-4 text-3xl font-bold text-gray-900">Use Case FAQ</h2>
        <p class="mt-3 text-gray-500">Common questions about our application-specific solutions.</p>
      </div>
      <div class="space-y-4 max-w-3xl mx-auto">
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What use cases does afarer manufacture for?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Afarer manufactures inflatable watercraft for tourism and recreation, search and rescue, maritime safety
              and defense, fishing, disaster relief and humanitarian aid, and commercial workboat operations.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>Can afarer build custom craft for specific use cases?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Yes. Our OEM/ODM team can design and manufacture custom inflatable boats and SUPs tailored to your
              specific operational requirements and industry standards.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What certifications apply to different use cases?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              All afarer craft are CE certified. SAR craft can be configured with SOLAS compliance. Military-grade
              Hypalon is available for defense. Commercial fleet-grade construction is standard for tourism and rental
              operations.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What is the MOQ for use-case-specific orders?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              MOQ is 50 units per model for standard custom SUP orders, with samples and pilot runs from 5-10 units.
              Contact our team with your requirements for a detailed quotation.
            </p>
          </div>
        </details>
      </div>
    </section>
  </div>
</Layout>
