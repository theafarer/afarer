---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Inflatable SUP Board Manufacturer – SUP Factory for OEM/ODM Custom Paddle Boards | ${SITE.name}`,
  description: `${SITE.name} is a professional inflatable SUP board manufacturer and SUP factory in Qingdao, China. ISO 9001 certified factory offering OEM/ODM services, custom paddle board design, private label, and wholesale SUP supply. 12,000 m² facility, 200+ workers, 15,000+ units annual capacity.`,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Inflatable SUP Manufacturer' }];

const stats = [
  { value: 'Since 2012', label: 'Years of manufacturing experience' },
  { value: '12,000 m²', label: 'ISO 9001 certified facility' },
  { value: '200+', label: 'Skilled workers and engineers' },
  { value: '50+', label: 'Countries exported to' },
];

const capabilities = [
  {
    title: 'Drop-Stitch Core SUP Manufacturing',
    desc: 'Full-length drop-stitch lamination for rigid, high-pressure inflatable SUP boards at 15-20 PSI. Custom length, width, thickness, and rocker profile.',
  },
  {
    title: 'Custom Mold Design & Tooling',
    desc: 'In-house 3D CAD/CAM engineering. Custom aluminum and composite molds for unique hull shapes, deck configurations, and accessory mounting points.',
  },
  {
    title: 'Private Label & Custom Branding',
    desc: 'Full private label service: logo heat-transfer or screen printing, branded packaging, user manuals in your language, and barcode/UPC registration.',
  },
  {
    title: 'OEM Accessory Kitting',
    desc: 'Life vests, dual-action pumps, carbon/nylon paddles, repair kits, carry bags, and leash assemblies. Full kitting and bundle packaging.',
  },
  {
    title: 'CE Certification & Compliance',
    desc: 'Every OEM order includes CE declaration of conformity, ISO 9001 traceability records, BSCI social compliance report, and REACH material declarations.',
  },
  {
    title: 'FOB Qingdao Logistics',
    desc: 'Finished goods palletized, shrink-wrapped, and container-loaded at Qingdao port. Full export documentation, customs clearance, and real-time tracking.',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta
    name="ai-intent"
    content="inflatable-sup-manufacturer,sup-board-factory-oem,custom-paddle-board-production,private-label-sup-manufacturer,sup-oem-odm-china"
  />
  <JsonLd type="BreadcrumbList" breadcrumbs={crumbs} />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What makes Afarer different from other inflatable SUP manufacturers?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Afarer is operated by Aquafarer LLC (USA). Our Qingdao Operation Team manages product development and manufacturing at a 12,000 m² ISO 9001 certified facility, handling everything from material sourcing and mold design to production, quality control, and FOB shipping. MOQ 50 units (standard SUP).',
          },
        },
        {
          '@type': 'Question',
          name: 'Can Afarer manufacture custom SUP boards to my specifications?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. We support full OEM/ODM manufacturing: provide your design or concept, and our engineering team handles 3D CAD modeling, FEA structural analysis, mold fabrication, prototype production, testing, and bulk manufacturing.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the minimum order quantity for SUP manufacturing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'MOQ is 5-10 units for custom SUP boards, 2-5 units for RIBs, and 50+ units for custom accessory kitting. Sample orders and pilot runs are available for new product development.',
          },
        },
        {
          '@type': 'Question',
          name: 'What quality control does Afarer provide during manufacturing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We apply multi-stage QC: incoming material inspection, in-process production checks, 24-hour pressure retention testing at 1.25x rated pressure, seam peel verification, and AQL 2.5 final inspection per ISO 2859 standards.',
          },
        },
        {
          '@type': 'Question',
          name: 'What certifications do Afarer manufactured SUP boards carry?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All boards are CE certified under applicable EU directives. Our factory is ISO 9001 (quality management) and BSCI (social compliance) certified. Materials are REACH compliant. SOLAS options available for specialized craft.',
          },
        },
        {
          '@type': 'Question',
          name: 'How long does SUP board manufacturing take from design to delivery?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Prototype samples: 15-20 working days. Bulk production: 30-45 days from design approval. FOB Qingdao shipping. Rush orders may be accommodated depending on production capacity.',
          },
        },
      ],
    }}
  />

  <!-- Hero -->
  <section class="relative py-24 px-6 overflow-hidden bg-secondary">
    <div class="absolute inset-0">
      <img
        src="https://assets.afarer.com/images/afarer/hero/production-dept.webp"
        alt="Afarer SUP board manufacturing workshop"
        class="w-full h-full object-cover opacity-30"
        style="object-position: center 40%;"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/90 via-secondary/60 to-secondary/30"></div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <span class="text-sm font-semibold text-sky-300 tracking-[0.2em] uppercase">Manufacturer</span>
      <h1 class="mt-4 text-4xl md:text-6xl font-bold text-white leading-tight">Inflatable SUP Board Manufacturer</h1>
      <p class="mt-6 text-lg text-white/80 max-w-3xl mx-auto">
        Afarer is a professional inflatable SUP board manufacturer and wholesale SUP supplier providing OEM/ODM services
        to global brands, distributors, and water sports businesses. ISO 9001 certified SUP factory. Factory-direct.
        Since 2012.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4 flex-wrap">
        <a
          href="/oem-odm-manufacturer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all"
          >Request OEM Quote <span>→</span></a
        >
        <a
          href="/contact?subject=Factory%20Profile"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
          >Download Factory Profile</a
        >
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="px-6 py-16 bg-gray-50 border-y border-gray-200">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
      {
        stats.map((s) => (
          <div class="text-center p-6 rounded-xl bg-white border border-gray-200">
            <span class="block text-3xl font-bold text-sky-700">{s.value}</span>
            <span class="text-sm text-gray-500 mt-1 block">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Introduction -->
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-gray-900 text-center">Why Partner with Afarer for SUP Manufacturing?</h2>
    <div class="mt-8 space-y-6 text-gray-600 leading-relaxed">
      <p>
        Afarer is operated by <strong>Aquafarer LLC (USA)</strong>. Our Qingdao Operation Team manages product
        development and manufacturing across 12,000 m² of dedicated watercraft production space, with 200+ skilled
        manufacturing workers and an annual capacity exceeding 15,000 inflatable boats, SUPs, and RIBs. As a leading SUP
        manufacturer, we supply private label and custom paddle boards for brands worldwide.
      </p>
      <p>
        We specialize in <strong
          >drop-stitch core lamination, high-frequency PVC welding, and Hypalon CSM tube fabrication</strong
        > — the three core technologies that define modern inflatable watercraft. Every production line operates under ISO
        9001 quality management, and every product carries CE declaration of conformity.
      </p>
      <p>
        Our B2B partners include European and North American water sports brands, tour operators, government agencies,
        and military procurement programs. We provide full-spectrum OEM and ODM services — from concept drawing and 3D
        mold prototyping to bulk production, compliance documentation, and FOB Qingdao shipping.
      </p>
    </div>
  </section>

  <!-- Manufacturing Capabilities -->
  <section class="bg-gray-50 px-6 py-16 border-y border-gray-200">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">Manufacturing Capabilities</span>
        <h2 class="mt-4 text-4xl font-bold text-gray-900">What We Build</h2>
        <p class="mt-4 text-lg text-gray-500">Six core production capabilities for global B2B partners.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          capabilities.map((c) => (
            <div class="bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-shadow">
              <div class="w-10 h-10 bg-sky-50 rounded-xl flex items-center justify-center text-sky-600 font-bold text-lg">
                &#10003;
              </div>
              <h3 class="mt-4 text-lg font-semibold text-gray-900">{c.title}</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">Production Process</span>
      <h2 class="mt-4 text-4xl font-bold text-gray-900">How Inflatable SUP Boards Are Manufactured</h2>
      <p class="mt-4 text-lg text-gray-500">
        From raw materials to finished product — our quality-driven manufacturing workflow.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center">
        <span class="text-3xl font-bold text-sky-200">01</span>
        <h3 class="mt-3 text-lg font-semibold text-gray-900">Material Preparation</h3>
        <p class="mt-2 text-sm text-gray-500">
          Military-grade PVC or Hypalon CSM fabric is inspected, cut to spec using CNC equipment.
        </p>
      </div>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center">
        <span class="text-3xl font-bold text-sky-200">02</span>
        <h3 class="mt-3 text-lg font-semibold text-gray-900">Drop-Stitch Lamination</h3>
        <p class="mt-2 text-sm text-gray-500">
          Thousands of polyester threads are fused between top and bottom layers at high temperature.
        </p>
      </div>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center">
        <span class="text-3xl font-bold text-sky-200">03</span>
        <h3 class="mt-3 text-lg font-semibold text-gray-900">Welding & Assembly</h3>
        <p class="mt-2 text-sm text-gray-500">
          High-frequency welding bonds rails, valves, and deck pads. Fusion welding eliminates delamination.
        </p>
      </div>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center">
        <span class="text-3xl font-bold text-sky-200">04</span>
        <h3 class="mt-3 text-lg font-semibold text-gray-900">Quality Testing</h3>
        <p class="mt-2 text-sm text-gray-500">
          24-hour pressure hold at 1.25x rated pressure. Seam peel test. Visual inspection. AQL 2.5 sampling.
        </p>
      </div>
    </div>
    <div class="text-center mt-10">
      <a href="/factory" class="text-sm font-medium text-sky-600 hover:text-sky-700">View Full Production Details →</a>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-gray-50 px-6 py-16 border-y border-gray-200">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase">FAQs</span>
        <h2 class="mt-4 text-3xl font-bold text-gray-900">SUP Manufacturing FAQ</h2>
        <p class="mt-4 text-gray-500">Common questions from brands and businesses about our manufacturing services.</p>
      </div>
      <div class="space-y-4">
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What makes Afarer different from other inflatable SUP manufacturers?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Afarer is operated by Aquafarer LLC (USA). Our Qingdao Operation Team manages product development and
              manufacturing at a 12,000 m² ISO 9001 certified facility, handling everything from material sourcing and
              mold design to production, quality control, and FOB shipping. MOQ 50 units (standard SUP).
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>Can Afarer manufacture custom SUP boards to my specifications?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Yes. We support full OEM/ODM manufacturing: provide your design or concept, and our engineering team
              handles 3D CAD modeling, FEA structural analysis, mold fabrication, prototype production, testing, and
              bulk manufacturing.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What is the minimum order quantity for SUP manufacturing?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              MOQ is 5-10 units for custom SUP boards, 2-5 units for RIBs, and 50+ units for custom accessory kitting.
              Sample orders and pilot runs are available for new product development.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>What certifications do Afarer manufactured SUP boards carry?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              All boards are CE certified under applicable EU directives. Our factory is ISO 9001 and BSCI certified.
              Materials are REACH compliant. SOLAS options available for specialized craft.
            </p>
          </div>
        </details>
        <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
          <summary
            class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
          >
            <span>How long does SUP board manufacturing take from design to delivery?</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-4">
            <p class="text-gray-600 leading-relaxed">
              Prototype samples: 15-20 working days. Bulk production: 30-45 days from design approval. FOB Qingdao
              shipping. Rush orders may be accommodated depending on production capacity.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <TrustBadges
    layout="row"
    title="Certified Quality & Compliance"
    subtitle="Every OEM order backed by international certifications and rigorous quality control."
  />

  <RelatedPages
    title="Explore More"
    subtitle="Related manufacturing services and resources"
    links={[
      {
        title: 'OEM/ODM Manufacturing',
        description: 'Full-spectrum OEM and ODM services for inflatable watercraft.',
        href: '/oem-odm-manufacturer',
        label: 'OEM',
      },
      {
        title: 'Factory Overview',
        description: 'Tour our 12,000 m² ISO-certified manufacturing facility.',
        href: '/factory',
        label: 'Factory',
      },
      {
        title: 'Quality Control',
        description: 'ISO 9001 certified quality management system and testing process.',
        href: '/quality',
        label: 'Quality',
      },
      {
        title: 'Engineering & R&D',
        description: 'Product development from concept to production.',
        href: '/randdcenter',
        label: 'R&D',
      },
    ]}
  />
</Layout>
