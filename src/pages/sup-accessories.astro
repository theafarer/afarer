---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { products } from '../data/products';
import productVisualsData from '~/data/site/product-visuals.yaml';

const accessories = products.filter((p) => p.category === 'ACCESSORY');

const accessoryVisuals = Object.fromEntries(
  ((productVisualsData as any)?.visuals || []).filter((v: any) => v?.id && v?.image).map((v: any) => [v.id, v.image])
);

const metadata = {
  title: 'SUP Accessories | Inflatable Board Pumps, Paddles, Leashes & Vests | Afarer',
  description:
    'Afarer SUP accessories — life vests, paddle pumps, oars, and maintenance gear for inflatable paddle boards. CE-certified safety equipment. OEM/ODM available.',
  ignoreTitleTemplate: true,
};
const pageUrl = 'https://afarer.com/sup-accessories/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'SUP Accessories — Gear Up for the Water',
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: 'https://afarer.com/inflatable-sup/' },
        { position: 3, name: 'SUP Accessories', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        { "@type": "Question", name: "What accessories do I need for an inflatable SUP?", acceptedAnswer: { "@type": "Answer", text: "Every SUP needs a pump, paddle, leash, and life vest at minimum. Afarer SUPs ship as complete kits including a dual-action pump, 3-piece aluminum paddle, coiled leash, and backpack. Recommended upgrades include an electric pump, carbon fiber paddle, and SOLAS-approved life vest." } },
        { "@type": "Question", name: "What type of pump is best for inflatable SUPs?", acceptedAnswer: { "@type": "Answer", text: "Dual-action hand pumps are the standard choice for portability and reliability. Electric pumps offer faster inflation (2-3 minutes) at the cost of weight and power dependence. Afarer offers both options to suit different paddling styles." } },
        { "@type": "Question", name: "Do I need a special life vest for SUP?", acceptedAnswer: { "@type": "Answer", text: "Yes. SUP-specific life vests are designed for paddling mobility with shorter profiles and arm freedom. Afarer life vests meet CE and SOLAS standards with USCG-approved buoyancy ratings." } },
        { "@type": "Question", name: "What paddle length do I need?", acceptedAnswer: { "@type": "Answer", text: "A proper paddle length is 6-10 inches taller than your height. For a 6-foot person, a 76-78 inch paddle is ideal. Adjustable paddles let you fine-tune length for different conditions." } },
        { "@type": "Question", name: "Do you manufacture SUP accessories for private label?", acceptedAnswer: { "@type": "Answer", text: "Yes. Afarer offers OEM/ODM manufacturing for SUP accessories including custom life vests, paddles, pumps, and maintenance kits with custom branding and packaging." } },
      ]
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href="/inflatable-sup/"
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← SUP Product Center</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">Accessories</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        SUP Accessories
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Complete your SUP setup with Afarer accessories — from USCG-approved life vests and high-pressure pumps to spare
        oars and maintenance kits. Every accessory is designed to match the quality of our inflatable SUP boards and
        built for years of reliable service.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Our Accessory Collection</h2>
        <p class="mt-4 text-lg text-gray-500">Every essential for a complete paddling experience.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          accessories.map((p) => {
            const img = accessoryVisuals[p.id] || '';
            return (
              <a
                href={'/products/' + p.id}
                class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              >
                <div class="aspect-[4/3] bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
                  {img && (
                    <img
                      src={img}
                      alt={p.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold text-secondary group-hover:text-primary transition-colors">{p.name}</h3>
                  <p class="mt-2 text-sm text-gray-500 line-clamp-2">{p.desc}</p>
                  <div class="mt-4 flex flex-wrap gap-2 text-xs">
                    {(p.use_case || []).slice(0, 3).map((u) => (
                      <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full capitalize">{u}</span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">Essential SUP Accessories Guide</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="font-semibold text-gray-900">Life Vests & PFDs</h3>
          <p class="mt-2 text-sm text-gray-500">
            A properly fitted life vest is the most important safety accessory. Our Classic and Pro vests meet CE and
            USCG standards for all water conditions.
          </p>
          <a
            href="/products/life-vest-classic"
            class="inline-block mt-3 text-sm font-medium text-primary hover:underline">Shop vests →</a
          >
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="font-semibold text-gray-900">Pumps & Inflation</h3>
          <p class="mt-2 text-sm text-gray-500">
            High-pressure dual-chamber pumps reduce inflation time. Our oars & pump set includes everything you need to
            get on the water fast.
          </p>
          <a href="/products/oars-pump-set" class="inline-block mt-3 text-sm font-medium text-primary hover:underline"
            >Shop pumps →</a
          >
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="font-semibold text-gray-900">Paddles & Oars</h3>
          <p class="mt-2 text-sm text-gray-500">
            Adjustable aluminum and fiberglass paddles suit paddlers of all heights. Spare oars are essential for
            expedition planning.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="font-semibold text-gray-900">Maintenance & Repair</h3>
          <p class="mt-2 text-sm text-gray-500">
            Keep your SUP in top condition with our maintenance kits, valve tools, and repair patches. Every board ships
            with a basic repair kit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary">Accessories Resources</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href="/compare/single-chamber-vs-multi-chamber"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Safety Equipment Guide</h3>
          <p class="mt-2 text-sm text-gray-500">Essential safety gear for every paddler.</p>
        </a>
        <a
          href="/compare/pvc-vs-hypalon"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Material Durability</h3>
          <p class="mt-2 text-sm text-gray-500">Understanding PVC vs Hypalon for accessories.</p>
        </a>
        <a
          href="/compare/inflatable-vs-hardboard"
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Gear Comparison</h3>
          <p class="mt-2 text-sm text-gray-500">Accessories for inflatable vs hard boards.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Complete Your SUP Kit</h2>
    <p class="mt-4 text-lg text-gray-500">Contact us for bulk accessory orders, OEM production, or custom branding.</p>
    <a
      href="/contact"
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >Get a Quote <span>→</span></a
    >
  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">SUP Accessories — Frequently Asked Questions</h2>
      <p class="text-lg text-gray-500 text-center mb-12">Common questions about choosing and using SUP gear.</p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What accessories do I need for an inflatable SUP?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Every SUP needs a pump, paddle, leash, and life vest at minimum. Afarer SUPs ship as complete kits including a dual-action pump, 3-piece aluminum paddle, coiled leash, and backpack. Recommended upgrades include an electric pump, carbon fiber paddle, and SOLAS-approved life vest.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What type of pump is best for inflatable SUPs?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Dual-action hand pumps are the standard choice for portability and reliability. Electric pumps offer faster inflation (2–3 minutes) at the cost of weight and power dependence. Afarer offers both options to suit different paddling styles.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do I need a special life vest for SUP?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. SUP-specific life vests are designed for paddling mobility with shorter profiles and arm freedom. Afarer life vests meet CE and SOLAS standards with USCG-approved buoyancy ratings.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What paddle length do I need?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">A proper paddle length is 6–10 inches taller than your height. For a 6-foot person, a 76–78 inch paddle is ideal. Adjustable paddles let you fine-tune length for different conditions.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture SUP accessories for private label?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Afarer offers OEM/ODM manufacturing for SUP accessories including custom life vests, paddles, pumps, and maintenance kits with custom branding and packaging.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Equip Your SUP Adventure</h2>
    <p class="mt-4 text-lg text-gray-500">Contact us for bulk pricing, custom accessory orders, or technical specifications.</p>
    <a href="/contact" class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all">Get Accessory Info <span>→</span></a>
  </section>
</Layout>
