---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';

const metadata = {
  title: 'Whitewater SUP Board | River-Running Inflatable Paddle Board | Afarer',
  description:
    'Afarer whitewater SUP boards — rugged inflatable paddle boards for river running, Class I-II rapids, and moving water. Reinforced rails, high PSI drop-stitch, expedition-ready. OEM/ODM manufacturing available for brands and outfitters.',
  ignoreTitleTemplate: true,
};
const pageUrl = 'https://afarer.com/whitewater-sup/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'Whitewater SUP Board — Conquer the Rapids',
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: 'https://afarer.com/inflatable-sup/' },
        { position: 3, name: 'Whitewater SUP', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        { '@type': 'Question', name: 'What is a whitewater SUP board?', acceptedAnswer: { '@type': 'Answer', text: 'A whitewater SUP board is a shorter, more rugged inflatable paddle board designed for river running on Class I–III rapids. It features reinforced rails, higher PSI construction, and a compact length (8\'–10\') for quick maneuverability in moving water.' } },
        { '@type': 'Question', name: 'Can you use a regular SUP in whitewater?', acceptedAnswer: { '@type': 'Answer', text: 'Regular SUPs lack the reinforced construction, impact resistance, and maneuverability needed for whitewater. Standard boards risk delamination, rail damage, and poor handling in rapids. A dedicated whitewater SUP is recommended.' } },
        { '@type': 'Question', name: 'What PSI should a whitewater SUP be?', acceptedAnswer: { '@type': 'Answer', text: 'Whitewater SUPs should be inflated to 15–18 PSI for maximum rigidity. Higher pressure maintains board shape through turbulent water and provides better response to paddle strokes for maneuvering around obstacles.' } },
        { '@type': 'Question', name: 'Is whitewater SUP dangerous?', acceptedAnswer: { '@type': 'Answer', text: 'Whitewater SUP carries inherent risks as an extreme sport. Proper safety gear (helmet, life vest, leash, river shoes) and appropriate skill progression are essential. Start with Class I rapids and progress with experience.' } },
        { '@type': 'Question', name: 'Do you manufacture whitewater SUPs for private label?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Afarer offers OEM/ODM manufacturing for whitewater SUP boards with reinforced construction, custom graphics, and compliance documentation for outdoor brands and river outfitters.' } },
      ]
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href="/inflatable-sup/"
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← SUP Product Center</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">SUP Category</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        Whitewater SUP Board
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Whitewater SUP paddling demands a board that can withstand impacts, maintain rigidity in turbulence, and respond
        quickly to paddle strokes. Afarer whitewater SUPs feature reinforced rail construction, shorter lengths for
        maneuverability, and high-PSI drop-stitch cores that maintain shape through rapids and hydraulics.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Whitewater SUP Features</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Impact-Resistant Rails</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Reinforced side rails with fusion-laminated seams absorb impacts from rocks and submerged obstacles without
            delamination or air loss.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Shorter Agile Hull</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Reduced length (9'–10') provides tighter turning radius for navigating rapids, eddies, and tight river
            corridors with precision.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">High-PSI Rigidity</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            15+ PSI drop-stitch construction maintains board shape and stiffness through turbulent water, preventing
            flex that compromises control.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">River-Ready Products</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href="/products/sup-leviathan-wake"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-slate-50 to-blue-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-leviathan-wake-1.webp"
              alt="Leviathan Wake Series"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Leviathan Wake Series
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              Built for challenging water conditions. Reinforced construction, compact profile, and responsive handling
              for river running.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
        <a
          href="/products/sup-cheetah-surge"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-yellow-50 to-amber-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-cheetah-surge-1.webp"
              alt="Cheetah Surge Edition"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Cheetah Surge Edition
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              Agile performance SUP with responsive handling. Suitable for experienced paddlers tackling dynamic river
              conditions.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Who Is a Whitewater SUP For?</h2>
        <p class="mt-4 text-lg text-gray-500">Built for paddlers who crave moving water and river adventure.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">River Runners</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">If you live near rivers with Class I–III rapids, a whitewater SUP opens up a new dimension of paddling. Run waves, surf holes, and navigate technical lines that hard-shell kayaks can access.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Expedition Kayakers Cross-Training</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Stand-up paddling on moving water builds balance, edging, and reading-water skills that translate directly to kayaking and canoeing.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Adventure Photographers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">The elevated vantage point of SUP gives unique camera angles on river scenery. Stable whitewater boards carry camera gear safely through moderate rapids.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">River Outfitters & Schools</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">Offer whitewater SUP as a premium guided experience. Durable construction and responsive handling make these boards ideal for instruction and rental fleets.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">OEM/ODM Manufacturing for Whitewater SUPs</h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Afarer manufactures whitewater SUP boards for outdoor brands, river outfitters, and adventure companies. Our production lines produce CE-certified whitewater SUPs with reinforced rails, custom graphics, and expedition-grade packaging. MOQ from 50 units. Lead times from 30 days.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">Custom</span>
          <p class="mt-1 text-sm text-gray-500">Reinforcement, graphics, packaging</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">Units minimum order</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">30 Days</span>
          <p class="mt-1 text-sm text-gray-500">Typical lead time</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/oem-odm-manufacturer" class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all">Request OEM Quote <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">Whitewater SUP — Frequently Asked Questions</h2>
      <p class="text-lg text-gray-500 text-center mb-12">Common questions about selecting, using, and manufacturing whitewater paddle boards.</p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What is a whitewater SUP board?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">A whitewater SUP board is a shorter, more rugged inflatable paddle board designed for river running on Class I–III rapids. It features reinforced rails, higher PSI construction, and a compact length (8'–10') for quick maneuverability in moving water.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can you use a regular SUP in whitewater?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Regular SUPs lack the reinforced construction, impact resistance, and maneuverability needed for whitewater. Standard boards risk delamination, rail damage, and poor handling in rapids. A dedicated whitewater SUP is recommended.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What PSI should a whitewater SUP be?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Whitewater SUPs should be inflated to 15–18 PSI for maximum rigidity. Higher pressure maintains board shape through turbulent water and provides better response to paddle strokes for maneuvering around obstacles.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Is whitewater SUP dangerous?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Whitewater SUP carries inherent risks as an extreme sport. Proper safety gear (helmet, life vest, leash, river shoes) and appropriate skill progression are essential. Start with Class I rapids and progress with experience.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture whitewater SUPs for private label?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">Yes. Afarer offers OEM/ODM manufacturing for whitewater SUP boards with reinforced construction, custom graphics, and compliance documentation for outdoor brands and river outfitters.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary">Whitewater Resources</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a href="/compare/single-chamber-vs-multi-chamber" class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Chamber Safety for Rivers</h3>
        <p class="mt-2 text-sm text-gray-500">Why multi-chamber is critical in moving water.</p>
      </a>
      <a href="/compare/pvc-vs-hypalon" class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">PVC vs Hypalon Durability</h3>
        <p class="mt-2 text-sm text-gray-500">Which material withstands river impacts better.</p>
      </a>
      <a href="/compare/inflatable-vs-hardboard" class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Inflatable for Whitewater</h3>
        <p class="mt-2 text-sm text-gray-500">Why inflatable SUPs dominate river running.</p>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Explore Whitewater SUP Options</h2>
    <p class="mt-4 text-lg text-gray-500">
      Contact us for technical specs, bulk orders, or OEM whitewater SUP production.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >Inquire About Whitewater SUPs <span>→</span></a
    >
  </section>
</Layout>
