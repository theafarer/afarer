---
import Layout from '~/layouts/PageLayout.astro';
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';
import JsonLd from '~/components/common/JsonLd.astro';

const metadata = {
  title: 'Solutions by Use Case — Find Your Inflatable SUP',
  description:
    'Match your use case to the right inflatable SUP solution. From rental fleets and paddle clubs to custom OEM manufacturing and personal use — afarer has the right board.',
  ignoreTitleTemplate: true,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Solutions by Use Case' }];

const useCases = [
  {
    scenario: 'I need rescue boards for lifeguard or water safety teams',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z',
    answer:
      'Our rescue SUPs (11-14 ft) are designed for rapid deployment. Lightweight for easy transport, wide stable platforms for victim recovery, and military-grade PVC construction for extended UV exposure.',
    cta: { text: 'View SUP Products', link: '/products' },
  },
  {
    scenario: 'I want to start a rental fleet at my beach resort',
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
    answer:
      'Rental-grade SUPs with reinforced rails, UV-stabilized fabric, and commercial-grade valves. Custom branding available. Bulk pricing starts at 50+ units per model.',
    cta: { text: 'Rental Operator Solutions', link: '/solutions/rental-operators' },
  },
  {
    scenario: 'I need custom-branded products for my brand',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
    answer:
      'Full OEM/ODM service: custom colors, logos, packaging, and tooling. MOQ 50 units for SUPs. NDA protected. 45-60 day lead time from design approval.',
    cta: { text: 'OEM/ODM Services', link: '/oem-odm-manufacturer' },
  },
  {
    scenario: 'I need fleet boards for my paddle club or SUP school',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    answer:
      'Mixed-size fleet supply for all skill levels: stable beginner platforms, touring boards, and race boards. Bulk club pricing, custom branding, and membership program support.',
    cta: { text: 'Paddle Club Solutions', link: '/solutions/paddle-clubs' },
  },
  {
    scenario: 'I need boards for a marine tourism or adventure operation',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 12.5V17a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h3.5a2 2 0 012 2v.5',
    answer:
      'Durable all-around and touring SUPs built for daily guest use, plus giant multi-rider boards for group experiences. UV-stabilized construction for tropical, full-season operation.',
    cta: { text: 'Marine Tourism Solutions', link: '/solutions/marine-tourism-equipment' },
  },
  {
    scenario: 'I need fishing SUPs for my guiding service or retail shop',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    answer:
      'Fishing-specific SUPs with wide, stable platforms, gear-mount options, and accessory integration. Available for guided-tour fleets or wholesale retail supply.',
    cta: { text: 'View SUP Products', link: '/products' },
  },
  {
    scenario: 'I want to manufacture my own SUP board design',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    answer:
      'We take your concept to production: industrial design, mold creation, prototyping, testing, and mass production. Our R&D center supports CAD/FEA simulation, hydrodynamic testing, and material selection.',
    cta: { text: 'Design & Innovation', link: '/design-powerhouse' },
  },
  {
    scenario: 'I need a single SUP for personal or family use',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
    answer:
      'Visit our product catalog to find the right board. Our size guide and product comparisons help match you with the right model. All products CE certified with warranty.',
    cta: { text: 'Shop Products', link: '/products' },
  },
];
---

<JsonLd
  type="BreadcrumbList"
  data={{
    itemListElement: [
      { position: 1, name: 'Home', item: 'https://afarer.com/' },
      { position: 2, name: 'Solutions', item: 'https://afarer.com/solutions/' },
      { position: 3, name: 'By Use Case', item: 'https://afarer.com/solutions/by-use-case/' },
    ],
  }}
/>
<JsonLd
  type="FAQPage"
  data={{
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I choose the right inflatable SUP?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Select your scenario from our use-case decision tool. Each scenario matches your specific needs to the right afarer solution, from rental fleets and paddle clubs to custom OEM manufacturing and personal use.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I start a rental fleet with afarer?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Rental-grade SUPs with reinforced rails, UV-stabilized fabric, and commercial-grade valves are available. Custom branding is supported and bulk pricing starts at 50+ units per model.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the lead time for OEM custom orders?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Standard lead time is 45-60 days from design approval to FOB Qingdao. Prototype samples are produced within 15-20 working days for your approval before bulk production.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do you supply paddle clubs and SUP schools?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Mixed-size fleet supply is available for clubs and schools, covering stable beginner platforms, touring boards, and race boards. Bulk club pricing, custom branding, and membership program support are included.',
        },
      },
      {
        '@type': 'Question',
        name: "What is afarer's minimum order quantity?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'MOQ is 50 units per model for standard SUP orders. Sample orders and pilot programs are available from 5-10 units.',
        },
      },
    ],
  }}
/>

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="max-w-4xl mx-auto py-24 px-6">
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">What Are You Looking For?</h1>
    <p class="mt-4 text-lg text-gray-500">
      Select your scenario below and get a direct recommendation for the right afarer solution.
    </p>

    <div class="mt-12 space-y-4">
      {
        useCases.map((uc) => (
          <details class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <summary class="flex items-center gap-4 p-6 cursor-pointer list-none">
              <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg
                  class="w-5 h-5 text-gray-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={uc.icon} />
                </svg>
              </div>
              <span class="flex-1 font-medium text-gray-900 text-sm leading-relaxed">{uc.scenario}</span>
              <svg
                class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 pt-2 border-t border-gray-100">
              <p class="text-sm text-gray-600 leading-relaxed">{uc.answer}</p>
              <a
                href={uc.cta.link}
                class="mt-4 inline-flex px-5 py-2.5 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
              >
                {uc.cta.text} →
              </a>
            </div>
          </details>
        ))
      }
    </div>

    <section class="mt-16 bg-gradient-to-br from-gray-50 to-sky-50 rounded-2xl p-8 border border-gray-200 text-center">
      <h2 class="text-xl font-semibold text-gray-900">Still Not Sure?</h2>
      <p class="mt-2 text-sm text-gray-500">
        Contact our team for a personalized recommendation based on your specific requirements.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-flex px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition"
        >Contact Us →→</a
      >
    </section>
  </section>

  <!-- FAQ Section -->
  <section class="mt-16">
    <div class="text-center mb-10">
      <span class="text-sm font-semibold text-primary tracking-wide uppercase">FAQs</span>
      <h2 class="mt-2 text-3xl font-semibold text-gray-900">Use Case FAQ</h2>
      <p class="mt-3 text-gray-500">Quick answers to common questions about our solutions.</p>
    </div>
    <div class="space-y-4">
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>How do I choose the right inflatable SUP?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Select your scenario from our use-case decision tool. Each scenario matches your specific needs to the right
            afarer solution, from rental fleets and paddle clubs to custom OEM manufacturing and personal use.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>Can I start a rental fleet with afarer?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Yes. Rental-grade SUPs with reinforced rails, UV-stabilized fabric, and commercial-grade valves are
            available. Custom branding is supported and bulk pricing starts at 50+ units per model.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What is the lead time for OEM custom orders?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            Standard lead time is 45-60 days from design approval to FOB Qingdao. Prototype samples are produced within
            15-20 working days for your approval before bulk production.
          </p>
        </div>
      </details>
      <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
        <summary
          class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between"
        >
          <span>What is afarer's minimum order quantity?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
        </summary>
        <div class="px-6 pb-4">
          <p class="text-gray-600 leading-relaxed">
            MOQ is 50 units per model for standard SUP orders. Sample orders and pilot programs are available from 5-10
            units.
          </p>
        </div>
      </details>
    </div>
  </section>

  <ExperienceLayer
    title="Real-World Results"
    subtitle="How businesses and organizations use afarer solutions in the field."
    stories={[
      {
        quote:
          'The fleet arrived branded and ready to rent on day one. When a guest damaged a board mid-season, the replacement arrived within 48 hours.',
        narrative:
          'A beach resort in the Maldives launched a 30-board afarer SUP fleet with custom branding and staff training included. Rental-grade boards with reinforced rails survive daily guest use, and integrated fleet tracking keeps boards accounted for. The fleet pays for itself within a single high season.',
        context: 'Resort SUP fleet, Maldives, 2024',
        source: 'Resort Activities Manager',
      },
      {
        quote:
          'We run three guided tours a day with our afarer fleet. The boards handle the tropical sun and daily launches without missing a beat.',
        narrative:
          'A marine tourism operator in Southeast Asia runs guided mangrove and lagoon tours with a mixed afarer fleet — all-around boards for guests and touring boards for guides. After two full seasons of three daily sessions, the UV-stabilized fabric shows no fading and the fusion-welded seams remain fully intact.',
        context: 'Guided tour operation, Southeast Asia, 2023-2025',
        source: 'Tour Operation Owner',
      },
    ]}
  />
  <RelatedPages
    title="Explore More"
    subtitle="Related solutions and resources"
    links={[
      {
        title: 'Solutions by Industry',
        description: 'Find the right inflatable SUP solution for your industry sector.',
        href: '/solutions/by-industry',
        label: 'Overview',
      },
      {
        title: 'SUP Products',
        description: 'Full lineup of CE-certified inflatable SUPs and accessories.',
        href: '/products',
        label: 'Products',
      },
      {
        title: 'OEM/ODM Manufacturing',
        description: 'Custom manufacturing services for global brands and organizations.',
        href: '/oem-odm-manufacturer',
        label: 'OEM',
      },
      {
        title: 'Engineering Perfection',
        description: 'Our engineering philosophy — precision manufacturing and rigorous quality control.',
        href: '/engineering-perfection',
        label: 'Philosophy',
      },
    ]}
  />

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Use case decision flow for afarer inflatable SUP boards. Eight scenarios with recommended solutions: water safety
      (rescue SUPs with wide stable platforms), rental fleet (rental-grade SUPs with custom branding), custom branded
      products (OEM/ODM service, MOQ 50 SUP), paddle clubs and SUP schools (mixed-size fleet supply with bulk club
      pricing), marine tourism (all-around and touring SUPs plus giant multi-rider boards), fishing (fishing-specific
      SUPs with gear-mount options), custom SUP design (full ODM from concept to production), personal/family use
      (product catalog with size guide and comparisons).
    </p>
  </section>
</Layout>
