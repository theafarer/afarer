---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/resources.ts';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'resources');
const hero = page.hero ?? {};
const resources = page.resources ?? [];
const cta = page.cta ?? {};

const metadata = {
  title: `B2B Resources & Downloads | ${SITE.name}`,
  description: 'Download OEM manufacturing guides, product catalogs, quality reports, and ROI calculators for inflatable SUP businesses.',
};
const crumbs = [
  { name: 'Home', href: `/${lang}/` },
  { name: 'Resources' },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <!-- Hero -->
  <section class="relative py-28 px-6 bg-secondary overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-10 left-10 w-64 h-64 rounded-full bg-white blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-primary blur-3xl"></div>
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <span class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-6 justify-center">
        <span class="w-8 h-px bg-primary"></span>
        {hero.tagline || 'Resource Center'}
      </span>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-white" set:html={hero.title || 'Tools & Resources<br />For SUP Business Partners'} />
      <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">{hero.subtitle || 'Download OEM guides, product catalogs, quality reports, and use our ROI calculator to plan your SUP fleet investment.'}</p>
    </div>
  </section>

  <!-- Resource Cards -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {resources.map((res: any) => (
        <a
          href={res.link ? '/' + lang + res.link : '#'}
          class="group bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-8 hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col"
        >
          <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 text-primary">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">{res.title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed flex-1">{res.description}</p>
          {res.type && (
            <span class="mt-4 text-xs font-semibold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full self-start">
              {res.type}
            </span>
          )}
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:gap-2 transition-all">
            {res.cta || 'Access'} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured White Paper -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="bg-gradient-to-br from-sky-50 to-blue-50 dark:from-slate-800 dark:to-slate-900 rounded-3xl p-8 md:p-12 border border-sky-100 dark:border-slate-700">
      <div class="grid md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <span class="text-xs font-semibold tracking-[0.2em] uppercase text-sky-600">Featured White Paper</span>
          <h3 class="mt-3 text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">The Complete Guide to OEM Inflatable SUP Manufacturing</h3>
          <p class="mt-3 text-gray-500 dark:text-slate-400">42-page white paper covering mold design, material selection, quality control, compliance certification, cost optimization, and logistics for private label and custom SUP production.</p>
          <ul class="mt-4 space-y-2 text-sm text-gray-500 dark:text-slate-400">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-sky-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>10 chapters covering every stage of OEM production</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-sky-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Factory audit checklist and NDA templates included</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-sky-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Real brand launch case studies with budgets and timelines</li>
          </ul>
        </div>
        <div class="text-center">
          <a href={`/${lang}/whitepaper/oem-sup-manufacturing-guide`} class="inline-flex items-center gap-2 px-8 py-4 bg-sky-600 hover:bg-sky-700 text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-xl">
            Download Free →
          </a>
          <p class="mt-3 text-xs text-gray-400 dark:text-slate-500">Instant PDF download. No CC required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Section -->
  <section id="roi-calculator" class="bg-[#F8FAFB] dark:bg-slate-800/50 py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-4 justify-center">
          <span class="w-8 h-px bg-primary"></span>
          {t('resources.roiTagline') || 'ROI Calculator'}
        </span>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-secondary">
          {t('resources.roiTitle') || 'SUP Fleet ROI Calculator'}
        </h2>
        <p class="mt-4 text-lg text-gray-500">
          {t('resources.roiSubtitle') || 'Estimate your SUP fleet investment, projected annual revenue, and payback period.'}
        </p>
      </div>
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 md:p-12 shadow-lg border border-gray-200 dark:border-slate-700">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-semibold text-foreground mb-2">{t('resources.calc.fleetSize') || 'Fleet Size (boards)'}</label>
              <input type="range" id="fleet-size" min="10" max="200" value="50" step="10" class="w-full accent-primary" oninput="updateROI()" />
              <span class="text-sm text-muted" id="fleet-size-label">50</span>
            </div>
            <div>
              <label class="block text-sm font-semibold text-foreground mb-2">{t('resources.calc.boardCost') || 'Cost Per Board ($)'}</label>
              <input type="range" id="board-cost" min="200" max="800" value="400" step="50" class="w-full accent-primary" oninput="updateROI()" />
              <span class="text-sm text-muted" id="board-cost-label">$400</span>
            </div>
            <div>
              <label class="block text-sm font-semibold text-foreground mb-2">{t('resources.calc.dailyRate') || 'Avg. Daily Rental Rate ($)'}</label>
              <input type="range" id="daily-rate" min="20" max="80" value="40" step="5" class="w-full accent-primary" oninput="updateROI()" />
              <span class="text-sm text-muted" id="daily-rate-label">$40</span>
            </div>
            <div>
              <label class="block text-sm font-semibold text-foreground mb-2">{t('resources.calc.seasonDays') || 'Operating Days / Year'}</label>
              <input type="range" id="season-days" min="60" max="365" value="200" step="5" class="w-full accent-primary" oninput="updateROI()" />
              <span class="text-sm text-muted" id="season-days-label">200</span>
            </div>
          </div>
          <div class="bg-secondary/5 rounded-2xl p-8 flex flex-col justify-center">
            <h3 class="text-lg font-semibold text-foreground mb-6">{t('resources.calc.results') || 'Your Projected ROI'}</h3>
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-sm text-muted">{t('resources.calc.totalInvestment') || 'Total Investment'}</span>
                <span class="text-2xl font-bold text-foreground" id="total-investment">$20,000</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-muted">{t('resources.calc.annualRevenue') || 'Annual Revenue Potential'}</span>
                <span class="text-2xl font-bold text-primary" id="annual-revenue">$120,000</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-muted">{t('resources.calc.paybackPeriod') || 'Payback Period'}</span>
                <span class="text-2xl font-bold text-emerald-600" id="payback-period">2 months</span>
              </div>
              <div class="pt-4 border-t border-gray-200 dark:border-slate-700">
                <div class="flex justify-between items-center">
                  <span class="text-sm text-muted">{t('resources.calc.annualProfit') || 'Annual Net Profit'}</span>
                  <span class="text-2xl font-bold text-emerald-600" id="annual-profit">$100,000</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div  >
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-6 py-20 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">{cta.title || 'Need Custom Support?'}</h2>
    <p class="mt-4 text-lg text-gray-500">{cta.subtitle || 'Contact our B2B team for personalized guidance on your project.'}</p>
    <a
      href={cta.link ? '/' + lang + cta.link : '/' + lang + '/contact'}
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all"
    >
      {cta.button || 'Contact Sales Team'} →
    </a>
  </section>

  <script is:inline>
    function updateROI() {
      const fleetSize = parseInt(document.getElementById('fleet-size').value);
      const boardCost = parseInt(document.getElementById('board-cost').value);
      const dailyRate = parseInt(document.getElementById('daily-rate').value);
      const seasonDays = parseInt(document.getElementById('season-days').value);
      const utilization = 0.65;
      const avgRentalsPerDay = 3;
      const maintenanceCostPerBoard = 300;

      const totalInvestment = fleetSize * boardCost;
      const annualRevenue = fleetSize * dailyRate * avgRentalsPerDay * seasonDays * utilization;
      const annualMaintenance = fleetSize * maintenanceCostPerBoard;
      const annualProfit = annualRevenue - annualMaintenance;
      const paybackMonths = totalInvestment > 0 && annualProfit > 0
        ? Math.ceil((totalInvestment / annualProfit) * 12)
        : 0;

      document.getElementById('fleet-size-label').textContent = fleetSize;
      document.getElementById('board-cost-label').textContent = '$' + boardCost;
      document.getElementById('daily-rate-label').textContent = '$' + dailyRate;
      document.getElementById('season-days-label').textContent = seasonDays;
      document.getElementById('total-investment').textContent = '$' + totalInvestment.toLocaleString();
      document.getElementById('annual-revenue').textContent = '$' + Math.round(annualRevenue).toLocaleString();
      document.getElementById('annual-profit').textContent = '$' + Math.round(annualProfit).toLocaleString();
      document.getElementById('payback-period').textContent = paybackMonths <= 1 ? '1 month' : paybackMonths + ' months';
    }
    document.addEventListener('DOMContentLoaded', updateROI);
  </script>
</Layout>
