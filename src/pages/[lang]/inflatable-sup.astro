---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { products } from '~/data/products';
import productVisualsData from '~/data/site/product-visuals.yaml';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';
import { landingI18n as __landing } from '~/i18n/generated/landing/inflatable-sup';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const __lt = __landing[lang || ''] || {};
const fr = (en: string, francais: string) => __lt[en] || (lang === 'fr' ? francais : en);

const supProducts = products.filter((p) => p.category === 'SUP');

const productVisuals = Object.fromEntries(
  (productVisualsData?.visuals || []).filter((v) => v?.id && v?.image).map((v) => [v.id, v.image])
);

const metadata = {
  title: fr(
    'Inflatable SUP Boards | Premium Paddle Boards | Afarer',
    'Paddles Gonflables | Planches de Paddle Premium | afarer'
  ),
  description: fr(
    'Discover Afarer premium inflatable SUP boards — beginner-friendly all-around boards, touring SUPs, ultra-stable platforms, and adventure-ready designs. CE-certified drop-stitch construction.',
    'Découvrez les paddles gonflables premium afarer — planches polyvalentes pour débutants, paddles de randonnée, plateformes ultra-stables et designs prêts pour l’aventure. Construction drop-stitch certifiée CE.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/inflatable-sup/`;
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr(
        'Inflatable SUP Boards — Premium Paddle Boards for Every Adventure',
        'Paddles Gonflables — Des planches de paddle premium pour chaque aventure'
      ),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        { position: 2, name: fr('Inflatable SUP Boards', 'Paddles Gonflables'), item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: fr(
            'What type of inflatable SUP board should I choose?',
            'Quel type de paddle gonflable dois-je choisir ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'The best type depends on your paddling style. All-around SUPs are most versatile for recreation. Touring SUPs excel at long-distance paddling. Ultra-stable SUPs prioritize stability for yoga, fishing, or larger paddlers. Whitewater SUPs handle river rapids. Consider where and how you will paddle most.',
              'Le meilleur type dépend de votre style de pagayage. Les paddles polyvalents sont les plus versatiles pour la récréation. Les paddles de randonnée excellent pour les longues distances. Les paddles ultra-stables privilégient la stabilité pour le yoga, la pêche ou les pagayeurs plus corpulents. Les paddles d’eau vive affrontent les rapides des rivières. Réfléchissez à l’endroit et à la manière dont vous pagayerez le plus.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Are inflatable SUPs as good as hard boards?',
            'Les paddles gonflables sont-ils aussi performants que les planches rigides ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Modern inflatable SUPs offer performance comparable to hard boards. Advances in drop-stitch construction, higher PSI ratings, and fusion-laminated seams have closed the gap. Inflatables are more portable, durable, and easier to store than hard boards.',
              'Les paddles gonflables modernes offrent des performances comparables aux planches rigides. Les avancées en construction drop-stitch, les pressions PSI plus élevées et les coutures à laminage par fusion ont comblé l’écart. Les gonflables sont plus portables, plus durables et plus faciles à ranger que les planches rigides.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('How long do inflatable SUPs last?', 'Quelle est la durée de vie d’un paddle gonflable ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'With proper care, a quality inflatable SUP can last 5-10 years or more. Key factors: storage away from direct UV, proper inflation to recommended PSI, rinsing after saltwater use, and avoiding sharp objects. Afarer boards use military-grade PVC for extended lifespan.',
              'Avec des soins appropriés, un paddle gonflable de qualité peut durer 5 à 10 ans ou plus. Facteurs clés : stockage à l’abri des UV directs, gonflage à la pression PSI recommandée, rinçage après utilisation en eau salée et évitement des objets tranchants. Les planches afarer utilisent un PVC de qualité militaire pour une durée de vie prolongée.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('What PSI should I inflate my SUP to?', 'À quelle pression PSI dois-je gonfler mon paddle ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Most inflatable SUPs should be inflated to 12-15 PSI for optimal rigidity and performance. Afarer boards are rated for 15 PSI maximum. Use the included pump with pressure gauge to achieve consistent inflation.',
              'La plupart des paddles gonflables doivent être gonflés à 12–15 PSI pour une rigidité et des performances optimales. Les planches afarer sont conçues pour un maximum de 15 PSI. Utilisez la pompe fournie avec manomètre pour un gonflage homogène.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Do you manufacture inflatable SUPs for private label brands?',
            'Fabriquez-vous des paddles gonflables en marque blanche ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Afarer is a leading OEM/ODM manufacturer of inflatable SUP boards. We offer custom designs, private labeling, bulk production, and CE certification for brands worldwide. MOQ from 50 units.',
              'Oui. afarer est un fabricant OEM/ODM de premier plan de paddles gonflables. Nous proposons des designs personnalisés, du marquage en marque blanche, une production en série et la certification CE pour les marques du monde entier. MOQ à partir de 50 unités.'
            ),
          },
        },
      ],
    }}
  />
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href={localizeHref('/', lang || 'en')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >{fr('← Home', '← Accueil')}</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase"
        >{fr('SUP Product Center', 'Centre produits paddle')}</span
      >
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        {fr('Inflatable SUP Boards', 'Paddles Gonflables')}
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        {
          fr(
            'Afarer inflatable SUP boards combine premium drop-stitch construction with adventure-ready design. Whether you are a first-time paddler, a touring enthusiast, or a professional outfitter, our SUP lineup delivers stability, portability, and lasting performance on lakes, rivers, and coastal waters.',
            'Les paddles gonflables afarer allient une construction drop-stitch premium à un design prêt pour l’aventure. Que vous soyez un pagayeur débutant, un passionné de randonnée ou un organisateur professionnel, notre gamme de paddles offre stabilité, portabilité et performances durables sur les lacs, les rivières et les eaux côtières.'
          )
        }
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">
          {fr('Our SUP Collection', 'Notre collection de paddles SUP')}
        </h2>
        <p class="mt-4 text-lg text-gray-500">
          {
            fr(
              'Every board engineered for a specific style of paddling.',
              'Chaque planche est conçue pour un style de pagayage spécifique.'
            )
          }
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          supProducts.map((p) => {
            const img =
              productVisuals[p.id] ||
              'https://assets.afarer.com/images/afarer/products/sup-series/sup-jungle-mandala-app-1-1200w.webp';
            const useCaseTags = (p.ai_use_cases || []).slice(0, 3);
            return (
              <a
                href={localizeHref('/products/' + p.id, lang || 'en')}
                class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              >
                <div class="aspect-[4/3] bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
                  <img
                    src={img}
                    alt={p.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <div class="flex flex-wrap gap-2 mb-3">
                    {useCaseTags.map((tag) => (
                      <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-medium rounded-full">{tag}</span>
                    ))}
                  </div>
                  <h3 class="text-xl font-bold text-secondary group-hover:text-primary transition-colors">{p.name}</h3>
                  <p class="mt-2 text-sm text-gray-500 line-clamp-2">{p.desc}</p>
                  <div class="mt-4 flex flex-wrap gap-2 text-xs">
                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full">{p.skill}</span>
                    {p.environment.slice(0, 2).map((e) => (
                      <span class="px-2 py-1 bg-gray-100 text-gray-500 rounded-full">{e}</span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">
        {fr('Why Choose an Inflatable SUP?', 'Pourquoi choisir un paddle gonflable ?')}
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">
            {fr('Portable & Travel-Friendly', 'Portable & facile à transporter')}
          </h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            {
              fr(
                'Every Afarer SUP packs into a backpack-sized carrying case. At just 18–22 lbs, it is easy to carry to the beach, lake, or through airport terminals.',
                'Chaque paddle afarer se range dans un sac de transport format sac à dos. À peine 8 à 10 kg, il est facile à transporter à la plage, au lac ou dans les aéroports.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">{fr('Drop-Stitch Rigidity', 'Rigidité drop-stitch')}</h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            {
              fr(
                'Thousands of internal threads connect the deck and hull at 12–15 PSI, creating a stiff platform that performs like a hard board but stores in a closet.',
                'Des milliers de fils internes relient le pont et la coque à 12–15 PSI, créant une plateforme rigide qui se comporte comme une planche rigide tout en se rangeant dans un placard.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">
            {fr('Durable & Impact-Resistant', 'Durable & résistant aux chocs')}
          </h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            {
              fr(
                'Military-grade PVC with fusion-laminated seams withstands rocks, docks, and shallow water better than epoxy boards. No dings, no cracks.',
                'Le PVC de qualité militaire avec coutures à laminage par fusion résiste mieux aux rochers, aux pontons et aux eaux peu profondes que les planches en époxy. Aucun éclat, aucune fissure.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">{fr('CE Certified Safety', 'Sécurité certifiée CE')}</h3>
          <p class="mt-3 text-gray-500 text-sm leading-relaxed">
            {
              fr(
                'Every board meets CE safety standards with clear water-condition ratings, skill-level guidance, and safety rules printed on every product.',
                'Chaque planche respecte les normes de sécurité CE avec des classifications claires des conditions d’eau, des repères de niveau et des règles de sécurité imprimés sur chaque produit.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary">
          {fr('SUP Knowledge Center', 'Centre de connaissances paddle')}
        </h2>
        <p class="mt-4 text-lg text-gray-500">
          {
            fr(
              'Guides and resources to help you choose the right board.',
              'Guides et ressources pour vous aider à choisir la bonne planche.'
            )
          }
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href={localizeHref('/compare/inflatable-vs-hardboard', lang || 'en')}
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {fr('Inflatable vs Hard SUP', 'Paddle gonflable ou rigide')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {
              fr(
                'Compare portability, durability, performance, and cost.',
                'Comparez portabilité, durabilité, performance et coût.'
              )
            }
          </p>
        </a>
        <a
          href={localizeHref('/research/sup-thickness-guide', lang || 'en')}
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {fr('SUP Thickness Guide', 'Guide de l’épaisseur des paddles')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {
              fr(
                'How board thickness affects stability and performance.',
                'Comment l’épaisseur de la planche influence la stabilité et les performances.'
              )
            }
          </p>
        </a>
        <a
          href={localizeHref('/research/ce-certification-guide', lang || 'en')}
          class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {fr('CE Certification Guide', 'Guide de la certification CE')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {
              fr(
                'What CE marking means and how to verify compliance.',
                'Ce que signifie le marquage CE et comment vérifier la conformité.'
              )
            }
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">
      {fr('Ready to Find Your Perfect SUP?', 'Prêt à trouver votre paddle idéal ?')}
    </h2>
    <p class="mt-4 text-lg text-gray-500">
      {
        fr(
          'Browse our full collection or get in touch with our team.',
          'Parcourez notre collection complète ou contactez notre équipe.'
        )
      }
    </p>
    <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
      <a
        href={localizeHref('/products', lang || 'en')}
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >
        {fr('Browse All Products', 'Voir tous les produits')}
        <span>→</span>
      </a>
      <a
        href={localizeHref('/contact', lang || 'en')}
        class="inline-flex items-center gap-2 px-8 py-4 border-2 border-gray-300 text-gray-700 font-semibold rounded-full hover:border-primary hover:text-primary transition-all"
      >
        {fr('Contact Us', 'Contactez-nous')}
      </a>
    </div>
  </section>
  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        {fr('Inflatable SUP — Frequently Asked Questions', 'Paddle Gonflable — Questions Fréquentes')}
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        {
          fr(
            'Common questions about choosing and using inflatable paddle boards.',
            'Questions courantes sur le choix et l’utilisation des paddles gonflables.'
          )
        }
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">
            {
              fr(
                'What type of inflatable SUP board should I choose?',
                'Quel type de paddle gonflable dois-je choisir ?'
              )
            }
          </h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'The best type depends on your paddling style. All-around SUPs are most versatile for recreation. Touring SUPs excel at long-distance paddling. Ultra-stable SUPs prioritize stability for yoga, fishing, or larger paddlers. Whitewater SUPs handle river rapids. Consider where and how you will paddle most.',
                'Le meilleur type dépend de votre style de pagayage. Les paddles polyvalents sont les plus versatiles pour la récréation. Les paddles de randonnée excellent pour les longues distances. Les paddles ultra-stables privilégient la stabilité pour le yoga, la pêche ou les pagayeurs plus corpulents. Les paddles d’eau vive affrontent les rapides des rivières. Réfléchissez à l’endroit et à la manière dont vous pagayerez le plus.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">
            {
              fr(
                'Are inflatable SUPs as good as hard boards?',
                'Les paddles gonflables sont-ils aussi performants que les planches rigides ?'
              )
            }
          </h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Modern inflatable SUPs offer performance comparable to hard boards. Advances in drop-stitch construction, higher PSI ratings, and fusion-laminated seams have closed the gap. Inflatables are more portable, durable, and easier to store than hard boards.',
                'Les paddles gonflables modernes offrent des performances comparables aux planches rigides. Les avancées en construction drop-stitch, les pressions PSI plus élevées et les coutures à laminage par fusion ont comblé l’écart. Les gonflables sont plus portables, plus durables et plus faciles à ranger que les planches rigides.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">
            {fr('How long do inflatable SUPs last?', 'Quelle est la durée de vie d’un paddle gonflable ?')}
          </h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'With proper care, a quality inflatable SUP can last 5–10 years or more. Key factors: storage away from direct UV, proper inflation to recommended PSI, rinsing after saltwater use, and avoiding sharp objects. Afarer boards use military-grade PVC for extended lifespan.',
                'Avec des soins appropriés, un paddle gonflable de qualité peut durer 5 à 10 ans ou plus. Facteurs clés : stockage à l’abri des UV directs, gonflage à la pression PSI recommandée, rinçage après utilisation en eau salée et évitement des objets tranchants. Les planches afarer utilisent un PVC de qualité militaire pour une durée de vie prolongée.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">
            {fr('What PSI should I inflate my SUP to?', 'À quelle pression PSI dois-je gonfler mon paddle ?')}
          </h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Most inflatable SUPs should be inflated to 12–15 PSI for optimal rigidity and performance. Afarer boards are rated for 15 PSI maximum. Use the included pump with pressure gauge to achieve consistent inflation.',
                'La plupart des paddles gonflables doivent être gonflés à 12–15 PSI pour une rigidité et des performances optimales. Les planches afarer sont conçues pour un maximum de 15 PSI. Utilisez la pompe fournie avec manomètre pour un gonflage homogène.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">
            {
              fr(
                'Do you manufacture inflatable SUPs for private label brands?',
                'Fabriquez-vous des paddles gonflables en marque blanche ?'
              )
            }
          </h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Yes. Afarer is a leading OEM/ODM manufacturer of inflatable SUP boards. We offer custom designs, private labeling, bulk production, and CE certification for brands worldwide. MOQ from 50 units.',
                'Oui. afarer est un fabricant OEM/ODM de premier plan de paddles gonflables. Nous proposons des designs personnalisés, du marquage en marque blanche, une production en série et la certification CE pour les marques du monde entier. MOQ à partir de 50 unités.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">
      {fr('Need Help Choosing Your SUP?', 'Besoin d’aide pour choisir votre paddle ?')}
    </h2>
    <p class="mt-4 text-lg text-gray-500">
      {
        fr(
          'Contact our team for personalized recommendations based on your height, weight, and paddling goals.',
          'Contactez notre équipe pour des recommandations personnalisées selon votre taille, votre poids et vos objectifs de pagayage.'
        )
      }
    </p>
    <a
      href={localizeHref('/contact', lang || 'en')}
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >{fr('Get Expert Advice', 'Obtenir des conseils d’experts')} <span>→</span></a
    >
  </section>
</Layout>
