---
export const prerender = true;

import Features3 from '~/components/widgets/Features3.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/resources.ts';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return [];
}

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'resources');

const hero = page.hero_text ?? {};
const downloads = page.features3_downloads ?? {};
const faqs = page.faqs ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const metadata = {
  title: `Resources — ${SITE.name} | Product Catalogs & Buyer Guides`,
  description:
    t('resources.metaDesc') ||
    'Download product catalogs, OEM manufacturing guides, buyer checklists, and technical documentation for marine equipment procurement.',
};
const crumbs = [{ name: 'Home', href: `/${lang}/` }, { name: 'Resources' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <HeroText tagline={hero.tagline} title={hero.title} subtitle={hero.subtitle} />
  <Features3
    tagline={downloads.tagline}
    title={downloads.title}
    subtitle={downloads.subtitle}
    columns={downloads.columns}
    items={downloads.items}
  />
  <FAQs title={faqs.title} subtitle={faqs.subtitle} columns={faqs.columns} items={faqs.items} />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
</Layout>
