              )
            }
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-6 text-center">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center mx-auto mb-4"
