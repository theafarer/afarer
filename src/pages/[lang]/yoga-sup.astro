---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);

const metadata = {
  title: fr(
    'SUP Yoga Board | Best Inflatable Paddle Board for Yoga | Afarer OEM Manufacturer',
    'Planche de Paddle Yoga | Meilleur Paddle Gonflable pour le Yoga | Fabricant OEM afarer'
  ),
  description: fr(
    'Afarer SUP yoga boards — wide, stable inflatable paddle boards designed for yoga and meditation on the water. Soft EVA decks, spacious platforms, CE certified. OEM/ODM manufacturing available for brands, resorts, and studios.',
    'Planches de paddle yoga afarer — paddles gonflables larges et stables conçus pour le yoga et la méditation sur l’eau. Ponts EVA souples, plateformes spacieuses, certification CE. Fabrication OEM/ODM disponible pour les marques, complexes hôteliers et studios.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/yoga-sup/`;
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr(
        'SUP Yoga Board — Find Your Flow on the Water',
        'Planche de Paddle Yoga — Trouvez votre Flow sur l’eau'
      ),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: fr('Inflatable SUP Boards', 'Paddles Gonflables'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: fr('SUP Yoga Board', 'Planche de Paddle Yoga'), item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: fr(
            'What makes a SUP board good for yoga?',
            'Qu’est-ce qui rend une planche de paddle adaptée au yoga ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'A SUP yoga board needs a wide stable platform (33-36 inches), soft EVA foam deck traction for barefoot comfort, and sufficient length for full-body poses. Stability is the most important factor - the wider the board, the easier it is to hold poses.',
              'Une planche de paddle yoga nécessite une plateforme large et stable (84 à 91 cm), un antidérapant en mousse EVA souple pour le confort des pieds nus et une longueur suffisante pour les postures du corps entier. La stabilité est le facteur le plus important — plus la planche est large, plus il est facile de tenir les postures.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Is SUP yoga harder than regular yoga?',
            'Le yoga sur paddle est-il plus difficile que le yoga classique ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'SUP yoga adds an element of balance challenge not found in studio practice. The unstable surface engages more stabilizer muscles, making even basic poses more intense. Many practitioners find it deepens body awareness and focus.',
              'Le yoga sur paddle ajoute un défi d’équilibre absent de la pratique en studio. La surface instable sollicite davantage les muscles stabilisateurs, rendant même les postures de base plus intenses. De nombreux pratiquants constatent que cela approfondit la conscience corporelle et la concentration.'
