---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { pageContentData } from '~/i18n/generated/data';
import { EVIDENCE_BODY_OVERRIDES } from '~/data/site/evidence-body';

interface CaseStudy {
  id: string;
  client: string;
  product: string;
  industry: string;
  challenge: string;
  solution: string;
  result: string;
  image: string;
  tags: string[];
  outcome_metrics: { label: string; value: string }[];
}

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const d = pageContentData[`${lang}/site-evidence`] || pageContentData['en/site-evidence'] || {};
const caseStudies: CaseStudy[] = d.case_studies ?? [];

const bodyMap = EVIDENCE_BODY_OVERRIDES[lang || defaultLang];
const localizedStudies: CaseStudy[] = caseStudies.map((cs) => {
  const b = bodyMap?.[cs.id];
  if (!b) return cs;
  return {
    ...cs,
    client: b.client,
    product: b.product,
    industry: b.industry,
    challenge: b.challenge,
    outcome_metrics: b.outcomeMetrics.map((m) => ({ label: m.label, value: m.value })),
  };
});

const metadata = {
  title: `${t('home.evidence.title') || 'Case Studies'} | ${SITE.name}`,
  description: t('home.evidence.subtitle') || 'Real customer success stories and deployment case studies.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="BreadcrumbList"
    breadcrumbs={[
      { name: SITE.name, href: `/${lang}/` },
      { name: t('home.evidence.title') || 'Evidence', href: `/${lang}/evidence` },
      { name: t('home.evidence.caseStudies') || 'Case Studies' },
    ]}
  />
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Case Studies',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={`/${lang}/`} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang}/evidence`} class="hover:text-sky-600">{t('home.evidence.title') || 'Evidence'}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.evidence.caseStudies') || 'Case Studies'}</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
        >{t('home.evidence.caseStudies') || 'Customer Success Stories'}</span
      >
      <h1 class="mt-4 text-4xl font-bold text-gray-900">{t('home.evidence.caseStudies') || 'Case Studies'}</h1>
      <p class="mt-4 text-lg text-gray-500">
        {
          t('home.evidence.description') ||
            'Real partnerships across industries — from boutique brands to government agencies.'
        }
      </p>
    </div>

    <section class="mb-20">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          localizedStudies.map((cs) => (
            <a
              href={`/${lang}/evidence/case-studies/${cs.id}`}
              class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
            >
              <div class="h-48 bg-gray-100 overflow-hidden">
                <img
                  src={cs.image}
                  alt={cs.product}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full">
                    {cs.industry}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                  {cs.client}
                </h3>
                <p class="text-sm text-gray-500 mb-1">{cs.product}</p>
                <p class="text-xs text-gray-400 line-clamp-3 mt-1">{cs.challenge}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {cs.outcome_metrics.slice(0, 3).map((m) => (
                    <span class="text-xs bg-gray-50 border border-gray-200 rounded-lg px-2 py-1">
                      <strong class="text-gray-900">{m.value}</strong>
                      <span class="text-gray-500"> {m.label}</span>
                    </span>
                  ))}
                </div>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                  {t('home.evidence.viewCaseStudy') || 'View Case Study'} &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="bg-gradient-to-r from-sky-600 to-blue-700 rounded-2xl p-10 text-center text-white">
      <h2 class="text-2xl font-bold mb-3">{t('home.evidence.ctaTitle') || 'Want to discuss your project?'}</h2>
      <p class="text-sky-100 max-w-xl mx-auto mb-6">
        {t('home.evidence.ctaSubtitle') || 'Tell us about your requirements and we will share relevant case studies.'}
      </p>
      <a
        href={`/${lang}/contact`}
        class="inline-block bg-white text-sky-700 font-semibold px-8 py-3 rounded-xl hover:bg-sky-50 transition-colors"
        >{t('home.evidence.ctaButton') || 'Contact Our Team'}</a
      >
    </section>
  </div>
</Layout>
