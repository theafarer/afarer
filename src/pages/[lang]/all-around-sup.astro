---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';
import { landingI18n as __landing } from '~/i18n/generated/landing/all-around-sup';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const __lt = __landing[lang || ''] || {};
const fr = (en: string, francais: string) => __lt[en] || (lang === 'fr' ? francais : en);

const metadata = {
  title: fr(
    'All-Around SUP Board | Versatile Inflatable Paddle Board | Afarer OEM Manufacturer',
    'Paddle Polyvalent | Planche de Paddle Gonflable Polyvalente | Fabricant OEM afarer'
  ),
  description: fr(
    'Afarer all-around inflatable SUP boards — versatile designs for recreation, fitness, and casual touring. Stable, portable, beginner-friendly. CE certified. OEM/ODM manufacturing available for brands, resorts, and clubs.',
    'Paddles gonflables polyvalents afarer — des designs polyvalents pour la récréation, le fitness et la randonnée occasionnelle. Stables, portables, adaptés aux débutants. Certification CE. Fabrication OEM/ODM disponible pour les marques, complexes hôteliers et clubs.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/all-around-sup/`;
const today = '2026-07-27';

const faqItems = [
  {
    question: fr('What is an all-around SUP board?', 'Qu’est-ce qu’un paddle polyvalent ?'),
    answer: fr(
      'An all-around SUP board is the most versatile inflatable paddle board category, designed to perform well across flatwater lakes, slow rivers, and protected coastal waters. It balances stability, maneuverability, and tracking for recreation, fitness, and casual touring.',
      'Un paddle polyvalent est la catégorie de paddle gonflable la plus polyvalente, conçue pour bien performer sur les lacs d’eau plate, les rivières lentes et les eaux côtières protégées. Il équilibre stabilité, manœuvrabilité et trajectoire pour la récréation, le fitness et la randonnée occasionnelle.'
    ),
  },
  {
    question: fr('What size all-around SUP should I choose?', 'Quelle taille de paddle polyvalent dois-je choisir ?'),
    answer: fr(
      'For most adults, an all-around SUP between 10\'6" and 11\'6" with 32"–34" width provides the best balance of stability and performance. Heavier paddlers (200+ lbs) should choose longer/wider models for adequate buoyancy.',
      'Pour la plupart des adultes, un paddle polyvalent entre 3,20 m et 3,50 m avec une largeur de 81 à 86 cm offre le meilleur équilibre entre stabilité et performance. Les pagayeurs plus corpulents (plus de 90 kg) devraient choisir des modèles plus longs et plus larges pour une flottabilité suffisante.'
    ),
  },
  {
    question: fr(
      'Are inflatable all-around SUPs stable for beginners?',
      'Les paddles gonflables polyvalents sont-ils stables pour les débutants ?'
    ),
    answer: fr(
      'Yes. All-around SUPs are the most beginner-friendly category due to their wide tail, moderate rocker, and balanced dimensions. The wide platform provides exceptional stability for learning paddle techniques.',
      'Oui. Les paddles polyvalents sont la catégorie la plus adaptée aux débutants grâce à leur arrière large, leur rocker modéré et leurs dimensions équilibrées. La plateforme large offre une stabilité exceptionnelle pour apprendre les techniques de paddle.'
    ),
  },
  {
    question: fr(
      'Can all-around SUPs be used for touring?',
      'Les paddles polyvalents peuvent-ils servir pour la randonnée ?'
    ),
    answer: fr(
      'Yes. While purpose-built touring SUPs offer better glide for long distances, all-around boards handle casual touring and day trips on calm water very well. Their moderate length provides adequate tracking for most recreational needs.',
      'Oui. Bien que les paddles de randonnée dédiés offrent un meilleur glissé sur longues distances, les planches polyvalentes conviennent très bien à la randonnée occasionnelle et aux sorties à la journée sur eau calme. Leur longueur modérée offre une trajectoire suffisante pour la plupart des usages récréatifs.'
    ),
  },
  {
    question: fr(
      'Do you manufacture all-around SUPs for private label brands?',
      'Fabriquez-vous des paddles polyvalents en marque blanche ?'
    ),
    answer: fr(
      'Yes. Afarer offers OEM/ODM manufacturing for all-around SUP boards. We provide custom deck graphics, color matching, packaging design, and compliance documentation for brands, resorts, and retail partners worldwide.',
      'Oui. afarer propose la fabrication OEM/ODM de planches de paddle polyvalentes. Nous fournissons des graphismes de pont personnalisés, un colorimétrage sur mesure, une conception d’emballage et une documentation de conformité pour les marques, complexes hôteliers et partenaires de distribution du monde entier.'
    ),
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr(
        'All-Around SUP Board — The Most Versatile Inflatable Paddle Board',
        'Paddle Polyvalent — La planche de paddle gonflable la plus polyvalente'
      ),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: fr('Inflatable SUP Boards', 'Paddles Gonflables'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: fr('All-Around SUP', 'Paddle polyvalent'), item: pageUrl },
      ],
    }}
  />
  <JsonLd data={faqLd} />

  <!-- Hero -->
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href={localizeHref('/inflatable-sup/', lang || 'en')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >{fr('← SUP Product Center', '← Centre produits paddle')}</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase"
        >{fr('SUP Category', 'Catégorie paddle')}</span
      >
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        {fr('All-Around SUP Board', 'Paddle Polyvalent')}
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        {
          fr(
            'The all-around SUP is the most versatile inflatable paddle board category — equally at home on calm lakes, slow rivers, and protected coastal waters. Afarer all-around SUPs combine balanced dimensions with stable drop-stitch platforms that deliver performance across recreation, fitness, and casual touring. Whether you are a first-time paddler or an experienced enthusiast looking for one board to do it all, the all-around SUP is the smartest choice.',
            'Le paddle polyvalent est la catégorie de paddle gonflable la plus polyvalente — aussi à l’aise sur les lacs calmes, les rivières lentes et les eaux côtières protégées. Les paddles polyvalents afarer allient des dimensions équilibrées à des plateformes drop-stitch stables qui offrent des performances en récréation, en fitness et en randonnée occasionnelle. Que vous soyez un pagayeur débutant ou un passionné expérimenté à la recherche d’une seule planche pour tout faire, le paddle polyvalent est le choix le plus malin.'
          )
        }
      </p>
    </div>
  </section>

  <!-- Key Features -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">
          {fr('Key Features of All-Around SUPs', 'Caractéristiques des paddles polyvalents')}
        </h2>
        <p class="mt-4 text-lg text-gray-500">
          {
            fr(
              'Why the all-around category dominates the SUP market.',
              'Pourquoi la catégorie polyvalente domine le marché du paddle.'
            )
          }
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 3v2.25M12 21v-2.25M3 12h2.25M18.75 12H21M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{fr('Balanced Dimensions', 'Dimensions équilibrées')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                '10\'6"–11\'6" length with 32"–34" width delivers optimal stability without sacrificing maneuverability. Tracks well on flat water, turns easily in tight spaces.',
                'Une longueur de 3,20 à 3,50 m et une largeur de 81 à 86 cm offrent une stabilité optimale sans sacrifier la manœuvrabilité. Bonne trajectoire sur eau plate, virages faciles dans les espaces restreints.'
              )
            }
          </p>
        </div>
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-50 to-green-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">
            {fr('Beginner-Friendly Stability', 'Stabilité idéale pour les débutants')}
          </h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Wide tail and moderate rocker provide a forgiving platform for learning paddle techniques. New paddlers typically stand and paddle confidently within their first session.',
                'Un arrière large et un rocker modéré offrent une plateforme indulgente pour apprendre les techniques de paddle. Les nouveaux pagayeurs tiennent généralement debout et pagayent avec confiance dès leur première séance.'
              )
            }
          </p>
        </div>
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-50 to-amber-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{fr('Fully Portable', 'Entièrement portable')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Packs into a backpack under 25 lbs. Take it on road trips, flights, or store in a closet. No roof rack needed. Inflates in 5–8 minutes with included pump.',
                'Se range dans un sac à dos de moins de 11 kg. Emportez-le en road trip, en avion ou rangez-le dans un placard. Aucun coffre de toit nécessaire. Se gonfle en 5 à 8 minutes avec la pompe fournie.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Best Products -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">
        {fr('Best All-Around SUP Products from Afarer', 'Meilleurs paddles polyvalents afarer')}
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href={localizeHref('/products/sup-explorer-11', lang || 'en')}
          class="group flex items-start gap-4 bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <div class="w-20 h-20 rounded-xl bg-gradient-to-br from-blue-50 to-cyan-50 flex-shrink-0 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-jungle-mandala-app-1-1200w.webp"
              alt="SUP Explorer 11'"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">SUP Explorer 11'</h3>
            <p class="mt-1 text-sm text-gray-500">
              {
                fr(
                  'Perfect all-around board for recreation and fitness. 32" width, beginner-friendly, 11\' drop-stitch construction.',
                  'Planche polyvalente parfaite pour la récréation et le fitness. 81 cm de large, idéale pour les débutants, construction drop-stitch de 3,35 m.'
                )
              }
            </p>
            <span class="inline-block mt-2 text-xs font-medium text-primary"
              >{fr('Learn more →', 'En savoir plus →')}</span
            >
          </div>
        </a>
        <a
          href={localizeHref('/products/sup-dolphin-wave', lang || 'en')}
          class="group flex items-start gap-4 bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <div class="w-20 h-20 rounded-xl bg-gradient-to-br from-teal-50 to-green-50 flex-shrink-0 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-dolphin-wave-1-1200w.webp"
              alt="Dolphin Wave Series"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">Dolphin Wave Series</h3>
            <p class="mt-1 text-sm text-gray-500">
              {
                fr(
                  'Versatile touring all-rounder for lakes and coastal paddling. Great glide with enhanced tracking fin system.',
                  'Polyvalente, elle excelle en randonnée sur les lacs et les eaux côtières. Excellent glissé avec un système d’ailerons améliorant la trajectoire.'
                )
              }
            </p>
            <span class="inline-block mt-2 text-xs font-medium text-primary"
              >{fr('Learn more →', 'En savoir plus →')}</span
            >
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Who Is It For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">
          {fr('Who Is an All-Around SUP For?', 'Pour qui est le paddle polyvalent ?')}
        </h2>
        <p class="mt-4 text-lg text-gray-500">
          {
            fr(
              'The most versatile board category suits the widest range of paddlers.',
              'La catégorie de planches la plus polyvalente convient au plus grand nombre de pagayeurs.'
            )
          }
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{fr('Recreational Paddlers', 'Pagayeurs récréatifs')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Perfect for weekend lake outings, gentle river floats, and coastal explorations. One board handles everything from flat-water cruising to light fitness paddling.',
                'Parfait pour les sorties du week-end au lac, les descentes de rivière tranquilles et les explorations côtières. Une seule planche couvre tout, de la croisière sur eau plate au paddle fitness léger.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{fr('First-Time Buyers', 'Premiers acheteurs')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'If you are buying your first SUP, an all-around board is the safest choice. Its forgiving stability makes learning faster and more enjoyable.',
                'Si vous achetez votre premier paddle, une planche polyvalente est le choix le plus sûr. Sa stabilité indulgente rend l’apprentissage plus rapide et plus agréable.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">
            {fr('Resort & Rental Fleets', 'Flottes de complexes hôteliers & de location')}
          </h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'All-around SUPs are the preferred choice for resort water activity programs and rental operations. Their durability, stability, and universal appeal make them ideal for guest use. OEM branding available.',
                'Les paddles polyvalents sont le choix privilégié des programmes d’activités nautiques des complexes hôteliers et des services de location. Leur durabilité, leur stabilité et leur attrait universel les rendent idéaux pour l’usage des clients. Marquage OEM disponible.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{fr('Private Label Brands', 'Marques en marque blanche')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Launching a SUP brand? The all-around category offers the broadest market appeal for private-label programs. Afarer provides turn-key OEM manufacturing with custom graphics, packaging, and compliance.',
                'Vous lancez une marque de paddle ? La catégorie polyvalente offre le plus large attrait du marché pour les programmes en marque blanche. afarer propose une fabrication OEM clé en main avec graphismes personnalisés, emballage et conformité.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
        {fr('OEM/ODM Manufacturing for All-Around SUPs', 'Fabrication OEM/ODM de paddles polyvalents')}
      </h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        {
          fr(
            'Afarer manufactures all-around SUP boards for global brands, resorts, paddle clubs, and retail chains. Our 12,000 m² facility produces CE-certified drop-stitch boards with custom deck graphics, color-matched PVC, and retail-ready packaging. MOQ from 50 units. Lead times from 30 days.',
            'afarer fabrique des planches de paddle polyvalentes pour les marques internationales, les complexes hôteliers, les clubs de paddle et les chaînes de distribution. Notre usine de 12 000 m² produit des planches drop-stitch certifiées CE avec graphismes de pont personnalisés, PVC coloré sur mesure et emballages prêts pour la vente. MOQ à partir de 50 unités. Délais de production à partir de 30 jours.'
          )
        }
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">{fr('Custom', 'Sur mesure')}</span>
          <p class="mt-1 text-sm text-gray-500">
            {fr('Deck graphics, color, packaging', 'Graphismes de pont, couleur, emballage')}
          </p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">{fr('Units minimum order', 'Unités minimum de commande')}</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">{fr('30 Days', '30 Jours')}</span>
          <p class="mt-1 text-sm text-gray-500">{fr('Typical lead time', 'Délai de production habituel')}</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a
          href={localizeHref('/oem-odm-manufacturer', lang || 'en')}
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
          >{fr('Request OEM Quote', 'Demander un devis OEM')} <span>→</span></a
        >
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        {fr('All-Around SUP — Frequently Asked Questions', 'Paddle Polyvalent — Questions Fréquentes')}
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        {
          fr(
            'Common questions about selecting, using, and manufacturing all-around paddle boards.',
            'Questions courantes sur le choix, l’utilisation et la fabrication de paddles polyvalents.'
          )
        }
      </p>
      <div class="space-y-4">
        {
          faqItems.map((item) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-semibold text-secondary">{item.question}</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary">
        {fr('All-Around SUP Guides', 'Guides sur le paddle polyvalent')}
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        {
          fr(
            'Related content to help you choose and use your all-around board.',
            'Contenus associés pour vous aider à choisir et utiliser votre planche polyvalente.'
          )
        }
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a
        href={localizeHref('/compare/inflatable-vs-hardboard', lang || 'en')}
