                )
              }
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary"
              >{fr('View product →', 'Voir le produit →')}</span
            >
          </div>
        </a>
        <a
          href={localizeHref('/products/sup-ocean-voyager', lang || 'en')}
