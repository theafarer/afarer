---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';
import { landingI18n as __landing } from '~/i18n/generated/landing/touring-sup';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const __lt = __landing[lang || ''] || {};
const fr = (en: string, francais: string) => __lt[en] || (lang === 'fr' ? francais : en);

const metadata = {
  title: fr(
    'Touring SUP Board | Long-Distance Inflatable Paddle Board | Afarer OEM Manufacturer',
    'Paddle de Randonnée | Paddle Gonflable pour Longues Distances | Fabricant OEM afarer'
  ),
  description: fr(
    'Afarer touring SUP boards — long-distance inflatable paddle boards with superior glide, pointed bows, and efficient tracking for lakes, coastal exploration, and multi-day expeditions. OEM/ODM manufacturing available for brands, resorts, and clubs.',
    'Paddles de randonnée afarer — paddles gonflables pour longues distances avec un glissé supérieur, des proues pointues et une trajectoire efficace pour les lacs, l’exploration côtière et les expéditions de plusieurs jours. Fabrication OEM/ODM disponible pour les marques, complexes hôteliers et clubs.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/touring-sup/`;
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr(
        'Touring SUP Board — Engineered for Long-Distance Exploration',
        'Paddle de Randonnée — Conçu pour l’Exploration sur Longues Distances'
      ),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: fr('Inflatable SUP Boards', 'Paddles Gonflables'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: fr('Touring SUP', 'Paddle de randonnée'), item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: fr('What is a touring SUP board?', 'Qu’est-ce qu’un paddle de randonnée ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              "A touring SUP board is a longer inflatable paddle board (12'–14') designed for efficient long-distance paddling on open water. It features a pointed displacement bow, deeper keel lines for tracking, and higher volume for carrying expedition gear.",
              'Un paddle de randonnée est un paddle gonflable plus long (3,65 à 4,27 m) conçu pour un pagayage efficace sur longues distances en eau libre. Il se caractérise par une proue à déplacement pointue, des quilles plus profondes pour la trajectoire et un volume supérieur pour transporter l’équipement d’expédition.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('Is a touring SUP good for beginners?', 'Un paddle de randonnée est-il adapté aux débutants ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Touring SUPs can be used by beginners on calm water, but their longer length makes them less maneuverable than all-around boards. Beginners comfortable with basic paddling technique will appreciate the superior tracking.',
              'Les paddles de randonnée peuvent être utilisés par des débutants sur eau calme, mais leur longueur plus importante les rend moins maniables que les planches polyvalentes. Les débutants à l’aise avec les techniques de base de pagayage apprécieront leur trajectoire supérieure.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('How long should a touring SUP be?', 'Quelle longueur pour un paddle de randonnée ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              "Touring SUPs typically range from 12' to 14'. A 12' board works well for day trips and lighter paddlers. A 14' board offers maximum glide for long-distance expeditions and heavier paddlers.",
              'Les paddles de randonnée mesurent généralement entre 3,65 et 4,27 m. Une planche de 3,65 m convient bien aux sorties à la journée et aux pagayeurs légers. Une planche de 4,27 m offre un glissé maximal pour les expéditions sur longues distances et les pagayeurs plus lourds.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Can you use a touring SUP for racing?',
            'Peut-on utiliser un paddle de randonnée pour la compétition ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Many touring SUPs are suitable for recreational racing and endurance events. Dedicated racing boards are lighter and narrower, but touring boards offer a good balance of speed and stability.',
              'Oui. De nombreux paddles de randonnée conviennent à la course récréative et aux épreuves d’endurance. Les planches de course dédiées sont plus légères et plus étroites, mais les planches de randonnée offrent un bon équilibre entre vitesse et stabilité.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Do you manufacture touring SUPs for private label?',
            'Fabriquez-vous des paddles de randonnée en marque blanche ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Afarer offers OEM/ODM manufacturing for touring SUP boards with custom lengths, deck graphics, color matching, and compliance documentation for brands and retail partners worldwide.',
              'Oui. afarer propose la fabrication OEM/ODM de planches de paddle de randonnée avec longueurs personnalisées, graphismes de pont, colorimétrage sur mesure et documentation de conformité pour les marques et partenaires de distribution du monde entier.'
            ),
          },
        },
      ],
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href={localizeHref('/inflatable-sup/', lang || 'en')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >{fr('← SUP Product Center', '← Centre produits paddle')}</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase"
        >{fr('SUP Category', 'Catégorie paddle')}</span
      >
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        {fr('Touring SUP Board', 'Paddle de Randonnée')}
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        {
          fr(
            "Touring SUPs are purpose-built for long-distance paddling. Afarer touring boards feature longer hulls (12'–14'), pronounced displacement bows, and efficient glide profiles that track straight through open water. Whether crossing a lake or exploring coastal shorelines, a touring SUP delivers the speed and range that recreational boards cannot match.",
            'Les paddles de randonnée sont conçus pour le pagayage sur longues distances. Les planches de randonnée afarer offrent des coques plus longues (3,65 à 4,27 m), des proues à déplacement prononcées et des profils de glissé efficaces qui maintiennent la trajectoire en eau libre. Que vous traversiez un lac ou exploriez les rivages côtiers, un paddle de randonnée offre la vitesse et l’autonomie que les planches récréatives ne peuvent égaler.'
          )
        }
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">
          {fr('Why Choose a Touring SUP?', 'Pourquoi choisir un paddle de randonnée ?')}
