---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';
import { withTrailingSlash } from '~/i18n/routing';

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';

const metadata = {
  title: `${t('solutionsByIndustry.title') || 'Solutions by Industry — Inflatable SUP Solutions for Every Sector'} | ${SITE.name}`,
  description:
    'Find the right inflatable SUP solution for your industry. Resorts, rental operators, paddle clubs, tourism, retail, and fishing — afarer manufactures CE-certified boards for every sector.',
  ignoreTitleTemplate: true,
};

const crumbs = [
  { name: t('nav.home'), href: `/${lang}/` },
  { name: t('solutionsByIndustry.title') || 'Solutions by Industry' },
];

const industries = [
  {
    name: 'Resorts & Hotels',
    color: 'from-teal-50 to-emerald-50',
    border: 'border-teal-200',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
    description:
      'Resort and waterfront property SUP fleets. High-durability rental-grade construction with custom branding, staff training, and fleet management support.',
    craft: ['Rental-grade SUPs (reinforced)', 'Custom-branded fleets', 'Kids and family SUPs'],
    certs: ['CE recreational craft', 'Commercial fleet grade'],
    link: withTrailingSlash(`/${lang}/products`),
  },
  {
    name: 'Rental Operators',
    color: 'from-sky-50 to-blue-50',
    border: 'border-sky-200',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    description:
      'Boards engineered for 1000+ inflation cycles and daily rental use. Military-grade PVC, UV-resistant graphics, and quick-turnaround replacement support.',
    craft: ['Rental-grade all-around SUPs', 'Touring SUPs for guided tours', 'Accessories and paddles'],
    certs: ['CE certified', 'UV/harsh environment tested'],
    link: withTrailingSlash(`/${lang}/products`),
  },
  {
    name: 'Paddle Clubs & SUP Schools',
    color: 'from-violet-50 to-purple-50',
    border: 'border-violet-200',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    description:
      'Fleet supply for paddle clubs and SUP schools. Bulk club pricing, mixed-size fleets for all skill levels, event support, and membership program equipment.',
    craft: ['Beginner-friendly SUPs', 'Stable teaching platforms', 'Race and touring boards'],
    certs: ['CE certified', 'Commercial fleet grade'],
    link: withTrailingSlash(`/${lang}/products`),
  },
  {
    name: 'Marine Tourism & Adventure Operators',
    color: 'from-cyan-50 to-blue-50',
    border: 'border-cyan-200',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197',
    description:
      'Tour and expedition equipment for marine tourism operators. Guided-tour fleets, group paddling setups, and durable boards for daily guest use.',
    craft: ['All-around SUPs (stable)', 'Giant multi-rider SUPs', 'Touring SUPs for excursions'],
    certs: ['CE recreational craft', 'UV/harsh environment tested'],
    link: withTrailingSlash(`/${lang}/products`),
  },
  {
    name: 'Retail Brands & Distributors',
    color: 'from-amber-50 to-yellow-50',
    border: 'border-amber-200',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 12.5V17a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h3.5a2 2 0 012 2v.5M15 12.5V17a2 2 0 01-2 2H6',
    description:
      'Private-label SUP programs and wholesale distribution. Full OEM/ODM support from design and tooling to packaging and compliance documentation.',
    craft: ['Private-label SUP lines', 'Wholesale fleet supply', 'Retail-ready packaging'],
    certs: ['CE certified', 'ISO 9001 manufacturing'],
    link: withTrailingSlash(`/${lang}/oem-odm-manufacturer`),
  },
  {
    name: 'Fishing & Outdoor',
    color: 'from-green-50 to-emerald-50',
    border: 'border-green-200',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z',
    description:
      'Fishing-specific SUPs with wide, stable platforms, gear-mount options, and accessory integration for anglers and outdoor retailers.',
    craft: ['Fishing SUPs (wide/stable)', 'Gear-mount configurations', 'Kayak-SUP hybrids'],
    certs: ['CE recreational', 'UV-stabilized materials'],
    link: withTrailingSlash(`/${lang}/products`),
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="max-w-6xl mx-auto py-24 px-6">
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">
      {t('solutionsByIndustry.title') || 'Solutions by Industry'}
    </h1>
    <p class="mt-4 text-lg text-gray-500">
      Find the right inflatable SUP solution for your industry. Each solution is backed by CE certification, ISO quality
      management, and a 12,000 m² manufacturing facility.
    </p>

    <div class="mt-16 space-y-8">
      {
        industries.map((ind) => (
          <div
            class={`bg-gradient-to-br ${ind.color} rounded-2xl border ${ind.border} p-8 hover:shadow-md transition-shadow`}
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-white/80 flex items-center justify-center flex-shrink-0">
                <svg
                  class="w-6 h-6 text-gray-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={ind.icon} />
                </svg>
              </div>
              <div class="flex-1">
                <h2 class="text-xl font-semibold text-gray-900">{ind.name}</h2>
                <p class="mt-2 text-sm text-gray-600">{ind.description}</p>
                <div class="mt-4">
                  <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">
                    {t('solutionsByIndustry.recommendedCraft') || 'Recommended Boards'}
                  </span>
                  <ul class="mt-2 space-y-1">
                    {ind.craft.map((c) => (
                      <li class="flex items-center gap-2 text-sm text-gray-600">
                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400 flex-shrink-0" />
                        {c}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-3 flex items-center gap-4">
                  <span class="text-xs text-gray-400">{ind.certs.join(' · ')}</span>
                </div>
                <a
                  href={ind.link}
                  class="mt-4 inline-flex text-sm font-medium text-sky-600 hover:text-sky-700 hover:underline"
                >
                  {t('solutionsByIndustry.learnMore') || 'Learn more'} →
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <section class="mt-16 bg-gray-50 rounded-2xl p-8 border border-gray-200 text-center">
      <h2 class="text-2xl font-semibold text-gray-900">
        {t('solutionsByIndustry.ctaTitle') || 'Need a Custom Solution?'}
      </h2>
      <p class="mt-4 text-gray-500">
        {
          t('solutionsByIndustry.ctaDesc') ||
            'Our OEM/ODM team can design and manufacture custom inflatable SUPs for your specific industry requirements.'
        }
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a
          href={withTrailingSlash(`/${lang}/oem-odm-manufacturer`)}
          class="px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition"
          >{t('solutionsByIndustry.ctaBtn') || 'OEM/ODM Services'}</a
        >
        <a
          href={withTrailingSlash(`/${lang}/contact`)}
          class="px-8 py-4 border border-gray-200 text-gray-700 rounded-full font-semibold hover:border-gray-400 transition"
          >{t('solutionsByIndustry.contactBtn') || 'Contact Us'}</a
        >
      </div>
    </section>
  </section>

  <ExperienceLayer
    title={t('solutionsByIndustry.expTitle') || 'Industry Solutions in Action'}
    subtitle={t('solutionsByIndustry.expSub') ||
      'Real examples of how afarer SUPs perform across different industry sectors.'}
    stories={[
      {
        quote:
          'Our rental boards go out four times a day in peak season. After two summers, the fusion-welded seams still look new.',
        narrative:
          'A beachfront rental operation in Thailand runs a 40-board afarer fleet. The boards are launched and recovered up to four times daily, exposed to intense tropical sun and saltwater. After 1000+ inflation cycles, the boards show no significant UV degradation and no seam separation.',
        context: 'SUP rental fleet, Thailand, 2023-2025',
        source: 'Rental Operation Owner',
      },
      {
        quote:
          'The mixed-size fleet lets us teach beginners and train racers with the same supplier. Bulk pricing made the club program viable.',
        narrative:
          'A paddle club in Europe outfitted its school and race teams with afarer boards — stable 11-foot platforms for first-timers and lightweight touring boards for advanced members. Custom club branding on every board, with a replacement program that keeps the fleet on the water year-round.',
        context: 'Paddle club fleet program, Europe, 2024',
        source: 'Club Program Director',
      },
    ]}
  />
  <RelatedPages
    title={t('solutionsByIndustry.relatedTitle') || 'Explore More'}
    subtitle={t('solutionsByIndustry.relatedSub') || 'Related solutions and resources'}
    links={[
      {
        title: t('solutionsByIndustry.rel1') || 'Solutions by Use Case',
        description: t('solutionsByIndustry.rel1desc') || 'Match your specific use case to the right afarer solution.',
        href: withTrailingSlash(`/${lang}/solutions/by-use-case`),
        label: t('solutionsByIndustry.rel1label') || 'Decision Tool',
      },
      {
        title: 'SUP Products',
        description: 'Full lineup of CE-certified inflatable SUPs and accessories.',
        href: withTrailingSlash(`/${lang}/products`),
        label: 'Products',
      },
      {
        title: t('solutionsByIndustry.rel3') || 'OEM/ODM Manufacturing',
        description:
          t('solutionsByIndustry.rel3desc') || 'Custom manufacturing services for global brands and organizations.',
        href: withTrailingSlash(`/${lang}/oem-odm-manufacturer`),
        label: t('solutionsByIndustry.rel3label') || 'OEM',
      },
      {
        title: t('solutionsByIndustry.rel4') || 'Engineering Perfection',
        description:
          t('solutionsByIndustry.rel4desc') ||
          'Our engineering philosophy — precision manufacturing and rigorous quality control.',
        href: withTrailingSlash(`/${lang}/engineering-perfection`),
        label: t('solutionsByIndustry.rel4label') || 'Philosophy',
      },
    ]}
  />

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Solutions by industry for afarer inflatable SUPs. Six industry verticals: Resorts & Hotels (rental-grade SUPs,
      custom-branded fleets, kids and family SUPs), Rental Operators (rental-grade all-around SUPs, touring SUPs,
      accessories), Paddle Clubs & SUP Schools (beginner-friendly SUPs, stable teaching platforms, race and touring
      boards), Marine Tourism & Adventure Operators (all-around SUPs, giant multi-rider SUPs, touring SUPs), Retail
      Brands & Distributors (private-label SUP lines, wholesale fleet supply, retail-ready packaging), Fishing & Outdoor
      (fishing SUPs, gear-mount configurations, kayak-SUP hybrids). All solutions CE certified and ISO manufactured.
      OEM/ODM custom design available for all industries.
    </p>
  </section>
</Layout>
