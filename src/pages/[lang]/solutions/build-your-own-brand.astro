---
/* eslint-disable @typescript-eslint/no-explicit-any */
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Icon from '~/components/ui/Icon.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/solutions-build-your-own-brand.ts';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'solutions-build-your-own-brand');

const hero = page.hero ?? {};
const process = page.process ?? {};
const packages = page.packages ?? {};
const features = page.features ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const pageMeta = page.meta ?? {};
const cleanMeta = (s: string) =>
  (s || '')
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
const metadata = {
  title: cleanMeta(pageMeta.title || hero.title || `Private Label SUP Manufacturing — ${SITE.name}`).replace(
    '{SITE}',
    SITE.name
  ),
  description: cleanMeta(pageMeta.description || hero.subtitle),
};
const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('nav.solutions') || 'Solutions', href: `/${lang}/solutions/` },
  { name: 'Build Your Own Brand' },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />

  <WidgetWrapper containerClass="max-w-5xl mx-auto">
    <Headline title={process.title} subtitle={process.subtitle} />
    <div class="mt-10 space-y-8">
      {
        process.steps?.map((step: any) => (
          <div class="flex flex-col md:flex-row gap-4 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="md:w-48 shrink-0">
              <p class="text-xs font-semibold uppercase tracking-widest text-primary">{step.phase}</p>
              <p class="text-lg font-bold">{step.title}</p>
              <p class="text-sm text-muted">{step.period}</p>
            </div>
            <ul class="space-y-2">
              {step.items?.map((item: string) => (
                <li class="flex items-start space-x-3">
                  <Icon name="tabler:chevron-right" class="w-5 h-5 text-primary mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-6xl mx-auto">
    <Headline title={packages.title} subtitle={packages.subtitle} />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
      {
        packages.items?.map((pkg: any) => (
          <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow px-6 py-8 flex flex-col text-center">
            <p class="text-xs font-semibold uppercase tracking-widest text-primary">{pkg.tagline}</p>
            <h3 class="text-xl font-semibold mt-2">{pkg.name}</h3>
            <ul class="mt-6 space-y-2 text-left flex-1">
              {pkg.features?.map((f: string) => (
                <li class="flex items-start space-x-3">
                  <Icon name="tabler:check" class="w-5 h-5 text-primary mt-0.5 shrink-0" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <Features title={features.title} subtitle={features.subtitle} items={features.items} columns={3} />

  <!-- Related Products -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="text-center mb-8">
      <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase"
        >{t('product.related') || 'Featured Products'}</span
      >
      <h2 class="mt-2 text-2xl font-bold text-gray-900 dark:text-slate-100">OEM-Ready Products</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a
        href={lh('/products/sup-explorer-11')}
        class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
      >
        <h3
          class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400"
        >
          SUP Explorer 11
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Customizable white-label SUP for your brand.</p>
        <span class="mt-3 inline-block text-sm font-medium text-sky-600">{t('product.view') || 'View Product'} →</span>
      </a>
      <a
        href={lh('/products/sup-ocean-voyager')}
        class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
      >
        <h3
          class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400"
        >
          SUP Ocean Voyager
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Premium touring SUP available for private label.</p>
        <span class="mt-3 inline-block text-sm font-medium text-sky-600">{t('product.view') || 'View Product'} →</span>
      </a>
      <a
        href={lh('/products/life-vest-classic')}
        class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
      >
        <h3
          class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400"
        >
          Life Vest Classic
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Custom-branded safety equipment option.</p>
        <span class="mt-3 inline-block text-sm font-medium text-sky-600">{t('product.view') || 'View Product'} →</span>
      </a>
    </div>
  </section>

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
  <JsonLd
    type="Service"
    service={{
      name: cleanMeta(pageMeta.title || hero.title || 'Private Label SUP Manufacturing').replace('{SITE}', SITE.name),
      description:
        hero.subtitle || 'End-to-end OEM/ODM SUP manufacturing — design, prototyping, production, and logistics',
      serviceType: 'OEM/ODM Manufacturing',
      areaServed: ['Global'],
      url: `/${lang}/solutions/build-your-own-brand`,
      items: [
        { name: 'Design & Prototyping', description: 'Custom mold creation and rapid prototyping' },
        { name: 'Mass Production', description: 'CE-certified manufacturing with quality control' },
        { name: 'Global Logistics', description: 'FOB shipping and customs documentation support' },
      ],
    }}
  />
</Layout>
