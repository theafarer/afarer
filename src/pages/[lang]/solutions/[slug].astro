---
/* eslint-disable @typescript-eslint/no-explicit-any */
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Icon from '~/components/ui/Icon.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getSolutionBySlug, getAllSlugs } from '~/data/biz-solutions';

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; slug: string } }> = [];
  for (const lang of Object.keys(languages)) {
    for (const slug of getAllSlugs()) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params;
const page = getSolutionBySlug(slug || '');

if (!page) {
  return Astro.redirect(`/${lang}/solutions/`);
}

const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);

const hero = page.hero;
const challenge = page.challenge;
const solutionsData = page.solutions;
const cs =
  typeof page.caseStudy.customer === 'string'
    ? {
        title: fr('Case Study', 'Étude de cas'),
        customer: { location: undefined, background: page.caseStudy.customer, goal: undefined } as {
          location?: string;
          background?: string;
          goal?: string;
        },
        steps: (page.caseStudy.steps || []).map((s: any) => (typeof s === 'string' ? { title: '', detail: s } : s)),
        results: page.caseStudy.results,
      }
    : page.caseStudy;
const why = page.whyAfarer;
const faqs = page.faqs;
const cta = page.cta;

const allCases = [cs, ...(page.caseStudy.moreCaseStudies || [])];

const lh = (h: string) => `/${lang}${h}`;

const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('nav.solutions') || 'Solutions', href: `/${lang}/solutions/` },
  { name: page.clientType },
];

const metadata = {
  title: page.meta.title.replace('{SITE}', SITE.name),
  description: page.meta.description,
};

const ctaActions = [
  { ...cta.primaryAction, href: lh(cta.primaryAction.href) },
  ...(cta.secondaryAction ? [{ ...cta.secondaryAction, href: lh(cta.secondaryAction.href) }] : []),
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} title={hero.title} subtitle={hero.subtitle} image={hero.image} />

  <WidgetWrapper containerClass="max-w-6xl mx-auto">
    <Headline
      title={challenge.title}
      subtitle="Four challenges your business faces — and how Afarer solves each one."
    />
    <div class="grid md:grid-cols-2 gap-6 mt-10">
      {
        challenge.problems.map((p) => (
          <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100 mb-2">{p.title}</h3>
            <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{p.description}</p>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-5xl mx-auto">
    <Headline title={solutionsData.title} subtitle="Proven manufacturing solutions designed for your business." />
    <div class="mt-10 space-y-8">
      {
        solutionsData.items.map((s, i) => (
          <div class="flex flex-col md:flex-row gap-4 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="md:w-16 shrink-0 flex items-start">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-sky-100 dark:bg-sky-900 text-sky-600 dark:text-sky-300 font-bold text-sm">
                {i + 1}
              </span>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">{s.title}</h3>
              <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{s.description}</p>
              {s.features && s.features.length > 0 && (
                <ul class="mt-3 space-y-1">
                  {s.features.map((f) => (
                    <li class="flex items-start space-x-2 text-sm text-gray-500 dark:text-slate-400">
                      <Icon name="tabler:check" class="w-4 h-4 text-green-500 mt-0.5 shrink-0" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-5xl mx-auto">
    <Headline title="Case Studies" subtitle="Real results from real partnerships." />
    <div class="mt-10 space-y-8">
      {
        allCases.map((c, idx) => (
          <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-6 md:p-8 shadow-sm">
            <div class="flex items-center gap-2 mb-4">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-sky-100 dark:bg-sky-900 text-sky-600 dark:text-sky-300 font-bold text-sm">
                {idx + 1}
              </span>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">{c.title}</h3>
            </div>
            {c.customer && typeof c.customer === 'object' && 'location' in c.customer && (
              <div class="grid md:grid-cols-3 gap-4 mb-6 pb-6 border-b border-gray-100 dark:border-gray-700">
                {c.customer.location && (
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{fr('Location', 'Lieu')}</p>
                    <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-1">{c.customer.location}</p>
                  </div>
                )}
                {c.customer.background && (
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                      {fr('Background', 'Contexte')}
                    </p>
                    <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-1">{c.customer.background}</p>
                  </div>
                )}
                {c.customer.goal && (
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">{fr('Goal', 'Objectif')}</p>
                    <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-1">{c.customer.goal}</p>
                  </div>
                )}
              </div>
            )}
            {c.steps && c.steps.length > 0 && (
              <div class="space-y-4 mb-6">
                {c.steps.map((step: any) => (
                  <div class="flex gap-3">
                    <Icon name="tabler:arrow-right-circle" class="w-5 h-5 text-sky-500 mt-0.5 shrink-0" />
                    <div>
                      <p class="text-sm font-semibold text-gray-900 dark:text-slate-100">{step.title}</p>
                      <p class="text-sm text-gray-500 dark:text-slate-400">{step.detail}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">
                {fr('Results', 'Résultats')}
              </p>
              <div class="flex flex-wrap gap-2">
                {c.results.map((r) => (
                  <span class="inline-flex items-center gap-1.5 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium px-3 py-1.5 rounded-full">
                    <Icon name="tabler:check" class="w-3.5 h-3.5" />
                    {r}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <Features title={why.title} subtitle="Trusted by brands worldwide for a decade." items={why.items} columns={3} />

  {
    faqs.length > 0 && (
      <FAQs
        title="Frequently Asked Questions"
        subtitle="Common questions about this solution."
        items={faqs.map((f) => ({ title: f.question, description: f.answer }))}
        columns={1}
      />
    )
  }

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />

  <JsonLd
    type="Service"
    service={{
      name: page.brandName || page.meta.title,
      description: page.meta.description,
      serviceType: 'OEM/ODM Manufacturing',
      areaServed: ['Global'],
      url: `/${lang}/solutions/${page.slug}`,
      items: solutionsData.items.map((s) => ({ name: s.title, description: s.description })),
    }}
  />

  <JsonLd type="FAQPage" faqs={faqs} />
</Layout>
