---
/* eslint-disable @typescript-eslint/no-explicit-any */
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Icon from '~/components/ui/Icon.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/solutions-distributors.ts';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);
setPageContentData(__pageData);
const page = getPageContent(lang, 'solutions-distributors');

const hero = page.hero ?? {};
const benefits = page.benefits ?? {};
const coverage = page.coverage ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h && !h.startsWith('/resources') ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const pageMeta = page.meta ?? {};
const cleanMeta = (s: string) =>
  (s || '')
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
const metadata = {
  title: cleanMeta(pageMeta.title || hero.title || `SUP Distribution Partner Program — ${SITE.name}`).replace(
    '{SITE}',
    SITE.name
  ),
  description: cleanMeta(pageMeta.description || hero.subtitle),
};
const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('nav.solutions') || 'Solutions', href: `/${lang}/solutions/` },
  { name: t('nav.solutionsDistributors') },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />

  <WidgetWrapper containerClass="max-w-5xl mx-auto">
    <Headline title={benefits.title} subtitle={benefits.subtitle} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
      {
        benefits.items?.map((item: string) => (
          <div class="flex items-start space-x-3 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
            <Icon name="tabler:star" class="w-5 h-5 text-primary mt-0.5 shrink-0" />
            <span>{item}</span>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-5xl mx-auto" isDark>
    <Headline title={coverage.title} subtitle={coverage.subtitle} />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {
        coverage.regions?.map((region: any) => (
          <div class="p-6 rounded-lg border border-gray-600">
            <h3 class="text-lg font-bold">{region.name}</h3>
            <p class="text-sm mt-2 text-white/70">{region.countries}</p>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <!-- Related Products -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="text-center mb-8">
      <span class="text-sm font-semibold text-sky-600 tracking-[0.15em] uppercase"
        >{t('product.related') || 'Featured Products'}</span
      >
      <h2 class="mt-2 text-2xl font-bold text-gray-900 dark:text-slate-100">
        {fr('Portfolio Products', 'Produits du portefeuille')}
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a
        href={lh('/products/sup-explorer-11')}
        class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
      >
        <h3
          class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400"
        >
          SUP Explorer 11
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
          {fr('Best-selling inflatable SUP for all markets.', 'SUP gonflable best-seller pour tous les marchés.')}
        </p>
        <span class="mt-3 inline-block text-sm font-medium text-sky-600">{t('product.view') || 'View Product'} →</span>
      </a>
      <a
        href={lh('/products/sup-ocean-voyager')}
        class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
      >
        <h3
          class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400"
        >
          SUP Ocean Voyager
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
          {fr('Premium touring SUP for advanced customers.', 'SUP de touring premium pour les clients avancés.')}
        </p>
        <span class="mt-3 inline-block text-sm font-medium text-sky-600">{t('product.view') || 'View Product'} →</span>
      </a>
      <a
        href={lh('/products/life-vest-pro')}
        class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
      >
        <h3
          class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400"
        >
          Life Vest Pro
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
          {fr('Professional SOLAS-compliant life vest.', 'Gilet de sauvetage professionnel conforme SOLAS.')}
        </p>
        <span class="mt-3 inline-block text-sm font-medium text-sky-600">{t('product.view') || 'View Product'} →</span>
      </a>
    </div>
  </section>

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
  <JsonLd
    type="Service"
    service={{
      name: cleanMeta(pageMeta.title || hero.title || 'SUP Distribution Partner Program').replace('{SITE}', SITE.name),
      description: hero.subtitle || 'Exclusive territories, complete product portfolio, dedicated account management',
      serviceType: 'Distribution Partner Solutions',
      areaServed: ['Global'],
      url: `/${lang}/solutions/distributors`,
      items: [
        { name: 'Exclusive Territories', description: 'Protected regional distribution rights' },
        { name: 'Complete Portfolio', description: 'Full SUP product line with priority access to new releases' },
        { name: 'Account Management', description: 'Dedicated support with marketing and logistics coordination' },
      ],
    }}
  />
</Layout>
