---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Timeline from '~/components/blog/Timeline.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import NewsletterSignup from '~/components/widgets/NewsletterSignup.astro';

import { languages } from '~/i18n/config';
import { fetchPosts, blogPostsPerPage, blogListRobots } from '~/utils/blog';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/news.ts';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang || 'en';
setPageContentData(__pageData);
const page = getPageContent(lang, 'news');
const newsHeader = page?.hero_text ?? {};
const pageTitle = newsHeader.title || 'News';
const pageSubtitle = newsHeader.subtitle || '';

const posts = await fetchPosts();
const pageSize = blogPostsPerPage;
const totalPages = Math.ceil(posts.length / pageSize);
const currentPage = 1;
const pagePosts = posts.slice(0, pageSize);

const featured = posts[0] || null;

const categories = [
  { id: '', label: 'All' },
  { id: 'Technology', label: 'Technology' },
  { id: 'Manufacturing', label: 'Manufacturing' },
  { id: 'Industry Insights', label: 'Industry Insights' },
  { id: 'Corporation News', label: 'Company News' },
];

const prevUrl = undefined;
const nextUrl = currentPage < totalPages ? `/${lang}/news/page/${currentPage + 1}/` : undefined;

const metadata = {
  title: `${pageTitle} | Inflatable SUP Industry Insights for B2B Partners`,
  description:
    'B2B insights on inflatable SUP manufacturing, OEM/ODM partnerships, commercial fleet ROI, drop-stitch technology, and water sports industry trends.',
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: { type: 'blog' },
};
---

<Layout metadata={metadata} breadcrumbs={[{ name: 'Home', href: `/${lang}/` }, { name: 'News' }]}>
  <JsonLd
    type="ItemList"
    data={{
      name: pageTitle || 'News',
      description: pageSubtitle || 'Industry insights and updates',
      url: `https://afarer.com/${lang}/news`,
      numberOfItems: posts.length,
      itemListElement: posts.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://afarer.com/${lang}/news/${p.slug}`,
      })),
    }}
  />
  <section class="max-w-6xl mx-auto px-6 py-16">
    <Headline subtitle={pageSubtitle}>{pageTitle}</Headline>

    <!-- Featured Post -->
    {
      featured && (
        <a
          href={`/${lang}/news/${featured.slug}`}
          class="mt-12 block bg-gradient-to-br from-gray-50 to-white dark:from-slate-800 dark:to-slate-900 rounded-3xl border border-gray-200 dark:border-slate-700 overflow-hidden hover:shadow-xl transition-all group"
        >
          <div class="grid md:grid-cols-2">
            {featured.image && (
              <div class="h-64 md:h-full overflow-hidden">
                <img
                  src={featured.image}
                  alt={featured.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="eager"
                />
              </div>
            )}
            <div class="p-8 md:p-12 flex flex-col justify-center">
              {featured.category && (
                <span class="text-xs font-semibold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full self-start mb-4">
                  {featured.category}
                </span>
              )}
              <h2 class="text-2xl md:text-3xl font-bold text-foreground group-hover:text-primary transition-colors">
                {featured.title}
              </h2>
              <p class="mt-3 text-muted leading-relaxed">{featured.excerpt}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary">
                {pageTitle === 'News' ? 'Read article' : 'Read article'} →
              </span>
            </div>
          </div>
        </a>
      )
    }

    <!-- Category Tabs -->
    <div class="mt-16 flex flex-wrap gap-2 border-b border-gray-200 dark:border-slate-700 pb-4">
      {
        categories.map((cat) => (
          <a
            href={cat.id ? `/${lang}/news/category/${cat.id}` : `/${lang}/news`}
            class={`px-4 py-2 text-sm font-medium rounded-full transition-colors ${!cat.id ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-slate-800 text-muted hover:bg-gray-200 dark:hover:bg-slate-700'}`}
          >
            {cat.label}
          </a>
        ))
      }
    </div>

    <!-- Resource CTA Banner -->
    <div
      class="mt-10 bg-gradient-to-r from-primary/10 to-secondary/5 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4 border border-primary/20"
    >
      <div>
        <h3 class="text-lg font-bold text-foreground">OEM/ODM Manufacturing Guide</h3>
        <p class="text-sm text-muted mt-1">Download our complete guide to launching your private label SUP brand.</p>
      </div>
      <a
        href={`/${lang}/resources/oem-guide`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full transition-all whitespace-nowrap shrink-0"
      >
        Download Free Guide →
      </a>
    </div>

    <!-- Posts -->
    <div class="mt-12">
      <Timeline posts={pagePosts} />
    </div>

    <div class="mt-16 text-center">
      <Pagination prevUrl={prevUrl} nextUrl={nextUrl} />
    </div>

    <NewsletterSignup
      title="Stay Ahead in the SUP Industry"
      subtitle="Get OEM insights, manufacturing guides, and industry trends delivered monthly."
    />
  </section>
</Layout>
