---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/factory-oem-capability.ts';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);
setPageContentData(__pageData);
const page = getPageContent(lang, 'factory-oem-capability');

const hero = page.hero ?? {};
const intro = page.intro ?? '';
const highlights = page.highlight ?? [];
const services = page.services ?? [];
const moqTable = page.moq_table ?? [];

const crumbs = [
  { name: 'Home', href: `/${lang}/` },
  { name: 'Factory', href: `/${lang}/factory` },
  { name: hero.title },
];

const metadata = {
  title: `${hero.title} — ${SITE.name}`,
  description: intro?.slice(0, 160) || `${SITE.name} OEM and private label manufacturing services.`,
};
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta
    name="ai-intent"
    content="oem-inflatable-boat-manufacturer,rib-boat-oem,private-label-sup,white-label-inflatable-boats,custom-boat-manufacturing-china"
  />
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <a href={`/${lang}/factory`} class="text-sm text-gray-500 hover:underline"
      >&larr; {fr('Back to Factory', "Retour à l'usine")}</a
    >
    <p class="mt-4 text-sm font-semibold text-primary uppercase tracking-wider">{hero.tagline}</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">{hero.title}</h1>
    <p class="mt-3 text-lg text-muted">{hero.subtitle}</p>
  </section>

  {
    intro && (
      <section class="px-6 sm:px-6 pb-16 mx-auto max-w-4xl">
        <p class="text-muted leading-relaxed">{intro}</p>
      </section>
    )
  }

  {
    highlights.length > 0 && (
      <section class="px-6 sm:px-6 pb-8 mx-auto max-w-6xl">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
          {highlights.map((s: any) => (
            <div class="text-center p-6 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
              <span class="block text-3xl font-bold text-primary">{s.value}</span>
              <span class="block text-sm text-muted mt-1">{s.label}</span>
              <span class="block text-xs text-muted mt-1">{s.detail}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    services.length > 0 && (
      <section class="px-6 sm:px-6 py-16 mx-auto max-w-6xl">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold text-primary uppercase tracking-wider">
            {t('factory.oemServices') || 'OEM Services'}
          </p>
          <h2 class="mt-2 text-3xl font-bold">{t('factory.whatWeOffer') || 'What We Offer'}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {services.map((s: any) => (
            <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
              <h3 class="text-lg font-bold">{s.title}</h3>
              <p class="mt-3 text-sm text-muted leading-relaxed">{s.description}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    moqTable.length > 0 && (
      <section class="px-6 sm:px-6 py-16 mx-auto max-w-5xl bg-gray-50 dark:bg-gray-900 rounded-2xl">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold text-primary uppercase tracking-wider">
            {t('factory.moqLeadTime') || 'MOQ & Lead Time'}
          </p>
          <h2 class="mt-2 text-3xl font-bold">{t('factory.minOrderQty') || 'Minimum Order Quantities'}</h2>
        </div>
        <div class="overflow-x-auto max-w-4xl mx-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-300 dark:border-gray-700">
                <th class="text-left py-3 px-4 font-semibold">{t('factory.product') || 'Product'}</th>
                <th class="text-left py-3 px-4 font-semibold">{t('factory.standardMoq') || 'Standard MOQ'}</th>
                <th class="text-left py-3 px-4 font-semibold">{t('factory.customMoq') || 'Custom MOQ'}</th>
                <th class="text-left py-3 px-4 font-semibold">{t('factory.leadTime') || 'Lead Time'}</th>
              </tr>
            </thead>
            <tbody>
              {moqTable.map((row: any) => (
                <tr class="border-b border-gray-200 dark:border-gray-800">
                  <td class="py-3 px-4 font-medium">{row.product}</td>
                  <td class="py-3 px-4 text-muted">{row.standard_moq || row.standard}</td>
                  <td class="py-3 px-4 text-muted">{row.custom_moq || row.custom}</td>
                  <td class="py-3 px-4 text-muted">{row.lead_time || row.lead}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">{t('factory.startOem') || 'Start your OEM project'}</h2>
      <p class="mt-2 text-sm text-muted">
        {
          t('factory.startOemDesc') ||
            'Tell us about your requirements and we will provide a detailed proposal within 48 hours.'
        }
      </p>
      <a
        href={`/${lang}/contact`}
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
        >{t('factory.getQuote') || 'Get a quote'} →</a
      >
    </div>
  </section>
</Layout>
