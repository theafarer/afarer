---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/factory-capacity.ts';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'factory-capacity');

const hero = page.hero ?? {};
const intro = page.intro ?? '';
const highlights = page.highlights ?? [];
const workshops = page.workshops ?? [];
const crumbs = [
  { name: t('nav.home'), href: `/${lang}/` },
  { name: t('nav.factory'), href: `/${lang}/factory` },
  { name: hero.title },
];

const metadata = {
  title: `${hero.title} — ${SITE.name}`,
  description: intro?.slice(0, 160) || `${SITE.name} factory capacity and production output.`,
};
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta name="ai-intent" content="inflatable-boat-factory-capacity,rib-boat-manufacturer-china,oem-boat-production" />
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <a href={`/${lang}/factory`} class="text-sm text-gray-500 hover:underline">&larr; {hero.tagline}</a>
    <p class="mt-4 text-sm font-semibold text-primary uppercase tracking-wider">{SITE.name}</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">{hero.title}</h1>
    <p class="mt-3 text-lg text-muted">{hero.subtitle}</p>
  </section>

  {
    intro && (
      <section class="px-6 sm:px-6 pb-16 mx-auto max-w-4xl">
        <p class="text-muted leading-relaxed">{intro}</p>
      </section>
    )
  }

  {
    highlights.length > 0 && (
      <section class="px-6 sm:px-6 pb-8 mx-auto max-w-6xl">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
          {highlights.map((s) => (
            <div class="text-center p-6 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
              <span class="block text-3xl font-bold text-primary">{s.value}</span>
              <span class="block text-sm text-muted mt-1">{s.label}</span>
              <span class="block text-xs text-muted mt-1">{s.detail}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    workshops.length > 0 && (
      <section class="px-6 sm:px-6 py-16 mx-auto max-w-6xl">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold text-primary uppercase tracking-wider">
            {t('factory.byProductLine') || 'By Product Line'}
          </p>
          <h2 class="mt-2 text-3xl font-bold">
            {t('factory.capacityByCategory') || 'Production Capacity by Category'}
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {workshops.map((w) => (
            <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-bold">{w.title}</h3>
                {w.output && <span class="text-sm font-semibold text-primary">{w.output}</span>}
              </div>
              <p class="text-sm text-muted leading-relaxed">{w.description}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">{t('factory.interestedCapacity') || 'Interested in our production capacity?'}</h2>
      <p class="mt-2 text-sm text-muted">
        {
          t('factory.interestedCapacityDesc') ||
            'Contact our sales team for current lead times and available production slots.'
        }
      </p>
      <a
        href={`/${lang}/contact`}
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
        >{t('factory.contactSales') || 'Contact sales'} →</a
      >
    </div>
  </section>
</Layout>
