---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import JsonLd from '~/components/common/JsonLd.astro';
import Tldr from '~/components/common/Tldr.astro';
import { faqs } from '~/data/faq';
import { guides } from '~/data/guides';
import { products } from '~/data/products';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
const metadata = {
  title: `FAQ — ${SITE.name}`,
  description:
    t('faq.metaDesc') || 'Frequently asked questions about inflatable SUP boards, safety equipment, and water sports.',
};

const categories = [...new Set(faqs.map((f) => f.category))];
---

<Layout metadata={metadata}>
  <meta name="ai-intent" content="faq,water-sports-questions,sup-buying-faq" />

  <section class="max-w-3xl mx-auto py-24 px-6" data-ai-block="faq">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('faq.pageLabel')}</span>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">{t('faq.title')}</h1>
    <p class="mt-4 text-lg text-gray-500">{t('faq.pageDesc')}</p>

    <div class="mt-8 relative">
      <input type="text" data-faq-search placeholder={t('faq.searchPlaceholder') || 'Search FAQ...'} class="w-full px-5 py-3 pl-12 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none transition-all" />
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>

    <Tldr summary={t('home.tldr.summary')} className="mt-8" />
  </section>

  {
    categories.map((cat) => (
      <section class="max-w-3xl mx-auto pb-16 px-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6" data-faq-category={cat}>{t('faq.category.' + cat) || cat}</h2>
        <div class="space-y-4">
          {faqs
            .filter((f) => f.category === cat)
            .map((item) => (
              <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group" data-faq-item data-faq-question={item.question.toLowerCase()} data-faq-answer={item.answer.toLowerCase()}>
                <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
                  <span>{item.question}</span>
                  <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
                </summary>
                <div class="px-6 pb-4 space-y-3">
                  <p class="text-gray-600 leading-relaxed">{item.answer}</p>
                  {(item.relatedProducts.length > 0 || item.relatedGuides.length > 0) && (
                    <div class="flex flex-wrap gap-2 text-sm pt-2">
                      {item.relatedProducts.map((pid) => {
                        const p = products.find((pp) => pp.id === pid);
                        return p ? (
                          <a
                            href={`/${lang}/products/${pid}`}
                            class="px-3 py-1 bg-amber-50 text-amber-700 rounded-full hover:bg-amber-100 transition-colors"
                          >
                            {p.name} →
                          </a>
                        ) : null;
                      })}
                      {item.relatedGuides.map((slug) => {
                        const g = guides.find((gg) => gg.slug === slug);
                        return g ? (
                          <a
                            href={`/${lang}/guides/${slug}`}
                            class="px-3 py-1 bg-sky-50 text-sky-700 rounded-full hover:bg-sky-100 transition-colors"
                          >
                            {g.title}
                          </a>
                        ) : null;
                      })}
                    </div>
                  )}
                </div>
              </details>
            ))}
        </div>
      </section>
    ))
  }

  <JsonLd type="FAQPage" faqs={faqs.map((f) => ({ q: f.question, a: f.answer }))} />
  <script is:inline>
    (function () {
      const input = document.querySelector('[data-faq-search]');
      if (!input) return;
      input.addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        document.querySelectorAll('[data-faq-item]').forEach(function (item) {
          const question = (item.getAttribute('data-faq-question') || '');
          const answer = (item.getAttribute('data-faq-answer') || '');
          const match = !q || question.includes(q) || answer.includes(q);
          item.style.display = match ? '' : 'none';
        });
        document.querySelectorAll('[data-faq-category]').forEach(function (h2) {
          const section = h2.closest('section');
          const visible = section ? Array.from(section.querySelectorAll('[data-faq-item]')).some(function (el) { return el.style.display !== 'none'; }) : true;
          if (section) section.style.display = visible ? '' : 'none';
        });
      });
    })();
  </script>
</Layout>
