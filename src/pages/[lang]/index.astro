---
/* eslint-disable @typescript-eslint/no-explicit-any */
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { products } from '~/data/products';
import { localizeProduct } from '~/utils/product-i18n';

import JsonLd from '~/components/common/JsonLd.astro';
import TestimonialCarousel from '~/components/widgets/TestimonialCarousel.astro';
import cfg from '~/config.yaml';
const branding = (cfg as any)?.branding || {};
import { languages as langMap, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/home.ts';
import productVisualsData from '~/data/site/product-visuals.yaml';
import { pageContentData } from '~/i18n/generated/data';

export async function getStaticPaths() {
  return Object.keys(langMap).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
setPageContentData(__pageData);
const page = getPageContent(lang);

const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const contentFor = (key: string) =>
  (pageContentData as any)?.[`${lang}/${key}`] || (pageContentData as any)?.[`en/${key}`] || {};

const useCasesData = contentFor('site-use-cases');
const techCardsData = contentFor('site-tech-cards');
const testimonialsData = contentFor('site-testimonials');
const learnData = contentFor('site-learning-center');

const distributorDefault = {
  tagline: 'Country Exclusive Distributors',
  title: 'One Country. One Official Afarer Distributor.',
  subtitle:
    'A one-country-one-distributor program with territory exclusivity, dealer pricing, marketing support, and a dedicated Distributor Success Program.',
  benefits: [
    {
      title: 'Territory Exclusivity',
      description: 'One authorized distributor per country or region — no internal competition, no channel conflict.',
    },
    {
      title: 'Direct-Factory Margins',
      description: 'Distributor price lists and annual rebates on committed volumes, shipped FOB Qingdao.',
    },
    {
      title: 'Marketing & Training Support',
      description: 'Co-branded assets, dealer POS materials, product training, and launch campaigns.',
    },
    {
      title: 'Dedicated Account Team',
      description: 'A personal distributor manager plus onboarding, forecasting, and reorder support.',
    },
  ],
  actions: [
    { variant: 'primary', text: 'Become a Distributor', href: '/distributor-program' },
    { text: 'Request Dealer Price List', href: '/contact?subject=Dealer Price List' },
    { text: 'Apply for Country Partnership', href: '/contact?subject=Country Partnership Application' },
    { text: 'Download Distributor Program', href: '/distributor-program' },
  ],
  note: 'Sample orders from 5–10 units. Trial orders 10–30. Authorized Dealer 30–50. Country/Regional Distributor 100–300+.',
};
const distributor = { ...distributorDefault, ...(page.distributor || {}) };

const metadata = {
  title: lang === defaultLang ? 'Performance Inflatable SUPs — Go Farther. Ride Stronger. | Afarer' : SITE.name,
  description:
    'Afarer designs performance inflatable paddle boards for open water, touring, yoga, and adventure. Drop-stitch rigidity, pressure-tested board by board, backed by a clear warranty.',
  ignoreTitleTemplate: true,
};

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11': 'https://assets.afarer.com/images/afarer/products/sup-series/sup-jungle-mandala-app-1-1200w.webp',
  'airdeck-360': 'https://assets.afarer.com/images/afarer/products/afarer-inflatable-boat.webp',
  'life-vest-classic': 'https://assets.afarer.com/images/afarer/products/afarer-life-vest-classic.webp',
  'life-vest-pro':
    'https://assets.afarer.com/images/afarer/products/life-jacket-afarer-inflatable-boat-afarer-factory-exterior.webp',
  'oars-pump-set': 'https://assets.afarer.com/images/afarer/products/afarer-electric-pump.webp',
};
const rawVisuals = ((productVisualsData as any)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

const defaultUseCases = [
  {
    title: 'Beginner SUP',
    desc: 'Stable SUP boards for first-time users.',
    scenario: 'A family visiting a lake for the weekend wants to try paddle boarding.',
    solution: 'The SUP Explorer 11 provides wide-body stability. Life Vest Classic ensures CE-certified flotation.',
    products: ['SUP Explorer 11', 'Life Vest Classic', 'Dual-Action Pump'],
    img: 'https://assets.afarer.com/images/afarer/products/sup-series/sup-cheetah-surge-1-1200w.webp',
  },
  {
    title: 'Touring & Exploration',
    desc: 'Long-distance SUP boards for rivers, lakes, and coastal trips.',
    scenario: 'An outdoor enthusiast plans a week-long SUP touring trip.',
    solution: 'The Ocean Voyager touring SUP tracks efficiently and carries enough gear for multi-day expeditions.',
    products: ['Ocean Voyager SUP', 'Carbon Paddle', 'Life Vest Classic'],
    img: 'https://assets.afarer.com/images/afarer/products/sup-series/sup-ocean-voyager-1-1200w.webp',
  },
  {
    title: 'Fitness & Yoga',
    desc: 'Stable platforms for yoga, fitness, and mindful water activities.',
    scenario: 'A yoga instructor wants to offer stand-up paddle yoga classes.',
    solution: 'The Flowing Lotus SUP provides a wide, stable deck perfect for yoga sequences on calm water.',
    products: ['Flowing Lotus SUP', 'Yoga Leash', 'Life Vest Classic'],
    img: 'https://assets.afarer.com/images/afarer/products/sup-series/sup-flowing-lotus-1-1200w.webp',
  },
  {
    title: 'Family Recreation',
    desc: 'Spacious SUPs for day trips, fishing, and family watersports.',
    scenario: 'A family of four wants stable boards for weekend lake outings.',
    solution: 'The Leviathan Wake SUP supports heavy loads with its ultra-stable platform.',
    products: ['Leviathan Wake SUP', 'Life Vest Classic', 'Dual-Action Pump'],
    img: 'https://assets.afarer.com/images/afarer/products/sup-series/sup-leviathan-wake-1-1200w.webp',
  },
];
const rawCases = ((useCasesData as any)?.cases || []) as Array<{
  id: string;
  title: string;
  desc: string;
  scenario: string;
  solution: string;
  products: string[];
  image: string;
}>;
const useCases = rawCases.length
  ? rawCases.map((u) => ({
      title: u.title,
      desc: u.desc,
      scenario: u.scenario,
      solution: u.solution,
      products: u.products,
      img: u.image,
    }))
  : defaultUseCases;

const faqData = page.faqs?.items?.length ? page.faqs : null;
const defaultFaqItems: Array<{ q: string; a: string; category: string }> = [
  {
    q: t('faq.inflatable.lifespan') || 'How long do inflatable boats last?',
    a:
      t('faq.inflatable.lifespan.a') ||
      'PVC inflatable boats last 8–12 years with proper care. Hypalon boats can last 15–20+ years.',
    category: 'inflatable',
  },
  {
    q: t('faq.inflatable.storage') || 'Can I leave my inflatable boat inflated all season?',
    a: t('faq.inflatable.storage.a') || 'Yes, but with precautions. Inflate to the rated pressure and check weekly.',
    category: 'inflatable',
  },
  {
    q: t('faq.inflatable.maintenance') || 'What maintenance do inflatable boats need?',
    a:
      t('faq.inflatable.maintenance.a') ||
      'Rinse with fresh water, dry before storage, check for leaks, lubricate valves yearly.',
    category: 'inflatable',
  },
  {
    q: t('faq.inflatable.repair') || 'Can inflatable boats be repaired?',
    a:
      t('faq.inflatable.repair.a') ||
      'Yes. Small punctures can be repaired with a PVC repair kit. Larger damage may need professional repair.',
    category: 'inflatable',
  },
  {
    q: t('faq.sup.learn') || 'Is SUP hard to learn?',
    a: t('faq.sup.learn.a') || 'Not at all. Most beginners stand up and paddle within their first session.',
    category: 'sup',
  },
  {
    q: t('faq.sup.weight') || 'What is the weight limit?',
    a:
      t('faq.sup.weight.a') ||
      'Rider weight guidance is published on each product page — check board capacity, recommended PSI, and sizing notes to find your fit.',
    category: 'sup',
  },
  {
    q: t('faq.sup.travel') || 'Can I travel with an inflatable SUP?',
    a:
      t('faq.sup.travel.a') ||
      'Absolutely. Every Afarer board packs into a backpack-sized case that meets airline luggage requirements.',
    category: 'sup',
  },
  {
    q: t('faq.sup.box') || 'What comes in the box?',
    a:
      t('faq.sup.box.a') ||
      'Every Afarer SUP includes the board, travel backpack, dual-action pump, fin, leash, and repair kit.',
    category: 'sup',
  },
];
const faqItems = defaultFaqItems;

const faqLd = faqItems.map((f: { q: string; a: string }) => ({ question: f.q, answer: f.a }));
const faqCategories = [
  { id: 'sup', label: t('faq.tab.sup') || 'SUP Boards' },
  { id: 'inflatable', label: t('faq.tab.inflatable') || 'Inflatable Boats' },
];

const catalogCategories = [
  {
    key: 'INFLATABLE',
    label: t('home.catalog.inflatable') || 'Inflatable Boats',
    desc: t('home.catalog.inflatable.desc') || 'Lightweight inflatable boats for recreation and adventure.',
  },
  {
    key: 'SUP',
    label: t('home.catalog.sup') || 'SUP Boards',
    desc: t('home.catalog.sup.desc') || 'Stand-up paddle boards for all-round, touring, yoga, and more.',
  },
  {
    key: 'ACCESSORY',
    label: t('home.catalog.accessory') || 'Accessories',
    desc: t('home.catalog.accessory.desc') || 'Life vests, pumps, paddles, repair kits, and essential gear.',
  },
];
const groupedProducts: Record<string, typeof products> = {};
for (const cat of catalogCategories) {
  groupedProducts[cat.key] = products
    .filter((p) => p.category === cat.key)
    .slice(0, 6)
    .map((p) => localizeProduct(p, lang || defaultLang));
}
const localizedProducts = products.map((p) => localizeProduct(p, lang || defaultLang));
---

<Layout metadata={metadata}>
  <meta
    name="ai-intent"
    content="inflatable-sup-board-brand,performance-inflatable-sup,country-sup-distributor,co-branded-paddle-board,collections,all-around-sup,touring-sup,safety-approved-sup"
  />
  <meta name="last-modified" content="2026-09-18" />
  <meta name="X-Robots-Tag" content="index, follow" />

  <!-- AI Semantic Blocks -->
  <section class="sr-only" data-ai-block="entity" aria-hidden="true">
    <p>
      {
        t('ai.entity') ||
          'Afarer is a performance-led water sports brand creating distinctive inflatable SUPs for people who go farther, ride harder, and see more from the water.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      {
        t('ai.definition') ||
          'Afarer designs and builds inflatable SUPs, accessories, and safety equipment for recreational and performance water sports.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="use-case" aria-hidden="true">
    <p>
      {
        t('ai.useCase') ||
          'Afarer products are used in beginner SUP training, touring, family recreation, and professional water sports.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="comparison" aria-hidden="true">
    <p>
      {
        t('ai.comparison') ||
          'Compared to rigid hard-board SUPs, Afarer inflatable products prioritize portability and impact absorption while maintaining rigidity through drop-stitch core technology.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="constraint" aria-hidden="true">
    <p>
      {
        t('ai.constraint') ||
          'Afarer products are designed for training, recreation, and professional marine operations.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="process" aria-hidden="true">
    <p>
      {
        t('ai.process') ||
          'Afarer boards are built around a high-density drop-stitch core with reinforced rails and fusion-laminated seams. Each board is pressure-tested and visually inspected before packing. Design partnership runs from concept, 3D design, and prototyping to inspected production and global logistics.'
      }
    </p>
  </section>

  <!-- Hero: B2B Premium Solutions -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-secondary">
    <div class="absolute inset-0">
      <img
        src="https://assets.afarer.com/images/afarer/products/sup-series/sup-ocean-voyager-1-1200w.webp"
        alt=""
        class="w-full h-full object-cover opacity-40"
        style="object-position: center 30%;"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/90 via-secondary/60 to-secondary/30"></div>
    </div>
    <div class="absolute top-1/4 -right-1/4 w-[600px] h-[600px] rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute -bottom-1/4 left-1/4 w-[500px] h-[500px] rounded-full bg-primary/5 blur-3xl"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="max-w-3xl">
        <div class="reveal">
          <span
            class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-white/50 mb-6"
          >
            <span class="w-8 h-px bg-primary"></span>
            {page.hero?.tagline || t('hero.since') || 'Performance Inflatable SUP Boards'}
          </span>
          <h1
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.05] text-balance text-white"
            set:html={page.hero?.title || 'Go Farther.<br />Ride Stronger.'}
          />
          <p
            class="mt-6 text-lg md:text-xl text-white/70 max-w-2xl text-pretty leading-relaxed"
            set:html={page.hero?.subtitle ||
              'Performance inflatable SUPs designed for open water, long days, and the freedom to explore — stable when it matters, rigid under pressure.'}
          />
          <div class="mt-10 flex items-center gap-4 flex-wrap">
            {
              (page.hero?.actions || []).map((act: any) =>
                act.variant === 'primary' ? (
                  <a
                    href={
                      (act.href || '/solutions').startsWith('/resources')
                        ? act.href
                        : (act.href || '/solutions').startsWith('/')
                          ? '/' + lang + act.href
                          : act.href
                    }
                    class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-xl hover:shadow-2xl transition-all hover:-translate-y-0.5"
                  >
                    {act.text || 'Start Your Project'}
                    <span class="text-lg">→</span>
                  </a>
                ) : (
                  <a
                    href={
                      (act.href || '/co-brand').startsWith('/resources')
                        ? act.href
                        : (act.href || '/co-brand').startsWith('/')
                          ? '/' + lang + act.href
                          : act.href
                    }
                    class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 text-white/80 font-medium rounded-full hover:bg-white/10 hover:text-white transition-all backdrop-blur-sm"
                  >
                    {act.text || 'Co-Brand & Partnership'}
                  </a>
                )
              )
            }
            {
              !page.hero?.actions?.length && (
                <>
                  <a
                    href={'/' + lang + '/inflatable-sup'}
                    class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-xl hover:shadow-2xl transition-all hover:-translate-y-0.5"
                  >
                    {t('cta.explore') || 'Explore Boards'}
                    <span class="text-lg">→</span>
                  </a>
                  <a
                    href={'/' + lang + '/size-guide'}
                    class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 text-white/80 font-medium rounded-full hover:bg-white/10 hover:text-white transition-all backdrop-blur-sm"
                  >
                    {t('home.preview.title') || 'Find Your Ride'}
                  </a>
                </>
              )
            }
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
      <span class="text-xs font-medium tracking-widest text-white/40 uppercase">{t('hero.scroll') || 'Scroll'}</span>
      <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent"></div>
    </div>
  </section>

  <!-- Distributor Program -->
  <section
    class="relative py-20 md:py-28 px-6 overflow-hidden bg-gradient-to-br from-[#0A2540] via-secondary to-[#003049]"
    id="distributor"
    data-ai-block="distributor"
  >
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full bg-primary/5 blur-3xl"></div>
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto">
        <span
          class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary/80 mb-6"
        >
          <span class="w-8 h-px bg-primary"></span>
          {distributor.tagline}
        </span>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-balance text-white">{distributor.title}</h2>
        <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">{distributor.subtitle}</p>
      </div>
      <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          distributor.benefits.map((b: any) => (
            <div class="bg-white/5 backdrop-blur rounded-2xl p-7 border border-white/10">
              <h3 class="text-lg font-semibold text-white">{b.title}</h3>
              <p class="mt-2 text-sm text-white/60">{b.description}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        {
          distributor.actions.map((act: any) =>
            act.variant === 'primary' ? (
              <a
                href={
                  act.href.startsWith('/resources')
                    ? act.href
                    : act.href.startsWith('/')
                      ? '/' + lang + act.href
                      : act.href
                }
                class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-xl hover:shadow-2xl transition-all hover:-translate-y-0.5"
              >
                {act.text} <span class="text-lg">→</span>
              </a>
            ) : (
              <a
                href={
                  act.href.startsWith('/resources')
                    ? act.href
                    : act.href.startsWith('/')
                      ? '/' + lang + act.href
                      : act.href
                }
                class="inline-flex items-center gap-2 px-8 py-4 border border-white/30 text-white rounded-full font-medium hover:bg-white/10 transition-all"
              >
                {act.text}
              </a>
            )
          )
        }
      </div>
      <p class="mt-8 text-center text-sm text-white/40">{distributor.note}</p>
    </div>
  </section>

  <!-- Who We Serve: 4 Customer Entry Cards -->
  {
    page.who_we_serve?.items?.length ? (
      <section class="relative py-28 md:py-36 px-6 bg-[#F8FAFB]">
        <div class="max-w-6xl mx-auto">
          <div class="text-center max-w-3xl mx-auto mb-16 reveal">
            <span class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-4">
              <span class="w-8 h-px bg-primary" />
              {page.who_we_serve?.tagline || 'Who We Serve'}
            </span>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-balance text-secondary">
              {page.who_we_serve?.title || 'Complete SUP Solutions for Every Water Business'}
            </h2>
            <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
              {page.who_we_serve?.subtitle ||
                'Purpose-built equipment, manufacturing, and business support for four key markets.'}
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {page.who_we_serve.items.map((item: any) => (
              <a
                href={(item.link || '#').startsWith('/') ? '/' + lang + item.link : item.link}
                class="group relative bg-white rounded-3xl p-8 border border-gray-200 hover:border-primary/30 hover:shadow-xl transition-all duration-500 hover:-translate-y-1 flex flex-col"
              >
                <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 text-primary">
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-secondary mb-3">{item.title || ''}</h3>
                <p class="text-sm text-gray-500 leading-relaxed flex-1">{item.description || ''}</p>
                <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:gap-2 transition-all">
                  {item.cta || 'Learn More'} →
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }

  <!-- Business Solutions: Core Capabilities -->
  {
    page.business_solutions?.items?.length ? (
      <section class="relative py-28 md:py-36 px-6 bg-white overflow-hidden">
        <div class="max-w-6xl mx-auto">
          <div class="text-center max-w-3xl mx-auto mb-16 reveal">
            <span class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.25em] uppercase text-primary mb-4">
              <span class="w-8 h-px bg-primary" />
              {page.business_solutions?.tagline || 'How We Help'}
            </span>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-secondary">
              {page.business_solutions?.title || 'Your Partner From Concept To Revenue'}
            </h2>
            <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
              {page.business_solutions?.subtitle ||
                'Four core capabilities that help water businesses launch, operate, and grow.'}
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 reveal">
            {page.business_solutions.items.map((item: any) => (
              <div class="bg-[#F8FAFB] rounded-3xl p-8 group hover:shadow-lg transition-all duration-500 hover:-translate-y-1">
                <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-6 text-primary">
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-secondary">{item.title || ''}</h3>
                <p class="mt-3 text-sm text-gray-500 leading-relaxed">{item.description || ''}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }

  <!-- Section 1: Brand Introduction -->
  <section class="relative py-28 md:py-36 px-6 bg-white overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
