<script is:inline>
  (function () {
    // FAQ filter
    const faqTabs = document.querySelector('[data-faq-tabs]');
    const faqList = document.querySelector('[data-faq-list]');
    if (faqTabs && faqList) {
      const allItems = faqList.querySelectorAll('[data-faq-item]');
      function filterFaq(category) {
        faqTabs.querySelectorAll('[data-faq-tab]').forEach(function (btn) {
          const isActive = btn.getAttribute('data-faq-tab') === category;
          btn.className =
            'px-4 py-2 text-sm font-medium rounded-full border transition ' +
            (isActive
              ? 'bg-gray-900 text-white border-gray-900 dark:bg-white dark:text-gray-900 dark:border-white'
              : 'bg-white text-gray-600 border-gray-300 hover:border-gray-400 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:border-gray-500');
        });
        allItems.forEach(function (item) {
          item.style.display = item.getAttribute('data-category') === category ? '' : 'none';
        });
      }
      faqTabs.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-faq-tab]');
        if (btn) filterFaq(btn.getAttribute('data-faq-tab'));
      });
      filterFaq('sup');
    }

    // AI Ask
    const btn = document.getElementById('ask-btn');
    const input = document.getElementById('q');
    const out = document.getElementById('out');
    if (btn && input && out) {
      btn.addEventListener('click', async function () {
        const q = input.value.trim();
        if (!q) return;
        out.classList.add('hidden');
        out.textContent = 'Thinking...';
        out.classList.remove('hidden');
        try {
          const res = await fetch('/api/ask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: q }),
          });
          const data = await res.json();
          out.textContent = res.ok && data.answer ? data.answer : 'Error: ' + (data.error || 'Request failed');
        } catch (err) {
          out.textContent = 'Error: ' + err.message;
        }
      });
    }
  })();
</script>
