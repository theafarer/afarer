---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';
import { landingI18n as __landing } from '~/i18n/generated/landing/dock-platform';
import ScenarioShowcase from '~/components/widgets/ScenarioShowcase.astro';
import { getSupScenario, type SupScenario } from '~/data/sup-scenarios';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const __lt = __landing[lang || ''] || {};
const sx = (en: string) => __lt[en] || en;

const metadata = {
  title: sx('Inflatable Dock Platform | Floating Swim & Docking Platform | Afarer'),
  description: sx(
    'Afarer inflatable dock platforms — stable floating platforms for swimming, sunbathing, boat docking, and waterfront play. Non-slip decks, stainless D-rings, modular connections. CE certified. OEM/ODM manufacturing available.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/dock-platform/`;
const today = '2026-11-05';
const scenario = getSupScenario('dock') as SupScenario;

const faqItems = [
  {
    question: sx('What is an inflatable dock platform?'),
    answer: sx(
      'An inflatable dock platform is a flat, ultra-stable floating platform that serves as a swim deck, sunbathing lounge, boat-side dock, or launch pad for water sports. Unlike a paddle board, it is designed to stay in place — anchored off a boat, dock, or beach — rather than to be paddled.'
    ),
  },
  {
    question: sx('How much weight can an inflatable dock platform hold?'),
    answer: sx(
      'Depending on size, Afarer dock platforms carry 400–900+ kg — enough for a group of swimmers, loungers with chairs and coolers, or several Jet Ski riders waiting their turn. The drop-stitch core keeps the deck rigid at 8–10 PSI.'
    ),
  },
  {
    question: sx('How do you anchor and secure a floating dock platform?'),
    answer: sx(
      'Each platform has multiple stainless-steel D-rings around the perimeter. Connect them to a boat cleat, dock line, or anchor with standard rope, and use the weighted mesh ramp to give swimmers and pets a stable way to climb back aboard.'
    ),
  },
  {
    question: sx('Can dock platforms be connected together?'),
    answer: sx(
      'Yes — adjacent D-rings let you link two or more platforms into a larger waterfront layout: a swim deck plus a lounge, a Jet Ski port, or a continuous runway between a dock and a boat.'
    ),
  },
  {
    question: sx('Do you manufacture inflatable dock platforms for private label brands?'),
    answer: sx(
      'Yes. Afarer offers OEM/ODM manufacturing for inflatable dock platforms and pet ramps with custom deck colors, sizes, D-ring layouts, and branding. Popular with marine retailers, resort suppliers, and Jet Ski accessory brands. MOQ from 50 units.'
    ),
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: sx('Inflatable Dock Platform — Your Waterfront, Expanded'),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: sx('Home'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: sx('Inflatable SUP Boards'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: sx('Inflatable Dock Platform'), item: pageUrl },
      ],
    }}
  />
  <JsonLd data={faqLd} />

  <!-- Hero -->
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href={localizeHref('/inflatable-sup/', lang || 'en')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >{sx('← SUP Product Center')}</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">{sx('SUP Category')}</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        {sx('Inflatable Dock Platform')}
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        {
          sx(
            'An inflatable dock platform turns any stretch of water into your own waterfront. Stable enough to stand, lounge, and climb on, easy to inflate at 8–10 PSI, and roll-up portable when the season ends. Afarer dock platforms serve as swim decks, boat docks, Jet Ski ports, and waterfront playgrounds — built with non-slip decks and stainless D-rings that last.'
          )
        }
      </p>
    </div>
  </section>

  <ScenarioShowcase
    kicker={sx('On the Water')}
    title={sx('The Dock Platform on the Water')}
    description={sx(scenario.description)}
    instructions={sx(scenario.instructions)}
    photos={scenario.photos}
  />

  <!-- Key Features -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">{sx('Stable. Modular. Built to Stay Put.')}</h2>
        <p class="mt-4 text-lg text-gray-500">{sx("Everything a waterfront platform needs, nothing it doesn't.")}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 3v2.25M12 21v-2.25M3 12h2.25M18.75 12H21M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{sx('Rigid Drop-Stitch Deck')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'A high-pressure drop-stitch core inflates rock-hard at 8–10 PSI, giving swimmers and loungers a steady, non-slip surface that barely flexes underfoot.'
              )
            }
          </p>
        </div>
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-50 to-green-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{sx('Stainless D-Ring Anchoring')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Corrosion-proof D-rings line the perimeter for anchor lines, boat cleats, and platform-to-platform connections — season after season in salt water.'
              )
            }
          </p>
        </div>
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-50 to-amber-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{sx('Climb-Back Ramp')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'A weighted mesh ramp hangs below deck level so swimmers, kids, and dogs can climb out of the water without capsizing the platform.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">{sx('Explore the Waterfront Lineup')}</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href={localizeHref('/inflatable-sup/', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {sx('Inflatable SUP Boards')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {
              sx(
                'The full range of Afarer inflatable boards — from all-around cruisers to touring and fishing machines.'
              )
            }
          </p>
          <span class="inline-block mt-2 text-xs font-medium text-primary">{sx('Explore category →')}</span>
        </a>
        <a
          href={localizeHref('/products/sup-giant', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {sx('Multi-Person Giant SUP')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {sx('Prefer a platform you can paddle? The 16.5-foot giant SUP carries the whole crew across the water.')}
          </p>
          <span class="inline-block mt-2 text-xs font-medium text-primary">{sx('View product →')}</span>
        </a>
        <a
          href={localizeHref('/sup-accessories', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {sx('SUP Accessories')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {sx('Pumps, leashes, anchors, and carry bags to complete your dock platform setup.')}
          </p>
          <span class="inline-block mt-2 text-xs font-medium text-primary">{sx('Explore accessories →')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Who Is It For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">{sx('Who Is a Dock Platform For?')}</h2>
        <p class="mt-4 text-lg text-gray-500">{sx('Anyone who wants more usable space on the water.')}</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Boat Owners')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Extend your transom with a stable deck for boarding, swimming, and gear — then deflate it and stow it under a seat when underway.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Lake House & Beach Families')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'A swim deck that goes wherever the family goes — anchored off the shore, it is a safe home base for kids, loungers, and the dog.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Jet Ski & Water Sports Riders')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'A floating launch and rest port between rides — tie up alongside, take a break, and keep the day moving without heading back to the dock.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Resorts, Camps & Waterfront Venues')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Modular platforms assemble into waterfront playgrounds — swim zones, sun decks, and event stages that pack away in the off-season. OEM branding available.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
        {sx('OEM/ODM Manufacturing for Inflatable Dock Platforms')}
      </h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        {
          sx(
            'Afarer manufactures inflatable dock platforms, swim decks, and pet ramps for marine brands, resort suppliers, and waterfront accessory retailers. Our 12,000 m² facility produces CE-certified platforms with custom sizes, deck colors, D-ring layouts, and retail packaging. MOQ from 50 units. Lead times from 30 days.'
          )
        }
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">{sx('Custom')}</span>
          <p class="mt-1 text-sm text-gray-500">{sx('Sizes, colors, D-ring layouts')}</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">{sx('Units minimum order')}</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">{sx('30 Days')}</span>
          <p class="mt-1 text-sm text-gray-500">{sx('Typical lead time')}</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a
          href={localizeHref('/oem-odm-manufacturer', lang || 'en')}
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
          >{sx('Request OEM Quote')} <span>→</span></a
        >
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        {sx('Dock Platform — Frequently Asked Questions')}
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        {sx('Common questions about choosing, anchoring, and manufacturing inflatable dock platforms.')}
      </p>
      <div class="space-y-4">
        {
          faqItems.map((item) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-semibold text-secondary">{item.question}</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary">{sx('Dock Platform Guides')}</h2>
      <p class="mt-4 text-lg text-gray-500">{sx('Related content to help you plan your waterfront setup.')}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a
        href={localizeHref('/compare/single-chamber-vs-multi-chamber', lang || 'en')}
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
          {sx('Chamber Safety Guide')}
        </h3>
        <p class="mt-2 text-sm text-gray-500">{sx('Why multi-chamber construction matters for platforms.')}</p>
      </a>
      <a
        href={localizeHref('/beginner-sup', lang || 'en')}
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
          {sx('Beginner SUP Guide')}
        </h3>
        <p class="mt-2 text-sm text-gray-500">{sx('Pairing your platform with easy first boards for guests.')}</p>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">{sx('Expand Your Waterfront')}</h2>
    <p class="mt-4 text-lg text-gray-500">{sx('Talk to our team about the right dock platform for your water.')}</p>
    <a
      href={localizeHref('/contact', lang || 'en')}
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >{sx('Get a Quote')} <span>→</span></a
    >
  </section>
</Layout>
