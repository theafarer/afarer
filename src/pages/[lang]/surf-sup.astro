---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';
import { landingI18n as __landing } from '~/i18n/generated/landing/surf-sup';
import ScenarioShowcase from '~/components/widgets/ScenarioShowcase.astro';
import { getSupScenario, type SupScenario } from '~/data/sup-scenarios';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const __lt = __landing[lang || ''] || {};
const sx = (en: string) => __lt[en] || en;

const metadata = {
  title: sx('Surf SUP Board | Inflatable Surf & Race Paddle Board | Afarer'),
  description: sx(
    'Afarer surf SUP boards — agile inflatable paddle boards for wave riding, race courses, and dynamic water events. Responsive carving, explosive acceleration, gripped deck pads. CE certified. OEM/ODM manufacturing available for brands and clubs.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/surf-sup/`;
const today = '2026-11-05';
const scenario = getSupScenario('surf') as SupScenario;

const faqItems = [
  {
    question: sx('What is a surf SUP board?'),
    answer: sx(
      'A surf SUP board is a shorter, highly maneuverable inflatable paddle board built for riding rolling waves and powering through race courses. It combines a compact planing hull, responsive rails, and a gripped deck pad for aggressive carving and quick direction changes in dynamic water.'
    ),
  },
  {
    question: sx('Can inflatable SUP boards really surf waves?'),
    answer: sx(
      'Yes. Modern drop-stitch surf SUPs inflated to 12–15 PSI are rigid enough to carve clean lines on small-to-medium waves. Their forgiving, cushioned decks also make wipeouts gentler than hardboards — a favorite progression tool for surf-curious paddlers.'
    ),
  },
  {
    question: sx('What size surf SUP should I choose?'),
    answer: sx(
      "For wave riding, most riders choose a board between 8' and 10'6\" for tight turns on the wave face. For race courses and sprint events, longer 12'6\"–14' displacement hulls deliver better glide, tracking, and top-end speed."
    ),
  },
  {
    question: sx('Is a surf SUP good for racing?'),
    answer: sx(
      'Surf-style boards excel in surf races and dynamic water events where agility matters as much as speed. For flatwater sprint and long-distance racing, a dedicated race or touring hull is the better choice.'
    ),
  },
  {
    question: sx('Do you manufacture surf SUPs for private label brands?'),
    answer: sx(
      'Yes. Afarer offers OEM/ODM manufacturing for surf SUP boards with custom deck pads, graphics, color matching, and compliance documentation for surf schools, clubs, and retail brands worldwide.'
    ),
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: sx('Surf SUP Board — Ride Waves and Race Courses on One Agile Platform'),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: sx('Home'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: sx('Inflatable SUP Boards'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: sx('Surf SUP'), item: pageUrl },
      ],
    }}
  />
  <JsonLd data={faqLd} />

  <!-- Hero -->
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href={localizeHref('/inflatable-sup/', lang || 'en')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >{sx('← SUP Product Center')}</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">{sx('SUP Category')}</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        {sx('Surf SUP Board')}
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        {
          sx(
            'The surf SUP is the most dynamic board in the line-up — built for rolling waves, competitive race courses, and every burst of acceleration in between. Afarer surf SUPs pair compact, responsive hulls with full gripped deck pads, so every carve lands exactly where you aim it. Inflate, catch the set, and let the wave do the talking.'
          )
        }
      </p>
    </div>
  </section>

  <ScenarioShowcase
    kicker={sx('On the Water')}
    title={sx('Surf SUP on Waves and Race Courses')}
    description={sx(scenario.description)}
    instructions={sx(scenario.instructions)}
    photos={scenario.photos}
  />

  <!-- Key Features -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">{sx('What Makes a Surf SUP Tick')}</h2>
        <p class="mt-4 text-lg text-gray-500">
          {sx('Agility, drive, and grip — engineered for dynamic water.')}
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 3v2.25M12 21v-2.25M3 12h2.25M18.75 12H21M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{sx('Agile Handling')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Compact hull and responsive rails turn on a dime — drop in, set your rail, and carve bottom turns with minimal effort.'
              )
            }
          </p>
        </div>
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-50 to-green-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{sx('Explosive Acceleration')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Planing hull profiles generate speed instantly — the burst you need to race down the line or win the sprint to the first mark.'
              )
            }
          </p>
        </div>
        <div class="text-center bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-50 to-amber-100 flex items-center justify-center mx-auto"
          >
            <svg class="w-7 h-7 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
              ></path></svg
            >
          </div>
          <h3 class="mt-5 text-lg font-bold text-secondary">{sx('Locked-In Stance')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Full-length gripped deck pads keep your feet planted through aggressive drive, bottom turns, and fast transitions between waves.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Boards -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">{sx('Boards That Match the Energy')}</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href={localizeHref('/products/sup-rheo', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {sx('RHEO Series')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {sx('14-foot carbon-hybrid race SUP with a wave-piercing displacement nose for sprints and race courses.')}
          </p>
          <span class="inline-block mt-2 text-xs font-medium text-primary">{sx('View product →')}</span>
        </a>
        <a
          href={localizeHref('/products/sup-mini', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {sx('Mini SUP Series')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {
              sx(
                'Compact paddle board that doubles as an inflatable surfboard and bodyboard for kids, adults, and pets.'
              )
            }
          </p>
          <span class="inline-block mt-2 text-xs font-medium text-primary">{sx('View product →')}</span>
        </a>
        <a
          href={localizeHref('/products/sup-horizon-lines', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
            {sx('Horizon Lines Series')}
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            {
              sx(
                'Premium 11-foot all-around SUP with fusion laminate construction and triple click fins for any water condition.'
              )
            }
          </p>
          <span class="inline-block mt-2 text-xs font-medium text-primary">{sx('View product →')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Who Is It For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">{sx('Who Is a Surf SUP For?')}</h2>
        <p class="mt-4 text-lg text-gray-500">{sx('Riders who measure fun in waves per hour.')}</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Wave Riders')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Catch rolling waves at the beach break without a car full of hardboards. Inflate on the sand, ride the set, pack it all into a backpack at sunset.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Race & Sprint Paddlers')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'From local SUP races to dynamic water events, surf-race platforms deliver the acceleration and responsive handling that decide finishes.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Fitness-Focused Paddlers')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Dynamic water demands full-body engagement — every session on a surf SUP builds balance, core strength, and paddle-quick reflexes.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">{sx('Surf Schools & Clubs')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              sx(
                'Forgiving inflatable decks make surf SUP the safest entry into wave riding. Durable fleet boards with OEM branding available for schools and clubs.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
        {sx('OEM/ODM Manufacturing for Surf SUPs')}
      </h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        {
          sx(
            'Afarer manufactures surf SUP boards for surf schools, race teams, clubs, and retail brands. Our 12,000 m² facility produces CE-certified drop-stitch boards with custom deck pads, graphics, and retail-ready packaging. MOQ from 50 units. Lead times from 30 days.'
          )
        }
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">{sx('Custom')}</span>
          <p class="mt-1 text-sm text-gray-500">{sx('Deck pads, graphics, packaging')}</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">{sx('Units minimum order')}</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">{sx('30 Days')}</span>
          <p class="mt-1 text-sm text-gray-500">{sx('Typical lead time')}</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a
          href={localizeHref('/oem-odm-manufacturer', lang || 'en')}
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
          >{sx('Request OEM Quote')} <span>→</span></a
        >
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        {sx('Surf SUP — Frequently Asked Questions')}
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        {sx('Common questions about choosing, riding, and manufacturing surf paddle boards.')}
      </p>
      <div class="space-y-4">
        {
          faqItems.map((item) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-semibold text-secondary">{item.question}</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary">{sx('Surf SUP Guides')}</h2>
      <p class="mt-4 text-lg text-gray-500">
        {sx('Related content to help you choose and ride your surf board.')}
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <a
        href={localizeHref('/compare/inflatable-vs-hardboard', lang || 'en')}
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
          {sx('Inflatable vs Hard Board')}
        </h3>
        <p class="mt-2 text-sm text-gray-500">{sx('Can an inflatable really surf? Compare the two.')}</p>
      </a>
      <a
        href={localizeHref('/research/fin-systems-guide', lang || 'en')}
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
          {sx('Fin Systems Guide')}
        </h3>
        <p class="mt-2 text-sm text-gray-500">{sx('How fin setups change turning and drive on a wave.')}</p>
      </a>
      <a
        href={localizeHref('/compare/single-chamber-vs-multi-chamber', lang || 'en')}
        class="group bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all"
      >
        <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
          {sx('Chamber Safety Guide')}
        </h3>
        <p class="mt-2 text-sm text-gray-500">{sx('Single vs multi-chamber construction in surf zones.')}</p>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">{sx('Catch Your First Wave')}</h2>
    <p class="mt-4 text-lg text-gray-500">
      {sx('Our team can help you pick the right surf SUP or discuss manufacturing for your brand or club.')}
    </p>
    <a
      href={localizeHref('/contact', lang || 'en')}
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >{sx('Get a Quote')} <span>→</span></a
    >
  </section>
</Layout>
