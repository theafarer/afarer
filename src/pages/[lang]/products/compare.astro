---
export const prerender = true;

import type { ImageMetadata } from 'astro';
import { languages, defaultLang } from '~/i18n/config';
import { SITE } from 'astrowind:config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { getProducts } from '~/utils/products';
import { products as productRecords } from '~/data/products';
import { localizeProduct } from '~/utils/product-i18n';
import { findImage } from '~/utils/images';
import { withTrailingSlash } from '~/i18n/routing';
import Stars from '~/components/common/Stars.astro';
import { getRatingStats } from '~/data/reviews';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang || defaultLang;
const t = (key: string) => getUiForLang(locale)?.[key] || getUiForLang('en')?.[key] || '';
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);

const metadata = {
  title: t('compare.title') || `Product Comparison — ${SITE.name}`,
  description: t('compare.desc') || 'Compare Afarer inflatable SUPs and accessories side by side.',
};

const products = await getProducts();

const recFor = (slug: string) => {
  const raw = productRecords.find((p) => p.id === slug);
  return raw ? localizeProduct(raw, locale) : undefined;
};

const SKILL_LABELS: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
  professional: 'Professional',
};

interface ComparisonRow {
  label: string;
  value: (p: (typeof products)[number]) => string;
  rating?: boolean;
}

const specGetter = (needle: string, fallback = '-') => {
  return (p: (typeof products)[number]) => {
    const s = p.specs?.find((spec) => spec.label.toLowerCase().includes(needle));
    return s?.value || fallback;
  };
};

const bestFor = (p: (typeof products)[number]) => recFor(p.slug)?.audience || '-';
const skillLevel = (p: (typeof products)[number]) => {
  const skill = recFor(p.slug)?.skill as string | undefined;
  if (!skill) return '-';
  const localized = t(`guides.difficulty.${skill}`);
  return localized || SKILL_LABELS[skill] || '-';
};

const boardRows: ComparisonRow[] = [
  { label: t('compare.bestFor') || 'Best For', value: bestFor },
  { label: t('product.skillLevel') || 'Skill Level', value: skillLevel },
  { label: t('reviews.ratingLabel') || 'Rating', value: () => '-', rating: true },
  { label: t('compare.length') || 'Length', value: specGetter('length') },
  { label: t('compare.width') || 'Width', value: specGetter('width') },
  { label: t('compare.weight') || 'Weight', value: specGetter('weight') },
  {
    label: t('compare.maxLoad') || 'Max Load',
    value: (p: (typeof products)[number]) => {
      const s = p.specs?.find(
        (spec) => spec.label.toLowerCase().includes('load') || spec.label.toLowerCase().includes('capacity')
      );
      return s?.value || '-';
    },
  },
  { label: t('compare.material') || 'Material', value: specGetter('material', 'PVC') },
];

const accessoryRows: ComparisonRow[] = [
  { label: t('compare.bestFor') || 'Best For', value: bestFor },
  { label: t('product.skillLevel') || 'Skill Level', value: skillLevel },
  { label: t('reviews.ratingLabel') || 'Rating', value: () => '-', rating: true },
];

const boardProducts = products.filter((p) => p.category === 'sup');
const accessoryProducts = products.filter((p) => p.category === 'accessory');

const images = new Map<string, ImageMetadata | string | undefined>();
for (const p of products) {
  images.set(p.slug, (await findImage(p.image)) as ImageMetadata | string | undefined);
}
---

<Layout metadata={metadata}>
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a href={withTrailingSlash(`/${locale}/products`)} class="text-sm text-sky-600 hover:text-sky-700"
      >&larr; {t('nav.products') || 'Products'}</a
    >
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">{t('compare.title') || 'Product Comparison'}</h1>
    <p class="mt-4 text-lg text-gray-500">
      {
        t('compare.desc') ||
          'Compare all Afarer products side by side. Find the right board or accessory for your needs.'
      }
    </p>

    <h2 id="paddle-boards" class="mt-14 text-2xl font-semibold text-gray-900">
      {t('techspecs.sup') || 'Paddle Boards'}
    </h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th
              class="sticky left-0 bg-white z-10 px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[140px]"
              >{t('compare.specification') || 'Specification'}</th
            >
            {
              boardProducts.map((p) => (
                <th class="px-4 py-3 text-center font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[160px] align-top">
                  <a href={withTrailingSlash(`/${locale}/products/${p.slug}`)} class="group inline-block">
                    {images.get(p.slug) ? (
                      <Image
                        src={images.get(p.slug) as ImageMetadata | string}
                        alt={p.title}
                        class="w-16 h-16 mx-auto rounded-lg object-cover"
                        widths={[96, 192]}
                        width={96}
                        height={96}
                        format="webp"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="w-16 h-16 mx-auto rounded-lg bg-gray-100" />
                    )}
                    <div class="mt-2 text-xs uppercase tracking-wider text-gray-500 mb-1">
                      {p.seriesLabel || p.categoryLabel}
                    </div>
                    <span class="group-hover:text-sky-600 transition-colors">{p.title}</span>
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            boardRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
                <td
                  class="sticky left-0 px-4 py-3 font-medium text-gray-700 border-b border-gray-200"
                  style={i % 2 === 0 ? 'background:#f9fafb' : 'background:white'}
                >
                  {row.label}
                </td>
                {boardProducts.map((p) => {
                  if (row.rating) {
                    const st = getRatingStats(p.slug);
                    return st ? (
                      <td class="px-4 py-3 text-center border-b border-gray-200">
                        <span class="inline-flex items-center justify-center gap-1.5">
                          <Stars rating={st.avg} size="sm" showValue />
                          <span class="text-xs text-gray-400">({st.count})</span>
                        </span>
                      </td>
                    ) : (
                      <td class="px-4 py-3 text-center text-gray-400 border-b border-gray-200">-</td>
                    );
                  }
                  return <td class="px-4 py-3 text-center text-gray-600 border-b border-gray-200">{row.value(p)}</td>;
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="accessories" class="mt-14 text-2xl font-semibold text-gray-900">
      {t('techspecs.accessories') || 'Accessories'}
    </h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th
              class="sticky left-0 bg-white z-10 px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[140px]"
              >{t('compare.specification') || 'Specification'}</th
            >
            {
              accessoryProducts.map((p) => (
                <th class="px-4 py-3 text-center font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[160px] align-top">
                  <a href={withTrailingSlash(`/${locale}/products/${p.slug}`)} class="group inline-block">
                    {images.get(p.slug) ? (
                      <Image
                        src={images.get(p.slug) as ImageMetadata | string}
                        alt={p.title}
                        class="w-16 h-16 mx-auto rounded-lg object-cover"
                        widths={[96, 192]}
                        width={96}
                        height={96}
                        format="webp"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="w-16 h-16 mx-auto rounded-lg bg-gray-100" />
                    )}
                    <div class="mt-2 text-xs uppercase tracking-wider text-gray-500 mb-1">
                      {p.seriesLabel || p.categoryLabel}
                    </div>
                    <span class="group-hover:text-sky-600 transition-colors">{p.title}</span>
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            accessoryRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
                <td
                  class="sticky left-0 px-4 py-3 font-medium text-gray-700 border-b border-gray-200"
                  style={i % 2 === 0 ? 'background:#f9fafb' : 'background:white'}
                >
                  {row.label}
                </td>
                {accessoryProducts.map((p) => {
                  if (row.rating) {
                    const st = getRatingStats(p.slug);
                    return st ? (
                      <td class="px-4 py-3 text-center border-b border-gray-200">
                        <span class="inline-flex items-center justify-center gap-1.5">
                          <Stars rating={st.avg} size="sm" showValue />
                          <span class="text-xs text-gray-400">({st.count})</span>
                        </span>
                      </td>
                    ) : (
                      <td class="px-4 py-3 text-center text-gray-400 border-b border-gray-200">-</td>
                    );
                  }
                  return <td class="px-4 py-3 text-center text-gray-600 border-b border-gray-200">{row.value(p)}</td>;
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-14 rounded-2xl bg-sky-50 border border-sky-100 px-6 py-10 text-center">
      <h2 class="text-2xl font-semibold text-gray-900">
        {t('compare.notSureTitle') || 'Not sure which board is right for you?'}
      </h2>
      <p class="mt-3 text-gray-600 max-w-2xl mx-auto">
        {
          t('compare.notSureDesc') ||
            'Use our size guide to find the right board in under a minute — or ask our team, we are happy to help.'
        }
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href={withTrailingSlash(`/${locale}/size-guide`)}
          class="px-6 py-3 bg-sky-600 text-white text-sm font-semibold rounded-lg hover:bg-sky-700 transition-colors"
        >
          {t('compare.findBoard') || 'Find Your Board'}
        </a>
        <a
          href={withTrailingSlash(`/${locale}/contact`)}
          class="px-6 py-3 border border-sky-600 text-sky-700 text-sm font-semibold rounded-lg hover:bg-sky-100 transition-colors"
        >
          {t('product.askQuestion') || 'Ask a Question'}
        </a>
      </div>
    </div>

    <section class="sr-only" data-ai-block="definition" aria-hidden="true">
      <p>
        {fr('Afarer product comparison tables covering', 'Tableaux de comparaison des produits afarer couvrant')}
        {products.length}
        {fr('products:', 'produits :')}
        {boardProducts.length}
        {fr('paddle boards and', 'planches de paddle et')}
        {accessoryProducts.length}
        {
          fr(
            'accessories. Compare best-for audience, skill level, length, width, weight, max load, and material. Includes a size guide call-to-action.',
            'accessoires. Comparez le public cible, le niveau, la longueur, la largeur, le poids, la charge maximale et le matériau. Appel à consulter le guide des tailles.'
          )
        }
      </p>
    </section>
  </section>
</Layout>
