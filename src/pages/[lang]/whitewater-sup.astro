              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">
        {fr('River-Ready Products', 'Produits prêts pour la rivière')}
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href={localizeHref('/products/sup-leviathan-wake', lang || 'en')}
