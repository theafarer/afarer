            >
          </div>
        </a>
        <a
          href={localizeHref('/products/sup-cheetah-surge', lang || 'en')}
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-yellow-50 to-amber-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-cheetah-surge-1-1200w.webp"
              alt="Cheetah Surge Edition"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Cheetah Surge Edition
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              {
                fr(
                  'Agile performance SUP with responsive handling. Suitable for experienced paddlers tackling dynamic river conditions.',
                  'SUP de performance agile au comportement réactif. Convient aux pratiquants expérimentés qui affrontent des conditions fluviales dynamiques.'
                )
              }
