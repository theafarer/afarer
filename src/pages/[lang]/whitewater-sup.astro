---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);

const metadata = {
  title: fr(
    'Whitewater SUP Board | River-Running Inflatable Paddle Board | Afarer',
    'Paddle Eau Vive | Planche de Paddle Gonflable pour Rivière | afarer'
  ),
  description: fr(
    'Afarer whitewater SUP boards — rugged inflatable paddle boards for river running, Class I-II rapids, and moving water. Reinforced rails, high PSI drop-stitch, expedition-ready. OEM/ODM manufacturing available for brands and outfitters.',
    'Planches de paddle eau vive afarer — paddles gonflables robustes pour la descente de rivière, les rapides de classe I-II et les eaux vives. Rails renforcés, drop-stitch haute pression PSI, prêtes pour l’expédition. Fabrication OEM/ODM disponible pour les marques et les professionnels de la rivière.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/whitewater-sup/`;
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr('Whitewater SUP Board — Conquer the Rapids', 'Planche de paddle eau vive — Domptez les rapides'),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: fr('Inflatable SUP Boards', 'SUP gonflables'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: fr('Whitewater SUP', 'Paddle eau vive'), item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: fr('What is a whitewater SUP board?', 'Qu’est-ce qu’une planche de paddle eau vive ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'A whitewater SUP board is a shorter, more rugged inflatable paddle board designed for river running on Class I–III rapids. It features reinforced rails, higher PSI construction, and a compact length (8’–10’) for quick maneuverability in moving water.',
              'Une planche de paddle eau vive est un paddle gonflable plus court et plus robuste, conçu pour la descente de rivière sur des rapides de classe I à III. Elle dispose de rails renforcés, d’une construction à plus haute pression PSI et d’une longueur compacte (8’–10’) pour une manœuvrabilité rapide en eau vive.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('Can you use a regular SUP in whitewater?', 'Peut-on utiliser un paddle classique en eau vive ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Regular SUPs lack the reinforced construction, impact resistance, and maneuverability needed for whitewater. Standard boards risk delamination, rail damage, and poor handling in rapids. A dedicated whitewater SUP is recommended.',
              'Les paddles classiques n’ont ni la construction renforcée, ni la résistance aux chocs, ni la manœuvrabilité nécessaires en eau vive. Les planches standard risquent la délamination, des dégâts sur les rails et un mauvais comportement dans les rapides. Un paddle eau vive dédié est recommandé.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('What PSI should a whitewater SUP be?', 'À quelle pression PSI gonfler un paddle eau vive ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Whitewater SUPs should be inflated to 15–18 PSI for maximum rigidity. Higher pressure maintains board shape through turbulent water and provides better response to paddle strokes for maneuvering around obstacles.',
              'Les paddles eau vive doivent être gonflés à 15–18 PSI pour une rigidité maximale. Une pression plus élevée maintient la forme de la planche dans les eaux turbulentes et offre une meilleure réponse aux coups de pagaie pour slalomer entre les obstacles.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('Is whitewater SUP dangerous?', 'Le paddle eau vive est-il dangereux ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Whitewater SUP carries inherent risks as an extreme sport. Proper safety gear (helmet, life vest, leash, river shoes) and appropriate skill progression are essential. Start with Class I rapids and progress with experience.',
              'Le paddle eau vive comporte des risques inhérents, comme tout sport extrême. Un équipement de sécurité adapté (casque, gilet de sauvetage, leash, chaussures de rivière) et une progression technique appropriée sont indispensables. Commencez par des rapides de classe I et progressez avec l’expérience.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Do you manufacture whitewater SUPs for private label?',
            'Fabriquez-vous des paddles eau vive en marque privée ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Afarer offers OEM/ODM manufacturing for whitewater SUP boards with reinforced construction, custom graphics, and compliance documentation for outdoor brands and river outfitters.',
              'Oui. afarer propose une fabrication OEM/ODM de planches de paddle eau vive avec construction renforcée, graphismes personnalisés et documentation de conformité pour les marques outdoor et les professionnels de la rivière.'
            ),
          },
        },
      ],
    }}
  />

  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href={localizeHref('/inflatable-sup/', lang || 'en')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >{fr('← SUP Product Center', '← Centre Produits SUP')}</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase"
        >{fr('SUP Category', 'Catégorie SUP')}</span
      >
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        {fr('Whitewater SUP Board', 'Planche de paddle eau vive')}
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        {
          fr(
            'Whitewater SUP paddling demands a board that can withstand impacts, maintain rigidity in turbulence, and respond quickly to paddle strokes. Afarer whitewater SUPs feature reinforced rail construction, shorter lengths for maneuverability, and high-PSI drop-stitch cores that maintain shape through rapids and hydraulics.',
            'La pratique du paddle eau vive exige une planche capable d’encaisser les chocs, de maintenir sa rigidité dans la turbulence et de réagir rapidement aux coups de pagaie. Les paddles eau vive afarer allient construction à rails renforcés, longueurs raccourcies pour la manœuvrabilité et noyaux drop-stitch haute pression PSI qui conservent leur forme à travers les rapides et les rouleaux.'
          )
        }
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">
          {fr('Whitewater SUP Features', 'Caractéristiques du paddle eau vive')}
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">{fr('Impact-Resistant Rails', 'Rails résistants aux chocs')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              fr(
                'Reinforced side rails with fusion-laminated seams absorb impacts from rocks and submerged obstacles without delamination or air loss.',
                'Les rails latéraux renforcés aux coutures laminées par fusion absorbent les chocs des rochers et obstacles submergés sans délamination ni perte d’air.'
              )
            }
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">{fr('Shorter Agile Hull', 'Coque courte et agile')}</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
