---
export const prerender = true;

import PageLayout from '~/layouts/PageLayout.astro';
import { getLangFromUrl } from '~/i18n/utils';
import { languages } from '~/i18n/config';
import { articleSchema } from '~/lib/seo/schema';
import { nodes } from '~/content/graph/nodes';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/maritime-safety-defense.ts';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
setPageContentData(__pageData);
const page = getPageContent(lang, 'maritime-safety-defense');
const node = nodes.find((n) => n.id === 'maritime-safety-defense');

const graphJsonLd = node
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        articleSchema({
          headline: page.seo?.headline || 'Maritime Safety & Defense Inflatable Boats — OEM Manufacturing',
          description:
            page.seo?.description ||
            'Afarer manufactures inflatable boats for maritime safety and defense applications: coastal patrol, force protection, rapid response.',
          datePublished: page.seo?.datePublished || '2024-06-01',
          dateModified: page.seo?.dateModified || '2026-06-01',
          author: 'Afarer',
          publisher: 'Afarer',
        }),
        {
          '@type': 'Product',
          name: node?.name?.en || 'Maritime Safety & Defense Inflatable Boats',
          description:
            node?.description?.en ||
            'Inflatable boats engineered for maritime safety, coastal patrol, and defense operations.',
          brand: { '@type': 'Brand', name: 'Afarer' },
          category: 'Defense & Security Equipment',
        },
      ],
    }
  : null;
---

<PageLayout>
  <script is:inline type="application/ld+json" set:html={graphJsonLd ? JSON.stringify(graphJsonLd) : ''} />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{page.label || 'Use Case'}</span>
    <h1 class="font-semibold text-gray-900 dark:text-gray-100 mt-4 text-4xl">
      {page.headline || 'Engineering Excellence for Marine Safety and Defense'}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mt-3">
      {page.subtitle || 'Uncompromising quality for the most demanding maritime operational environments.'}
    </p>

    <div class="mt-12 prose prose-gray dark:prose-invert max-w-none" set:html={page.body || ''} />
  </section>
</PageLayout>
