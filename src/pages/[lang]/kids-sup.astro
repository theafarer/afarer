---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const fr = (en: string, francais: string) => (lang === 'fr' ? francais : en);

const metadata = {
  title: fr(
    'Kids SUP Board | Best Inflatable Paddle Board for Children | Afarer OEM Manufacturer',
    'Planche de Paddle Enfant | Meilleur Paddle Gonflable pour Enfants | Fabricant OEM afarer'
  ),
  description: fr(
    'Afarer kids SUP boards — smaller, lighter inflatable paddle boards designed for children. Shorter length, lower volume, and kid-friendly designs for safe family paddling. OEM/ODM manufacturing available for brands and retailers.',
    'Planches de paddle enfant afarer — paddles gonflables plus petits et plus légers conçus pour les enfants. Longueur réduite, volume inférieur et designs adaptés aux enfants pour des sorties familiales en toute sécurité. Fabrication OEM/ODM disponible pour les marques et les détaillants.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/kids-sup/`;
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr(
        'Kids SUP Board — Introducing Children to Paddle Boarding',
        'Planche de Paddle Enfant — Initier les Enfants au Paddle'
      ),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: fr('Inflatable SUP Boards', 'Paddles Gonflables'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: fr('Kids SUP', 'Paddle enfant'), item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: fr(
            'What age is appropriate for a kids SUP board?',
            'À partir de quel âge pour une planche de paddle enfant ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Children as young as 5–6 years old can start on a kids SUP board with adult supervision. Boards for young children are typically 8′–9′ long with lower volume and lighter weight for easy handling.',
              'Des enfants dès 5–6 ans peuvent débuter sur une planche de paddle enfant sous supervision d’un adulte. Les planches pour jeunes enfants mesurent généralement 2,40 à 2,70 m de long, avec un volume réduit et un poids léger pour une manipulation facile.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('What size SUP does a child need?', 'Quelle taille de paddle pour un enfant ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              "A kids SUP should match the child's weight and height. For children under 80 lbs, an 8′–9′ board with 26″–28″ width is appropriate. For teens and larger children, a 9′–10′ board with 28″–30″ width works well.",
              'Un paddle enfant doit correspondre au poids et à la taille de l’enfant. Pour les enfants de moins de 36 kg, une planche de 2,40 à 2,70 m avec une largeur de 66 à 71 cm convient. Pour les ados et les enfants plus grands, une planche de 2,70 à 3,00 m avec une largeur de 71 à 76 cm fonctionne bien.'
