---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages } from '~/i18n/config';
import { localizeHref } from '~/i18n/routing';
import { landingI18n as __landing } from '~/i18n/generated/landing/fishing-sup';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const __lt = __landing[lang || ''] || {};
const fr = (en: string, francais: string) => __lt[en] || (lang === 'fr' ? francais : en);

const metadata = {
  title: fr(
    'Fishing SUP Board | Inflatable Paddle Board for Fishing | Afarer OEM Manufacturer',
    'Planche de Paddle Pêche | Paddle Gonflable Pêche | Fabricant OEM afarer'
  ),
  description: fr(
    'Afarer fishing SUP boards — stable, wide inflatable paddle boards designed for anglers. Mount accessories, store gear, and access remote fishing spots silently. OEM/ODM manufacturing available for brands, resorts, and clubs.',
    'Planches de paddle pêche afarer — paddles gonflables larges et stables conçus pour les pêcheurs. Montez des accessoires, rangez votre matériel et accédez silencieusement aux spots de pêche reculés. Fabrication OEM/ODM disponible pour les marques, complexes hôteliers et clubs.'
  ),
  ignoreTitleTemplate: true,
};
const pageUrl = `https://afarer.com/${lang}/fishing-sup/`;
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: fr(
        'Fishing SUP Board — The Angler’s Floating Platform',
        'Planche de Paddle Pêche — La Plateforme Flottante du Pêcheur'
      ),
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: fr('Home', 'Accueil'), item: `https://afarer.com/${lang}/` },
        {
          position: 2,
          name: fr('Inflatable SUP Boards', 'Paddles Gonflables'),
          item: `https://afarer.com/${lang}/inflatable-sup/`,
        },
        { position: 3, name: fr('Fishing SUP', 'Paddle pêche'), item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: fr('What makes a good fishing SUP board?', 'Qu’est-ce qui fait une bonne planche de paddle pêche ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'A good fishing SUP needs a wide stable platform (34″+), sufficient weight capacity for angler plus gear, D-ring grid for mounting accessories, and durable multi-chamber construction for safety. Quiet approach and shallow draft are key advantages over boats.',
              'Un bon paddle pêche nécessite une plateforme large et stable (86 cm et plus), une capacité de charge suffisante pour le pêcheur et son matériel, une grille d’anneaux en D pour monter des accessoires et une construction multichambres durable pour la sécurité. L’approche silencieuse et le faible tirant d’eau sont des avantages clés par rapport aux bateaux.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('Can you stand up and fish on a SUP?', 'Peut-on pêcher debout sur un paddle ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Fishing SUPs are designed with extra-wide decks (34″–36″) that provide the stability needed for stand-up casting. The broad platform distributes weight evenly, allowing anglers to stand, kneel, or sit while fishing.',
              'Oui. Les paddles pêche sont conçus avec des ponts extra-larges (86 à 91 cm) qui offrent la stabilité nécessaire pour lancer debout. La large plateforme répartit le poids uniformément, permettant aux pêcheurs de rester debout, à genoux ou assis en pêchant.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('What accessories do I need for SUP fishing?', 'Quels accessoires pour la pêche en paddle ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Essential SUP fishing accessories include a rod holder, anchor system, cooler or crate for gear, a personal flotation device, and a waterproof bag for electronics. Many fishing SUPs come with a D-ring grid for easy accessory mounting.',
              'Les accessoires essentiels pour la pêche en paddle incluent un porte-canne, un système d’ancre, une glacière ou une caisse pour le matériel, un gilet de sauvetage et un sac étanche pour l’électronique. De nombreux paddles pêche sont équipés d’une grille d’anneaux en D pour un montage facile des accessoires.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr('Is SUP fishing safe?', 'La pêche en paddle est-elle sûre ?'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Choose a multi-chamber inflatable SUP for redundancy, always wear a life vest, use a leash, and check weather conditions before heading out. Avoid strong currents, wind, and boat traffic.',
              'Oui. Choisissez un paddle gonflable multichambres pour la redondance, portez toujours un gilet de sauvetage, utilisez une laisse et vérifiez les conditions météo avant de partir. Évitez les courants forts, le vent et le trafic de bateaux.'
            ),
          },
        },
        {
          '@type': 'Question',
          name: fr(
            'Do you manufacture fishing SUPs for private label?',
            'Fabriquez-vous des paddles pêche en marque blanche ?'
          ),
          acceptedAnswer: {
            '@type': 'Answer',
            text: fr(
              'Yes. Afarer offers OEM/ODM manufacturing for fishing SUP boards with custom accessory mounting systems, deck graphics, color matching, and compliance documentation for brands and retail partners worldwide.',
              'Oui. afarer propose la fabrication OEM/ODM de planches de paddle pêche avec des systèmes de montage d’accessoires personnalisés, des graphismes de pont, des couleurs assorties et une documentation de conformité pour les marques et partenaires de distribution du monde entier.'
            ),
          },
        },
      ],
    }}
