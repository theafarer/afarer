---
/* eslint-disable @typescript-eslint/no-explicit-any */
export const prerender = true;

import Steps2 from '~/components/widgets/Steps2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import QuotationForm from '~/components/widgets/QuotationForm.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/request-quotation.ts';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'request-quotation');

const hero = page.hero_text ?? {};
const process = page.steps2_process ?? {};
const form = page.content_form ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const formContactFields = (form as any)?.contact_fields ?? {};
const formFields = Array.isArray((form as any)?.fields) ? (form as any).fields : [];

const metadata = {
  title: `Request a Quote — ${SITE.name} | OEM/ODM Marine Manufacturing`,
  description:
    "Submit your product requirements for a detailed quotation from Afarer's manufacturing team. We respond within 2 business days.",
};
const crumbs = [{ name: t('nav.home'), href: `/${lang}/` }, { name: t('cta.requestQuote') }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <HeroText tagline={hero.tagline} title={hero.title} subtitle={hero.subtitle} />
  <Steps2 title={process.title} subtitle={process.subtitle} items={process.items} />
  <QuotationForm
    tagline={form.tagline}
    title={form.title}
    subtitle={form.subtitle}
    contactFields={formContactFields}
    fields={formFields}
    language={lang}
  />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
</Layout>
