---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const metadata = {
  title: `OEM SUP Manufacturing Guide — Free White Paper | ${SITE.name}`,
  description: 'Download our comprehensive white paper on OEM/ODM inflatable SUP manufacturing. Covers mold design, material selection, quality control, logistics, and cost optimization.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata} breadcrumbs={[{ name: 'Home', href: `/${lang}/` }, { name: 'Resources', href: `/${lang}/resources` }, { name: 'OEM SUP Manufacturing Guide' }]}>
  <article class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <span class="text-sm font-semibold uppercase tracking-wider text-sky-600">Free White Paper</span>
      <h1 class="mt-4 text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight">The Complete Guide to OEM Inflatable SUP Manufacturing</h1>
      <p class="mt-4 text-lg text-gray-500 dark:text-slate-400 max-w-2xl mx-auto">Everything you need to know about bringing a private label or custom SUP board from concept to container.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="prose dark:prose-invert max-w-none">
        <h2>What's Inside</h2>
        <ul>
          <li><strong>Chapter 1</strong>: Market overview — global SUP market size, growth trends, and regional opportunities</li>
          <li><strong>Chapter 2</strong>: Manufacturing methods — drop-stitch core lamination, HF welding, and material science</li>
          <li><strong>Chapter 3</strong>: Mold design & tooling — CAD/CAM process, aluminum vs composite molds, cost ranges</li>
          <li><strong>Chapter 4</strong>: Material selection guide — PVC grades, Hypalon, reinforcement fabrics, and environmental resistance</li>
          <li><strong>Chapter 5</strong>: Quality control framework — ISO 2859 sampling, burst testing, pressure retention, seam integrity</li>
          <li><strong>Chapter 6</strong>: Compliance & certification — CE, UKCA, BSCI, REACH, RoHS, and destination country requirements</li>
          <li><strong>Chapter 7</strong>: Cost optimization — mold amortization, volume pricing, material substitution, and logistics consolidation</li>
          <li><strong>Chapter 8</strong>: Logistics & shipping — FOB, CIF, DDP, container loading, customs clearance, and freight forwarding</li>
          <li><strong>Chapter 9</strong>: Supplier qualification — factory audit checklist, NDA templates, and communication protocols</li>
          <li><strong>Chapter 10</strong>: Case studies — real brand launches with timeline, budget, and outcomes</li>
        </ul>

        <h2>Who Should Read This</h2>
        <ul>
          <li>Entrepreneurs launching their first SUP brand</li>
          <li>Existing water sports brands adding inflatable product lines</li>
          <li>Retailers and distributors developing private label programs</li>
          <li>Resort and rental operators planning branded fleet programs</li>
          <li>Procurement professionals evaluating Asian manufacturing partners</li>
        </ul>

        <div class="mt-8 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-xl p-6">
          <p class="text-sm font-medium text-amber-800 dark:text-amber-300">Author</p>
          <p class="mt-1 text-gray-700 dark:text-slate-300">Afarer OEM Engineering Team — 10+ years in inflatable marine manufacturing, 200+ brand launches across 50+ countries.</p>
        </div>
      </div>

      <div class="bg-gray-50 dark:bg-slate-800 rounded-2xl p-8 border border-gray-200 dark:border-slate-700 sticky top-24">
        <div class="text-center">
          <div class="w-20 h-20 mx-auto bg-sky-100 dark:bg-sky-900 rounded-2xl flex items-center justify-center">
            <svg class="w-10 h-10 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="mt-4 text-xl font-bold text-gray-900 dark:text-white">Download Free White Paper</h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-slate-400">42 pages. Instant PDF download. No credit card required.</p>
        </div>

        <form class="mt-6 space-y-4" data-whitepaper-form>
          <input type="text" name="first_name" required placeholder="First Name" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none" />
          <input type="text" name="last_name" required placeholder="Last Name" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none" />
          <input type="email" name="email" required placeholder="Work Email" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none" />
          <input type="text" name="company" placeholder="Company Name" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none" />
          <input type="hidden" name="subject" value="White Paper Download: OEM SUP Manufacturing Guide" />
          <input type="hidden" name="message" value="Please send the white paper download link." />
          <input type="text" name="email_confirm" class="absolute left-[-9999px] top-[-9999px] opacity-0" tabindex="-1" aria-hidden="true" autocomplete="off" />
          <button type="submit" class="w-full px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl transition-colors">Download Free Guide</button>
          <p class="text-xs text-gray-400 dark:text-slate-500 text-center">We respect your privacy. Unsubscribe anytime.</p>
          <div data-whitepaper-status class="text-sm text-center hidden"></div>
        </form>
      </div>
    </div>

    <div class="mt-16 border-t border-gray-200 dark:border-slate-700 pt-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-center">What Industry Professionals Say</h2>
      <div class="mt-8 grid md:grid-cols-3 gap-6">
        <blockquote class="bg-gray-50 dark:bg-slate-800 rounded-xl p-6 border border-gray-200 dark:border-slate-700">
          <p class="text-gray-600 dark:text-slate-400 text-sm italic">"The chapter on mold cost amortization alone saved us $12,000 on our first production run. Every brand owner should read this before contacting a factory."</p>
          <footer class="mt-4 text-sm font-medium text-gray-900 dark:text-white">— Marine Brand Founder, US</footer>
        </blockquote>
        <blockquote class="bg-gray-50 dark:bg-slate-800 rounded-xl p-6 border border-gray-200 dark:border-slate-700">
          <p class="text-gray-600 dark:text-slate-400 text-sm italic">"We used the factory audit checklist to evaluate three Chinese manufacturers. It helped us identify the right partner on the first attempt."</p>
          <footer class="mt-4 text-sm font-medium text-gray-900 dark:text-white">— Procurement Manager, EU</footer>
        </blockquote>
        <blockquote class="bg-gray-50 dark:bg-slate-800 rounded-xl p-6 border border-gray-200 dark:border-slate-700">
          <p class="text-gray-600 dark:text-slate-400 text-sm italic">"The compliance section clarified exactly which certifications we needed for the UK market. Worth the download just for that chapter."</p>
          <footer class="mt-4 text-sm font-medium text-gray-900 dark:text-white">— Retail Brand Director, UK</footer>
        </blockquote>
      </div>
    </div>
  </article>

  <script is:inline>
    (function () {
      const form = document.querySelector('form[data-whitepaper-form]');
      if (!form) return;
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const status = form.querySelector('[data-whitepaper-status]');
        if (!status) return;
        status.classList.add('hidden');
        const fd = new FormData(form);
        try {
          const res = await fetch('/api/contact', { method: 'POST', body: fd });
          const data = await res.json();
          if (res.ok) {
            status.textContent = 'Thanks! Check your email for the download link.';
            status.className = 'mt-3 text-sm text-green-600 dark:text-green-400 text-center';
            form.querySelectorAll('input:not([type=hidden])').forEach(function (inp) { inp.value = ''; });
          } else {
            status.textContent = data?.error || 'Something went wrong. Please try again.';
            status.className = 'mt-3 text-sm text-red-600 dark:text-red-400 text-center';
          }
        } catch {
          status.textContent = 'Network error. Please try again.';
          status.className = 'mt-3 text-sm text-red-600 dark:text-red-400 text-center';
        }
        status.classList.remove('hidden');
      });
    })();
  </script>
</Layout>
