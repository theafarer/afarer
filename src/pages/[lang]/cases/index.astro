---
export const prerender = true;

import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/cases.ts';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (k: string) => getUiForLang(lang)?.[k] || getUiForLang('en')?.[k] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'cases');

const hero = page.hero ?? {};
const cases = page.features3_cases ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a) => ({ ...a, href: lh(a.href) }));

const metadata = {
  title: `Case Studies — ${SITE.name} | Water Sports Partnership Projects`,
  description:
    'Real projects from around the world: diving center fleets, country distribution partnerships, rescue boat supply, resort equipment packages, and more.',
};
const crumbs = [{ name: t('nav.home'), href: `/${lang}/` }, { name: t('nav.cases') }];
const caseSchemas = (cases.items || [])
  .filter((c) => c.customer && c.country)
  .map((c, _i) => ({
    '@type': 'CaseStudy',
    name: c.title,
    description: c.description,
    image: c.image,
    customer: {
      '@type': 'Organization',
      name: c.customer,
      address: { '@type': 'PostalAddress', addressCountry: c.country },
    },
    about: { '@type': 'Thing', name: c.industry || 'Marine Equipment' },
    knowsAbout: c.product,
    quote: c.quote,
    datePublished: '2026',
  }));
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': caseSchemas })}
  />
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Features3
    tagline={cases.tagline}
    title={cases.title}
    subtitle={cases.subtitle}
    columns={cases.columns}
    items={cases.items}
  />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
</Layout>
