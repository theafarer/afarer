---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import evidenceData from '~/data/site/evidence.yaml';

interface CaseStudy {
  id: string;
  client: string;
  product: string;
  industry: string;
  challenge: string;
  solution: string;
  result: string;
  image: string;
  tags: string[];
  outcome_metrics: { label: string; value: string }[];
}

const d = evidenceData as any;
const caseStudies: CaseStudy[] = d.case_studies ?? [];

const metadata = {
  title: `Case Studies | ${SITE.name}`,
  description: `Real customer success stories and deployment case studies from afarer's inflatable watercraft across 50+ countries.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Case Studies',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href="/evidence" class="hover:text-sky-600">Evidence</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">Case Studies</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">Customer Success Stories</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">Case Studies</h1>
      <p class="mt-4 text-lg text-gray-500">
        Real partnerships across industries — from boutique brands to government agencies. See how afarer delivers.
      </p>
    </div>

    <section class="mb-20">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          caseStudies.map((cs) => (
            <a
              href={`/evidence/case-studies/${cs.id}`}
              class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
            >
              <div class="h-48 bg-gray-100 overflow-hidden">
                <img
                  src={cs.image}
                  alt={cs.product}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full">
                    {cs.industry}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                  {cs.client}
                </h3>
                <p class="text-sm text-gray-500 mb-1">{cs.product}</p>
                <p class="text-xs text-gray-400 line-clamp-3 mt-1">{cs.challenge}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {cs.outcome_metrics.slice(0, 3).map((m) => (
                    <span class="text-xs bg-gray-50 border border-gray-200 rounded-lg px-2 py-1">
                      <strong class="text-gray-900">{m.value}</strong>
                      <span class="text-gray-500"> {m.label}</span>
                    </span>
                  ))}
                </div>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                  View Case Study &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="bg-gradient-to-r from-sky-600 to-blue-700 rounded-2xl p-10 text-center text-white">
      <h2 class="text-2xl font-bold mb-3">Want to discuss your project?</h2>
      <p class="text-sky-100 max-w-xl mx-auto mb-6">
        Tell us about your requirements and we will share relevant case studies and references.
      </p>
      <a
        href="/contact"
        class="inline-block bg-white text-sky-700 font-semibold px-8 py-3 rounded-xl hover:bg-sky-50 transition-colors"
        >Contact Our Team</a
      >
    </section>
  </div>
</Layout>
