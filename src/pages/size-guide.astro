---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import BoardFinder from '~/components/common/BoardFinder.astro';
import { getProducts } from '~/utils/products';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/size-guide.ts';

const lang = Astro.locals.lang;

setPageContentData(__pageData);
const page = getPageContent(lang, 'size-guide') || {};
const hero = page.hero || {};
const categoriesText = page.categories || {};
const tableHeaders = page.table?.headers || {};
const howToChoose = page.how_to_choose || {};

const metadata = {
  title: `Size Guide –{SITE.name}`,
  description:
    'Find the right size inflatable SUP for your needs. Compare dimensions, weight capacities, and recommended uses.',
};

const products = await getProducts();

const getSpec = (p: (typeof products)[number], label: string) => {
  const s = p.specs?.find((s) => s.label.toLowerCase().includes(label.toLowerCase()));
  return s?.value || '-';
};

const parseLbs = (specVal: string) => {
  const m = String(specVal).match(/([\d.]+)\s*lbs?/i);
  if (m) return Math.round(parseFloat(m[1]));
  const k = String(specVal).match(/([\d.]+)\s*kg/i);
  if (k) return Math.round(parseFloat(k[1]) * 2.2046);
  return null;
};

const finder = page.finder || {};
const compareUrl = '/products/compare/';

const finderProducts = products
  .filter((p) => p.category === 'sup')
  .map((p) => {
    const maxLoad = getSpec(p, 'load') !== '-' ? getSpec(p, 'load') : getSpec(p, 'capacity');
    return {
      slug: p.slug,
      title: p.title,
      url: `/products/${p.slug}/`,
      image: p.image || '',
      series: p.series || '',
      seriesLabel: p.seriesLabel || '',
      length: getSpec(p, 'length'),
      width: getSpec(p, 'width'),
      maxLoad,
      maxLoadLbs: parseLbs(maxLoad),
      price: p.price && p.price.currency === 'USD' ? `$${p.price.amount}` : p.price ? String(p.price.amount) : null,
    };
  });
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    article={{
      headline: 'Size & Specs Guide',
      description: metadata.description,
      datePublished: '2024-09-01',
      dateModified: '2025-06-15',
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Size Guide', item: 'https://afarer.com/size-guide/' },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I choose the right SUP board size?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Choose length based on your weight and intended use. Wider boards (32"+) offer more stability. Longer boards (11-12 ft) track better for touring. Heavier paddlers need higher volume boards.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the weight capacity of afarer SUPs?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Weight capacities vary by model. Our inflatable SUPs typically support 220-350 lbs depending on length and volume. Check individual product specs for exact capacity.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are all afarer SUPs the same width?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Board widths range from 30" to 36". Narrower boards (30-32") are faster and better for touring. Wider boards (33-36") offer more stability for fishing, yoga, and beginners.',
          },
        },
        {
          '@type': 'Question',
          name: 'What size SUP is best for beginners?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Beginners should choose a wider board (32-34") that is 10-11 ft long. The extra width provides stability while learning balance and paddle technique.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do SUP accessories come in universal sizes?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most afarer accessories use universal sizing. Life vests come in S/M/L/XL, leashes in standard lengths, and paddles are adjustable from 68" to 86" to fit most paddlers.',
          },
        },
      ],
    }}
  />
  <section class="max-w-6xl mx-auto py-24 px-6">
    <h1 class="text-4xl font-semibold text-gray-900">{hero.title || 'Size & Specs Guide'}</h1>
    <p class="mt-4 text-lg text-gray-500">
      {hero.subtitle || 'Dimensions, capacities, and recommended uses for every afarer product.'}
    </p>

    <BoardFinder
      finder={finder}
      specLabels={{
        length: tableHeaders.length || 'Length',
        width: tableHeaders.width || 'Width',
        max_load: tableHeaders.max_load || 'Max Load',
      }}
      products={finderProducts}
      compareUrl={compareUrl}
    />

    <div class="mt-16 space-y-16">
      {
        (['sup', 'accessory'] as const).map((cat) => {
          const catProducts = products.filter((p) => p.category === cat);
          if (catProducts.length === 0) return null;
          const catLabel = catProducts[0]?.categoryLabel || cat;
          return (
            <section>
              <h2 class="text-2xl font-semibold text-gray-900 mb-2">{catLabel}</h2>
              <p class="text-gray-500 mb-6">{categoriesText[cat] || ''}</p>
              <div class="overflow-x-auto">
                <table class="w-full text-sm border-collapse">
                  <thead>
                    <tr class="bg-gray-50">
                      <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b border-gray-200">
                        {tableHeaders.product || 'Product'}
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b border-gray-200">
                        {tableHeaders.length || 'Length'}
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b border-gray-200">
                        {tableHeaders.width || 'Width'}
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b border-gray-200">
                        {tableHeaders.weight || 'Weight'}
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b border-gray-200">
                        {tableHeaders.max_load || 'Max Load'}
                      </th>
                      <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b border-gray-200">
                        {tableHeaders.best_for || 'Best For'}
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {catProducts.map((p, i) => (
                      <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
                        <td class="px-4 py-3 font-medium text-gray-900 border-b border-gray-200">
                          <a href={`/products/${p.slug}`} class="hover:text-sky-600">
                            {p.title}
                          </a>
                        </td>
                        <td class="px-4 py-3 text-gray-600 border-b border-gray-200">{getSpec(p, 'length')}</td>
                        <td class="px-4 py-3 text-gray-600 border-b border-gray-200">{getSpec(p, 'width')}</td>
                        <td class="px-4 py-3 text-gray-600 border-b border-gray-200">{getSpec(p, 'weight')}</td>
                        <td class="px-4 py-3 text-gray-600 border-b border-gray-200">
                          {getSpec(p, 'load') || getSpec(p, 'capacity') || '-'}
                        </td>
                        <td class="px-4 py-3 text-gray-600 border-b border-gray-200">{p.summary || '-'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          );
        })
      }
    </div>

    <section class="mt-16 p-6 bg-sky-50 rounded-2xl border border-sky-100">
      <h2 class="text-xl font-semibold text-gray-900">{howToChoose.title || 'How to Choose the Right Size'}</h2>
      <div class="mt-4 grid md:grid-cols-3 gap-6">
        {
          (howToChoose.cards && howToChoose.cards.length > 0
            ? howToChoose.cards
            : [
                {
                  title: 'SUP Boards',
                  description:
                    'Choose length based on your weight and intended use. Wider boards (32"+) offer more stability. Longer boards (11-12 ft) track better for touring. Heavier paddlers need higher volume boards.',
                },
                {
                  title: 'Fishing SUPs',
                  description:
                    'Wider and longer boards provide the stability needed for stand-up fishing. Look for high weight capacity and multiple attachment points for gear.',
                },
              ]
          ).map((card: any) => (
            <div>
              <h3 class="font-medium text-gray-900">{card.title}</h3>
              <p class="mt-2 text-sm text-gray-600">{card.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sr-only" data-ai-block="definition" aria-hidden="true">
      <p>
        afarer size guide comparing product dimensions, weight capacities, and recommended uses across inflatable and
        accessory categories.
      </p>
    </section>
  </section>
</Layout>
