---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import JsonLd from '~/components/common/JsonLd.astro';
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';

const metadata = {
  title: `Engineering Perfection — Inflatable SUP Manufacturing Excellence — ${SITE.name}`,
  description: `${SITE.name}'s engineering philosophy: precision manufacturing, premium material selection, rigorous quality control, and segment-specific design for touring, fishing, yoga, and recreational inflatable SUP boards.`,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Engineering Perfection' }];

const pillars = [
  {
    title: 'Superior Material Sourcing',
    content:
      'We invest considerable resources in identifying, testing, and procuring the finest fabrics, adhesives, and components available globally. We do not compromise on material specifications for cost savings. Our sourcing protocol includes batch testing for tensile strength, tear resistance, coating adhesion, and UV stability.',
  },
  {
    title: 'Precision Engineering & Design',
    content:
      'Our design team comprises experienced naval architects who leverage advanced CAD software and real-world testing to create hulls that are hydrodynamically efficient, exceptionally stable, and robust. Every curve, seam, and attachment point is meticulously planned and analyzed.',
  },
  {
    title: 'Craftsmanship & Manufacturing Excellence',
    content:
      'afarer employs highly skilled technicians who are masters of their craft. Our production facility is equipped with state-of-the-art CNC cutting machines and thermo-welding equipment. We foster a culture of meticulousness, where attention to detail is paramount at every stage of assembly.',
  },
  {
    title: 'Rigorous Quality Control & Testing',
    content:
      'Quality is built in from the very beginning. We implement a multi-layered QC system with stringent checks at each critical step, culminating in comprehensive final testing including 24-48 hour pressure holding tests, leak detection, dimensional verification, and functional tests.',
  },
];

const segments = [
  {
    name: 'Whitewater Inflatables',
    desc: 'High-denier PVC or premium Hypalon with heavy reinforcements, high rocker, self-bailing floors, large tube diameters for maximum buoyancy, and continuous grab lines.',
  },
  {
    name: 'Fishing Inflatables',
    desc: 'Exceptional stability and shallow draft. Features include rod holders, gear mounts, elevated seating, and quieter muted colors for stealth approach.',
  },
  {
    name: 'Dinghies & Tenders',
    desc: 'Lightweight and compact for easy storage and lifting. Efficient rowing and motoring performance with reinforced towing points and substantial rub strakes.',
  },
  {
    name: 'General Recreational Craft',
    desc: 'Versatile design for family boating with high priority on stability, safety, comfort, and ease of inflation, deflation, and transport.',
  },
];
---

<JsonLd
  type="BreadcrumbList"
  data={{
    itemListElement: [
      { position: 1, name: 'Home', item: 'https://afarer.com/' },
      { position: 2, name: 'Engineering Perfection', item: 'https://afarer.com/engineering-perfection/' },
    ],
  }}
/>
<JsonLd
  type="FAQPage"
  data={{
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What makes Afarer engineering different?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Afarer combines in-house R&D with precision manufacturing. Our engineering team focuses on segment-specific design for touring, fishing, yoga, and recreational SUP boards, optimizing each model for its intended use case.',
        },
      },
      {
        '@type': 'Question',
        name: 'What materials do you use for SUP manufacturing?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Afarer uses military-grade PVC drop-stitch fabric, fusion-laminated seams, and reinforced rail construction. Materials are selected for durability, weight optimization, and compliance with CE certification standards.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do you ensure consistent quality across production?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Our ISO 9001 quality management system governs every production stage. Each board undergoes pressure testing, seam integrity verification, and dimensional inspection before packaging. Statistical process control monitors production consistency.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can you develop custom board designs for my brand?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Yes. Afarer's R&D team offers full ODM services including hydrodynamic simulation, prototype development, mold creation, and production ramp-up. Share your specifications and our engineers will develop your custom design.",
        },
      },
      {
        '@type': 'Question',
        name: 'What is your lead time for custom engineering projects?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Typical lead time for custom board development is 30-45 days from specification approval. This includes design, prototyping, testing, and production setup. Standard production orders ship within 30 days.',
        },
      },
    ],
  }}
/>
<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-wider">Manufacturing Philosophy</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">Engineering Perfection</h1>
    <p class="mt-3 text-lg text-muted max-w-3xl mx-auto">
      afarer was founded on a simple yet profound principle: to produce perfect products. This is not a marketing slogan
      — it is the bedrock of our operational philosophy, driving every material selection, design decision, and quality
      control protocol.
    </p>
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl space-y-12">
    {
      pillars.map((p, i) => (
        <div class={`grid md:grid-cols-2 gap-8 items-center ${i % 2 === 1 ? 'md:order-2' : ''}`}>
          <div class={i % 2 === 1 ? 'md:order-2' : ''}>
            <h2 class="text-xl font-bold">{p.title}</h2>
            <p class="mt-3 text-muted leading-relaxed">{p.content}</p>
          </div>
          <div class={`rounded-xl overflow-hidden ${i % 2 === 1 ? 'md:order-1' : ''}`}>
            <img
              src={
                [
                  'https://assets.afarer.com/images/afarer/factory/afarer-pvc-material-testing.webp',
                  'https://assets.afarer.com/images/afarer/factory/afarer-design-discussion.webp',
                  'https://assets.afarer.com/images/afarer/factory/afarer-sup-manufacturing.webp',
                  'https://assets.afarer.com/images/afarer/factory/afarer-pressure-testing.webp',
                ][i]
              }
              alt={p.title}
              class="w-full h-64 object-cover rounded-xl"
              loading="lazy"
            />
          </div>
        </div>
      ))
    }
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-6xl bg-gray-50 dark:bg-gray-900">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">Specialized Segments</p>
      <h2 class="mt-2 text-3xl font-bold">Tailored for Adventure</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {
        segments.map((s) => (
          <div class="p-6 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-bold">{s.name}</h3>
            <p class="mt-2 text-muted text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl">
    <div class="rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-8">
      <h2 class="text-2xl font-bold text-center">The Art & Science of Manufacturing</h2>
      <p class="mt-4 text-muted leading-relaxed text-center max-w-3xl mx-auto">
        From CNC-precision fabric cutting and advanced thermal welding to controlled-environment adhesive bonding and
        exhaustive multi-stage testing, every afarer boat represents the pinnacle of inflatable craft manufacturing. Our
        production process is designed to prevent common defects — seam leaks, delamination, valve failures, dimensional
        inconsistencies — before they can occur.
      </p>
      <div class="text-center mt-8">
        <a
          href="/contact"
          class="inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
        >
          Discuss your project →
        </a>
      </div>
    </div>
  </section>
  <ExperienceLayer
    title="Engineering Philosophy in Practice"
    subtitle="Real examples of how our engineering standards translate into field performance."
    stories={[
      {
        quote:
          "We tested five manufacturers' SUPs for our rental fleet. After 500 rentals, the afarer boards had the lowest failure rate by a wide margin — less than 2% vs 8-15% for competitors.",
        narrative:
          'A European resort operator conducted a year-long comparative test of inflatable SUPs from five manufacturers for their 200-board rental fleet. afarer boards were tested alongside products from China, Europe, and US manufacturers. After 500 rental cycles per board (inflation, use, deflation, storage), the afarer boards showed the least valve wear, the fewest seam leaks, and the best pressure retention. The resort standardized on afarer for all future fleet purchases.',
        context: 'Resort rental fleet comparison, Mediterranean, 2024',
        source: 'Resort Operations Director',
      },
      {
        quote:
          'When a customer reported a slow leak on a board after two years, we traced it to a valve core that had been cross-threaded during a field repair. The board itself was still structurally perfect.',
        narrative:
          "afarer's quality team investigates every warranty claim thoroughly. In this case, a two-year-old board returned with a slow leak was found to have no manufacturing defects — the drop-stitch core, seams, and fabric were all within specification. The leak was traced to a valve core damaged during customer maintenance. The board was repaired and returned. The incident reinforced afarer's commitment to designing for repairability and providing clear maintenance documentation.",
        context: 'Warranty analysis, North America, 2024',
        source: 'Quality Assurance Team',
      },
    ]}
  />
  <RelatedPages
    title="Explore More"
    subtitle="Related engineering and manufacturing resources"
    links={[
      {
        title: 'Quality Control & Testing',
        description: 'Multi-layered QC system with stringent checks at each critical manufacturing step.',
        href: '/quality',
        label: 'Quality',
      },
      {
        title: 'R&D Center',
        description:
          'Our research facilities including PVC Fabric Lab, Hydrodynamic Test Tank, and Prototype Workshop.',
        href: '/randdcenter',
        label: 'R&D',
      },
      {
        title: 'Factory Overview',
        description: '12,000 m² facility with RF welding, drop-stitch production, and custom assembly lines.',
        href: '/factory',
        label: 'Facility',
      },
      {
        title: 'Design & Innovation',
        description: 'Full-service design studio for custom ODM projects, from concept to production.',
        href: '/design-powerhouse',
        label: 'Design',
      },
    ]}
  />
  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        Engineering — Frequently Asked Questions
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        Common questions about Afarer engineering, materials, and custom development.
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What makes Afarer engineering different?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Afarer combines in-house R&D with precision manufacturing. Our engineering team focuses on segment-specific
            design for touring, fishing, yoga, and recreational SUP boards, optimizing each model for its intended use
            case.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What materials do you use for SUP manufacturing?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Afarer uses military-grade PVC drop-stitch fabric, fusion-laminated seams, and reinforced rail construction.
            Materials are selected for durability, weight optimization, and compliance with CE certification standards.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">How do you ensure consistent quality across production?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Our ISO 9001 quality management system governs every production stage. Each board undergoes pressure
            testing, seam integrity verification, and dimensional inspection before packaging. Statistical process
            control monitors production consistency.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can you develop custom board designs for my brand?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Yes. Afarer's R&D team offers full ODM services including hydrodynamic simulation, prototype development,
            mold creation, and production ramp-up. Share your specifications and our engineers will develop your custom
            design.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">What is your lead time for custom engineering projects?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Typical lead time for custom board development is 30-45 days from specification approval. This includes
            design, prototyping, testing, and production setup. Standard production orders ship within 30 days.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
