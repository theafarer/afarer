---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';

const metadata = {
  title: 'Lightweight SUP Board | Ultra-Portable Inflatable Paddle Board | Afarer OEM Manufacturer',
  description:
    'Afarer lightweight SUP boards — ultra-portable inflatable paddle boards under 20 lbs. Easy to carry, pack, and travel with. Premium drop-stitch construction at half the weight. OEM/ODM manufacturing available for brands and retailers.',
  ignoreTitleTemplate: true,
};
const pageUrl = 'https://afarer.com/lightweight-sup/';
const today = '2026-07-27';
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    data={{
      headline: 'Lightweight SUP Board — Maximum Portability, Zero Compromise',
      description: metadata.description,
      datePublished: today,
      author: { '@type': 'Organization', name: 'Afarer' },
      url: pageUrl,
    }}
  />
  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { position: 1, name: 'Home', item: 'https://afarer.com/' },
        { position: 2, name: 'Inflatable SUP Boards', item: 'https://afarer.com/inflatable-sup/' },
        { position: 3, name: 'Lightweight SUP', item: pageUrl },
      ],
    }}
  />
  <JsonLd
    type="FAQPage"
    data={{
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How much does a lightweight SUP weigh?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Lightweight SUPs typically weigh between 16 and 20 lbs, significantly less than standard inflatable SUPs (22-28 lbs) and hard boards (25-40 lbs). The weight savings come from advanced materials and optimized drop-stitch layering.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are lightweight SUPs less durable?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Lightweight SUPs use advanced drop-stitch materials that maintain rigidity while reducing overall weight. Premium military-grade PVC and fusion-laminated seams ensure durability comparable to heavier boards.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can lightweight SUPs handle rough conditions?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Lightweight SUPs perform best on calm flatwater and moderate conditions. While durable, their lighter construction means they may flex more in challenging conditions like strong winds or rapids compared to heavier expedition-grade boards.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is a lightweight SUP good for beginners?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Lightweight SUPs are excellent for beginners because they are easy to carry, transport, and store. The lower weight makes the overall learning experience more enjoyable and less physically demanding.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you manufacture lightweight SUPs for private label?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Afarer offers OEM/ODM manufacturing for lightweight SUP boards with custom graphics, packaging, and weight specifications for brands targeting travelers and portability-focused paddlers.',
          },
        },
      ],
    }}
  />
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a
      href="/inflatable-sup/"
      class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-8 transition-colors"
      >← SUP Product Center</a
    >
    <div class="max-w-4xl">
      <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">SUP Category</span>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-secondary leading-[1.1]">
        Lightweight SUP Board
      </h1>
      <p class="mt-6 text-lg text-gray-500 max-w-3xl leading-relaxed">
        Weight matters. Afarer lightweight SUPs use advanced drop-stitch materials and optimized layering to shave
        pounds without sacrificing rigidity. At under 20 lbs, these boards are easy to carry from car to shore, pack
        into overhead luggage, and store in small apartments. Perfect for travelers, hikers, and paddlers who value
        portability.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Lightweight SUP Advantages</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Easy to Carry</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            At 18–20 lbs, you can carry your SUP with one hand. Ideal for paddlers who park far from the water or hike
            to remote launch spots.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">Travel-Ready Package</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Packs into a compact backpack that fits in car trunks, RV storage bays, and even overhead airline
            compartments.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-secondary">No Compromise on Rigidity</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Advanced 15 PSI drop-stitch cores deliver hard-board-like stiffness despite the reduced weight. You do not
            trade performance for portability.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">Lightweight SUP Recommendations</h2>
      <p class="text-gray-500 mb-8">
        All Afarer inflatable SUPs are lightweight by design. Our most portable options include:
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href="/products/sup-explorer-11"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-blue-50 to-cyan-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/afarer-sup-allround-board.webp"
              alt="SUP Explorer 11'"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">SUP Explorer 11'</h3>
            <p class="mt-2 text-sm text-gray-500">
              Class-leading lightweight design at just 18.5 lbs. Perfect for travelers and casual paddlers.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
        <a
          href="/products/sup-cheetah-surge"
          class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all"
        >
          <div class="aspect-[16/9] bg-gradient-to-br from-yellow-50 to-amber-50 overflow-hidden">
            <img
              src="https://assets.afarer.com/images/afarer/products/sup-series/sup-cheetah-surge-1.webp"
              alt="Cheetah Surge Edition"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">
              Cheetah Surge Edition
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              Ultra-lightweight performance design for paddlers who want speed and portability in one package.
            </p>
            <span class="inline-block mt-4 text-sm font-medium text-primary">View product →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="bg-gray-50 py-16 md:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-secondary">Who Is a Lightweight SUP For?</h2>
        <p class="mt-4 text-lg text-gray-500">Built for paddlers who value portability as much as performance.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Air Travelers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Lightweight SUPs pack into compact backpacks that fit airline luggage limits. Take your board to
            destinations worldwide without oversized baggage fees.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Hikers & Backpackers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Carry your SUP to remote lakes and launch spots. At under 20 lbs with backpack, it is practical to hike
            moderate distances to secluded paddling locations.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Small Space Dwellers</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Live in an apartment or condo? Lightweight SUPs pack into compact storage that fits closets, under beds, or
            car trunks.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-lg transition-all">
          <h3 class="text-lg font-bold text-secondary">Rental & Retail Programs</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Lightweight boards are easier for guests to handle, reducing damage and staff assistance needs. OEM custom
            branding available for retail and rental programs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OEM Section -->
  <section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">OEM/ODM Manufacturing for Lightweight SUPs</h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Afarer manufactures lightweight SUP boards for global brands and travel retailers. Our production lines produce
        CE-certified lightweight SUPs using advanced materials that reduce weight without compromising rigidity. MOQ
        from 50 units. Lead times from 30 days.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">Custom</span>
          <p class="mt-1 text-sm text-gray-500">Weight, graphics, packaging</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">50+</span>
          <p class="mt-1 text-sm text-gray-500">Units minimum order</p>
        </div>
        <div class="bg-[#F8FAFB] rounded-xl p-6 text-center border border-gray-200">
          <span class="text-2xl font-bold text-primary">30 Days</span>
          <p class="mt-1 text-sm text-gray-500">Typical lead time</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a
          href="/oem-odm-manufacturer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
          >Request OEM Quote <span>→</span></a
        >
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4 text-center">
        Lightweight SUP — Frequently Asked Questions
      </h2>
      <p class="text-lg text-gray-500 text-center mb-12">
        Common questions about choosing and using lightweight paddle boards.
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">How much does a lightweight SUP weigh?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Lightweight SUPs typically weigh between 16 and 20 lbs, significantly less than standard inflatable SUPs
            (22-28 lbs) and hard boards (25-40 lbs). The weight savings come from advanced materials and optimized
            drop-stitch layering.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Are lightweight SUPs less durable?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            No. Lightweight SUPs use advanced drop-stitch materials that maintain rigidity while reducing overall
            weight. Premium military-grade PVC and fusion-laminated seams ensure durability comparable to heavier
            boards.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Can lightweight SUPs handle rough conditions?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Lightweight SUPs perform best on calm flatwater and moderate conditions. While durable, their lighter
            construction means they may flex more in challenging conditions like strong winds or rapids compared to
            heavier expedition-grade boards.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Is a lightweight SUP good for beginners?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Yes. Lightweight SUPs are excellent for beginners because they are easy to carry, transport, and store. The
            lower weight makes the overall learning experience more enjoyable and less physically demanding.
          </p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-secondary">Do you manufacture lightweight SUPs for private label?</h3>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            Yes. Afarer offers OEM/ODM manufacturing for lightweight SUP boards with custom graphics, packaging, and
            weight specifications for brands targeting travelers and portability-focused paddlers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-secondary">Find Your Lightweight SUP</h2>
    <p class="mt-4 text-lg text-gray-500">Contact us for lightweight SUP options, bulk orders, or custom designs.</p>
    <a
      href="/contact"
      class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full shadow-lg transition-all"
      >Get a Quote <span>→</span></a
    >
  </section>
</Layout>
