---
import { getAdminSlugs } from '~/lib/admin-paths';
import AdminLayout from '~/layouts/AdminLayout.astro';
import ProductForm from '~/components/admin/ProductForm.astro';
import { verifySessionToken } from '~/lib/auth';
import { readTokenFromCookies } from '~/lib/token-store';
import { GitHubClient } from '~/lib/github';
import { parseMarkdown } from '~/lib/markdown';
import type { CollectionFormData } from '~/components/admin/types';
import FormDataLoader from '~/components/admin/FormDataLoader.astro';
export const prerender = true;
export async function getStaticPaths() {
  return getAdminSlugs('src/content/products').map(({ slug, ext }) => ({ params: { slug }, props: { ext } }));
}

const session = Astro.cookies.get('ks-admin-session')?.value;
const verified = session ? verifySessionToken(session) : null;
const token = readTokenFromCookies(Astro.cookies);

const filename = Astro.params.slug;
const ext = Astro.props.ext || '.md';

let initial: CollectionFormData = { frontmatter: {}, body: '' };
let sha = '';
let filePath = filename ? `src/content/products/${filename}${ext}` : '';

if (filePath) {
  if (token) {
    try {
      const client = new GitHubClient(token);
      const file = await client.readFile(filePath);
      const parsed = parseMarkdown(file.content);
      sha = file.sha;
      initial = {
        frontmatter: {
          title: '',
          category: 'inflatable',
          inStock: true,
          ...parsed.frontmatter,
        },
        body: parsed.body,
      };
    } catch {
      /* ignore */
    }
  }
}
---

<AdminLayout title={`Edit: ${initial.frontmatter.title ?? filename}`} active="products" username={verified?.username}>
  <div class="mb-6">
    <a href="/keystatic/products" class="text-sm text-gray-500 hover:underline"> ?Back to Products list</a>
    <h1 class="mt-2 text-2xl font-semibold">Edit: {initial.frontmatter.title ?? filename}</h1>
    <p class="mt-1 text-sm text-gray-500 font-mono">{filePath}</p>
  </div>
  <ProductForm mode="edit" initial={initial} filename={filename} sha={sha} path={filePath} locale="en" />

  <div class="flex items-center gap-3 mt-6 pb-8">
    <button
      id="save-draft-btn"
      type="button"
      class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md">Save Draft</button
    >
    <button
      id="publish-btn"
      type="button"
      class="px-5 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md">Publish</button
    >
    <button
      id="delete-btn"
      type="button"
      class="px-5 py-2 bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 text-sm font-medium border border-gray-300 dark:border-gray-700 rounded-md text-red-600 dark:text-red-400 ml-auto"
      >Delete</button
    >
  </div>

  <script is:inline>
    (function () {
      const form = document.getElementById('entry-form');
      if (!form) return;
      const saveBtn = document.getElementById('save-draft-btn');
      const publishBtn = document.getElementById('publish-btn');
      const deleteBtn = document.getElementById('delete-btn');
      const file = form.dataset.file || '';

      function serializeFrontmatter(fm) {
        let yaml = '---\n';
        Object.keys(fm).forEach(function (k) {
          const v = fm[k];
          if (v === undefined || v === null) return;
          if (Array.isArray(v)) {
            if (v.length === 0) return;
            if (typeof v[0] === 'object') {
              yaml += k + ':\n';
              v.forEach(function (item) {
                yaml += '  - ' + JSON.stringify(item) + '\n';
              });
            } else {
              yaml += k + ':\n';
              v.forEach(function (item) {
                yaml += '  - "' + String(item).replace(/"/g, '\\"') + '"\n';
              });
            }
          } else if (typeof v === 'object') {
            const keys = Object.keys(v).filter(function (sk) {
              return v[sk] !== undefined && v[sk] !== null;
            });
            if (keys.length === 0) return;
            yaml += k + ':\n';
            keys.forEach(function (sk) {
              const sv = v[sk];
              if (typeof sv === 'boolean' || typeof sv === 'number') yaml += '  ' + sk + ': ' + sv + '\n';
              else yaml += '  ' + sk + ': "' + String(sv).replace(/"/g, '\\"') + '"\n';
            });
          } else if (typeof v === 'boolean') {
            yaml += k + ': ' + v + '\n';
          } else if (typeof v === 'number') {
            yaml += k + ': ' + v + '\n';
          } else {
            yaml += k + ': "' + String(v).replace(/"/g, '\\"') + '"\n';
          }
        });
        yaml += '---\n';
        return yaml;
      }

      function collectFrontmatter(data) {
        const tags = data
          .getAll('tags')
          .map(function (v) {
            return v.toString().trim();
          })
          .filter(Boolean);
        const environment = data
          .getAll('environment')
          .map(function (v) {
            return v.toString().trim();
          })
          .filter(Boolean);
        const water_condition = data
          .getAll('water_condition')
          .map(function (v) {
            return v.toString().trim();
          })
          .filter(Boolean);
        const ai_use_cases = data
          .getAll('ai_use_cases')
          .map(function (v) {
            return v.toString().trim();
          })
          .filter(Boolean);
        const galleryRows = Array.from(document.querySelectorAll('[data-gallery-row]'));
        const gallery = galleryRows
          .map(function (row) {
            return {
              url: row.querySelector('input[name="galleryUrl"]')?.value?.toString().trim() || '',
              alt: row.querySelector('input[name="galleryAlt"]')?.value?.toString().trim() || '',
            };
          })
          .filter(function (g) {
            return g.url;
          });
        const specsRows = Array.from(document.querySelectorAll('[data-specs-row]'));
        const specs = specsRows
          .map(function (row) {
            return {
              label: row.querySelector('input[name="specLabel"]')?.value?.toString().trim() || '',
              value: row.querySelector('input[name="specValue"]')?.value?.toString().trim() || '',
            };
          })
          .filter(function (s) {
            return s.label;
          });
        const faqRows = Array.from(document.querySelectorAll('[data-ai-faq-row]'));
        const ai_faq = faqRows
          .map(function (row) {
            return {
              q: row.querySelector('input[name="ai_faq_q"]')?.value?.toString().trim() || '',
              a: row.querySelector('input[name="ai_faq_a"]')?.value?.toString().trim() || '',
            };
          })
          .filter(function (f) {
            return f.q;
          });
        const aiSpecsRows = Array.from(document.querySelectorAll('[data-ai-specs-row]'));
        const ai_specs = {};
        aiSpecsRows.forEach(function (row) {
          const k = row.querySelector('input[name="ai_specs_key"]')?.value?.toString().trim();
          const v = row.querySelector('input[name="ai_specs_value"]')?.value?.toString().trim();
          if (k) ai_specs[k] = v || '';
        });

        const fm = {
          title: (data.get('title') || '').toString().trim(),
          publishDate: data.get('publishDate')?.toString() || undefined,
          draft: data.get('draft') === 'true',
          inStock: data.get('inStock') === 'true',
          featured: data.get('featured') === 'true',
        };
        const sku = data.get('sku')?.toString().trim();
        if (sku) fm.sku = sku;
        const summary = data.get('summary')?.toString().trim();
        if (summary) fm.summary = summary;
        const description = data.get('description')?.toString().trim();
        if (description) fm.description = description;
        const image = data.get('image')?.toString().trim();
        if (image) fm.image = image;
        fm.category = data.get('category')?.toString() || 'inflatable';
        if (gallery.length) fm.gallery = gallery;
        if (specs.length) fm.specs = specs;

        const priceAmount = data.get('priceAmount')?.toString().trim();
        const priceCurrency = data.get('priceCurrency')?.toString().trim();
        const priceNote = data.get('priceNote')?.toString().trim();
        const price = {};
        if (priceAmount) price.amount = priceAmount;
        if (priceCurrency) price.currency = priceCurrency;
        if (priceNote) price.note = priceNote;
        if (Object.keys(price).length) fm.price = price;
        if (tags.length) fm.tags = tags;

        const definition = data.get('definition')?.toString().trim();
        if (definition) fm.definition = definition;
        const problem = data.get('problem')?.toString().trim();
        if (problem) fm.problem = problem;
        const howItWorks = data.get('howItWorks')?.toString().trim();
        if (howItWorks) fm.howItWorks = howItWorks;
        const audience = data.get('audience')?.toString().trim();
        if (audience) fm.audience = audience;
        const skill = data.get('skill')?.toString().trim();
        if (skill) fm.skill = skill;
        if (ai_use_cases.length) fm.ai_use_cases = ai_use_cases;
        const ai_comparison = data.get('ai_comparison')?.toString().trim();
        if (ai_comparison) fm.ai_comparison = ai_comparison;
        if (ai_faq.length) fm.ai_faq = ai_faq;
        if (Object.keys(ai_specs).length) fm.ai_specs = ai_specs;
        if (environment.length) fm.environment = environment;
        if (water_condition.length) fm.water_condition = water_condition;

        const metadata = {};
        const seoTitle = data.get('seoTitle')?.toString().trim();
        const seoDescription = data.get('seoDescription')?.toString().trim();
        const seoCanonical = data.get('seoCanonical')?.toString().trim();
        if (seoTitle) metadata.title = seoTitle;
        if (seoDescription) metadata.description = seoDescription;
        if (seoCanonical) metadata.canonical = seoCanonical;
        if (data.get('seoIgnoreTitleTemplate') === 'true') metadata.ignoreTitleTemplate = true;
        const robots = {};
        if (data.get('seoRobotIndex') !== 'true') robots.index = false;
        if (data.get('seoRobotFollow') !== 'true') robots.follow = false;
        if (Object.keys(robots).length) metadata.robots = robots;
        const og = {};
        const ogUrl = data.get('seoOgUrl')?.toString().trim();
        const ogSiteName = data.get('seoOgSiteName')?.toString().trim();
        const ogLocale = data.get('seoOgLocale')?.toString().trim();
        const ogType = data.get('seoOgType')?.toString().trim();
        if (ogUrl) og.url = ogUrl;
        if (ogSiteName) og.siteName = ogSiteName;
        if (ogLocale) og.locale = ogLocale;
        if (ogType) og.type = ogType;
        if (Object.keys(og).length) metadata.openGraph = og;
        const tw = {};
        const twHandle = data.get('seoTwitterHandle')?.toString().trim();
        const twSite = data.get('seoTwitterSite')?.toString().trim();
        const twCard = data.get('seoTwitterCardType')?.toString().trim();
        if (twHandle) tw.handle = twHandle;
        if (twSite) tw.site = twSite;
        if (twCard) tw.cardType = twCard;
        if (Object.keys(tw).length) metadata.twitter = tw;
        if (Object.keys(metadata).length) fm.metadata = metadata;

        return fm;
      }

      function collectTranslatable(data) {
        const ai_use_cases = data
          .getAll('ai_use_cases')
          .map(function (v) {
            return v.toString().trim();
          })
          .filter(Boolean);
        const faqRows = Array.from(document.querySelectorAll('[data-ai-faq-row]'));
        const ai_faq = faqRows
          .map(function (row) {
            return {
              q: row.querySelector('input[name="ai_faq_q"]')?.value?.toString().trim() || '',
              a: row.querySelector('input[name="ai_faq_a"]')?.value?.toString().trim() || '',
            };
          })
          .filter(function (f) {
            return f.q;
          });
        const t = {
          name: data.get('title')?.toString().trim() || '',
          summary: data.get('summary')?.toString().trim() || undefined,
          desc: data.get('description')?.toString().trim() || undefined,
          definition: data.get('definition')?.toString().trim() || undefined,
          problem: data.get('problem')?.toString().trim() || undefined,
          howItWorks: data.get('howItWorks')?.toString().trim() || undefined,
          audience: data.get('audience')?.toString().trim() || undefined,
          ai_comparison: data.get('ai_comparison')?.toString().trim() || undefined,
        };
        Object.keys(t).forEach(function (k) {
          if (!t[k]) delete t[k];
        });
        if (ai_use_cases.length) t.ai_use_cases = ai_use_cases;
        if (ai_faq.length) t.ai_faq = ai_faq;
        return t;
      }

      async function save(branch) {
        const data = new FormData(form);
        const title = (data.get('title') || '').toString().trim();
        if (!title) {
          window.__adminToast?.('Product name is required', 'error');
          return;
        }
        const sha = data.get('_sha')?.toString() || form.dataset.sha || '';
        const locale = data.get('_locale')?.toString() || 'en';

        if (locale !== 'en') {
          const slug = file.replace(/^.*[/\\]/, '').replace(/\.(md|mdx)$/, '');
          const yamlPath = 'src/data/product-texts/' + locale + '/' + slug + '.yaml';
          const transData = collectTranslatable(data);
          const yamlSha = form.dataset.sha || '';
          const reqBody = {
            path: yamlPath,
            data: transData,
            format: 'yaml',
            message: 'Update ' + locale + ' translation: ' + title,
            branch: branch || 'draft',
          };
          if (yamlSha) reqBody.sha = yamlSha;
          saveBtn.disabled = true;
          saveBtn.textContent = 'Saving...';
          try {
            const res = await fetch('/api/admin/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(reqBody),
            });
            const result = await res.json();
            if (!res.ok || !result.success) {
              window.__adminToast?.(result.error || 'Save failed', 'error');
              saveBtn.disabled = false;
              saveBtn.textContent = 'Save Draft';
              return;
            }
            if (result?.content?.sha) {
              form.dataset.sha = result.content.sha;
            }
            window.__adminToast?.('Translation saved', 'success');
          } catch {
            window.__adminToast?.('Network error', 'error');
          }
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Draft';
          return;
        }

        const fm = collectFrontmatter(data);
        const body = data.get('body')?.toString() || '';
        const content = serializeFrontmatter(fm) + '\n' + body;
        const path = data.get('_path')?.toString() || file;

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        try {
          const res = await fetch('/api/admin/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: path,
              content: content,
              sha: sha,
              message: 'Draft: Update product: ' + title,
              branch: branch || 'draft',
            }),
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Save failed', 'error');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Draft';
            return;
          }
          if (result?.content?.sha) {
            form.dataset.sha = result.content.sha;
          }
          window.__adminToast?.('Draft saved', 'success');
        } catch {
          window.__adminToast?.('Network error', 'error');
        }
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Draft';
      }

      saveBtn.addEventListener('click', function () {
        save('draft');
      });
      publishBtn.addEventListener('click', async function () {
        publishBtn.disabled = true;
        publishBtn.textContent = 'Publishing...';
        try {
          const res = await fetch('/api/admin/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Publish failed', 'error');
            publishBtn.textContent = 'Publish';
            publishBtn.disabled = false;
            return;
          }
          window.__adminToast?.('Published!', 'success');
          setTimeout(function () {
            window.location.reload();
          }, 800);
        } catch {
          window.__adminToast?.('Network error', 'error');
          publishBtn.textContent = 'Publish';
          publishBtn.disabled = false;
        }
      });
      deleteBtn.addEventListener('click', async function () {
        if (!confirm('Delete this product permanently?')) return;
        const sha = form.dataset.sha || '';
        if (!sha) {
          window.__adminToast?.('No SHA — cannot delete', 'error');
          return;
        }
        deleteBtn.disabled = true;
        try {
          const res = await fetch('/api/admin/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: file, sha: sha, message: 'Delete product' }),
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Delete failed', 'error');
            deleteBtn.disabled = false;
            return;
          }
          window.__adminToast?.('Deleted', 'success');
          setTimeout(function () {
            window.location.href = '/keystatic/products';
          }, 600);
        } catch {
          window.__adminToast?.('Network error', 'error');
          deleteBtn.disabled = false;
        }
      });
    })();
  </script>
  <FormDataLoader />
</AdminLayout>
