---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght.css';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 109 143);
    --aw-color-secondary: rgb(7 30 45);
    --aw-color-accent: rgb(0 136 179);

    --aw-color-text-heading: rgb(7 30 45);
    --aw-color-text-default: rgb(30 41 59);
    --aw-color-text-muted: rgb(100 116 139 / 80%);
    --aw-color-bg-page: rgb(248 250 252);
    --aw-color-bg-page-dark: rgb(7 30 45);

    ::selection {
      background-color: rgb(0 109 143 / 20%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 136 179);
    --aw-color-secondary: rgb(0 109 143);
    --aw-color-accent: rgb(56 189 217);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(220 224 230);
    --aw-color-text-muted: rgb(180 185 195 / 72%);
    --aw-color-bg-page: rgb(7 30 45);

    ::selection {
      background-color: rgb(0 136 179 / 30%);
    }
  }
</style>
