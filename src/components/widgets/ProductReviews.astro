---
import Stars from '~/components/common/Stars.astro';
import Icon from '~/components/ui/Icon.astro';
import { getReviews, getRatingStats } from '~/data/reviews';
import { getLangFromUrl } from '~/i18n/utils';
import { getUiForLang } from '~/i18n/generated/ui-all';

export interface Props {
  productId: string;
}

const { productId } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const _ = (k: string, fallback = '') => getUiForLang(currentLang)?.[k] || getUiForLang('en')?.[k] || fallback;

const reviews = getReviews(productId);
const stats = getRatingStats(productId);
---

{
  stats && reviews.length > 0 ? (
    <section
      class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800"
      data-section="reviews"
      aria-label={_('reviews.title', 'Customer Reviews')}
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
          {_('reviews.title', 'Customer Reviews')}
        </h2>

        <div class="flex items-center gap-3 mb-8 p-4 bg-gray-50 dark:bg-slate-800/50 rounded-xl">
          <Stars rating={stats.avg} size="md" showValue />
          <span class="text-sm text-gray-500 dark:text-slate-400">
            ({stats.count} {_('reviews.count', 'reviews')})
          </span>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          {reviews.map((r) => (
            <article class="flex flex-col bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-100 dark:border-slate-700 p-5">
              <Stars rating={r.rating} size="sm" class="mb-3" />
              <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1.5">{r.title}</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{r.text}</p>
              <div class="mt-4 pt-3 border-t border-gray-200 dark:border-slate-700 flex items-center justify-between gap-2">
                <div class="text-xs text-gray-500 dark:text-slate-500">
                  <span class="font-medium text-gray-700 dark:text-slate-300">{r.author}</span>
                  <span>
                    {' '}
                    · {r.country} · {r.date}
                  </span>
                </div>
                {r.verified && (
                  <span class="inline-flex items-center gap-1 text-[11px] font-medium text-primary whitespace-nowrap">
                    <Icon name="tabler:circle-check-filled" class="w-3.5 h-3.5" />
                    {_('reviews.verified', 'Verified buyer')}
                  </span>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : null
}
