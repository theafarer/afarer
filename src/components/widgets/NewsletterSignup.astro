---
export interface Props {
  title?: string;
  subtitle?: string;
  placeholder?: string;
  buttonText?: string;
}

const { title = 'Stay Updated', subtitle = 'Get the latest industry insights, OEM guides, and product updates delivered to your inbox.', placeholder = 'Your email address', buttonText = 'Subscribe' } = Astro.props;
---

<section class="bg-gradient-to-br from-sky-50 to-blue-50 dark:from-slate-800 dark:to-slate-900 rounded-3xl p-8 md:p-12 my-12 border border-sky-100 dark:border-slate-700">
  <div class="max-w-2xl mx-auto text-center">
    <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">{title}</h3>
    <p class="mt-3 text-gray-500 dark:text-slate-400">{subtitle}</p>
    <form class="mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto" data-newsletter-form>
      <input type="email" name="email" required placeholder={placeholder} class="flex-1 px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-transparent outline-none" />
      <input type="hidden" name="subject" value="Newsletter Signup" />
      <input type="hidden" name="message" value="Newsletter subscription request from website." />
      <input type="text" name="email_confirm" class="absolute left-[-9999px] top-[-9999px] opacity-0" tabindex="-1" aria-hidden="true" autocomplete="off" />
      <button type="submit" class="px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl transition-colors whitespace-nowrap">{buttonText}</button>
    </form>
    <p class="mt-3 text-xs text-gray-400 dark:text-slate-500">No spam. Unsubscribe anytime.</p>
    <div data-newsletter-status class="mt-3 text-sm hidden"></div>
  </div>
</section>

<script is:inline>
  (function () {
    const forms = document.querySelectorAll('form[data-newsletter-form]');
    forms.forEach(function (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const status = form.querySelector('[data-newsletter-status]');
        if (!status) return;
        status.classList.add('hidden');
        const fd = new FormData(form);
        try {
          const res = await fetch('/api/contact', { method: 'POST', body: fd });
          const data = await res.json();
          if (res.ok) {
            status.textContent = 'Thanks for subscribing! Check your inbox for confirmation.';
            status.className = 'mt-3 text-sm text-green-600 dark:text-green-400';
            form.reset();
          } else {
            status.textContent = data?.error || 'Something went wrong. Please try again.';
            status.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
          }
        } catch {
          status.textContent = 'Network error. Please try again.';
          status.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
        }
        status.classList.remove('hidden');
      });
    });
  })();
</script>
