---
export interface Props {
  testimonials: Array<{ name: string; quote: string; rating?: number; title?: string; avatar?: string }>;
  title?: string;
  subtitle?: string;
}

const { testimonials, title, subtitle } = Astro.props;

function stars(n: number): string {
  return Array.from({ length: 5 }, (_, i) => (i < n ? '\u2605' : '\u2606')).join('');
}
---

<section class="py-16 px-6">
  <div class="max-w-4xl mx-auto">
    {(title || subtitle) && (
      <div class="text-center mb-12">
        {title && <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">{title}</h2>}
        {subtitle && <p class="mt-3 text-lg text-gray-500 dark:text-slate-400">{subtitle}</p>}
      </div>
    )}

    <div class="relative" data-testimonial-carousel>
      <div class="overflow-hidden rounded-2xl">
        <div class="flex transition-transform duration-500 ease-in-out" data-testimonial-track>
          {testimonials.map((t) => (
            <div class="w-full flex-shrink-0 px-4">
              <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl p-8 md:p-10 text-center">
                {t.rating && <div class="text-yellow-400 text-lg mb-4">{stars(t.rating)}</div>}
                <blockquote class="text-lg md:text-xl text-gray-600 dark:text-slate-300 leading-relaxed italic">"{t.quote}"</blockquote>
                <div class="mt-6">
                  {t.avatar && <img src={t.avatar} alt="" class="w-12 h-12 rounded-full mx-auto object-cover" />}
                  <div class="mt-3 font-semibold text-gray-900 dark:text-white">{t.name}</div>
                  {t.title && <div class="text-sm text-gray-500 dark:text-slate-400">{t.title}</div>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {testimonials.length > 1 && (
        <div class="flex justify-center gap-2 mt-6">
          {testimonials.map((_, i) => (
            <button type="button" data-testimonial-dot={i} class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-slate-600 transition-colors hover:bg-sky-500" aria-label={`Go to testimonial ${i + 1}`}></button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var carousels = document.querySelectorAll('[data-testimonial-carousel]');
    carousels.forEach(function (el) {
      var track = el.querySelector('[data-testimonial-track]');
      var dots = el.querySelectorAll('[data-testimonial-dot]');
      if (!track || !dots.length) return;
      var current = 0;
      var total = dots.length;
      var timer = null;

      function goTo(index) {
        current = index;
        track.style.transform = 'translateX(-' + (current * 100) + '%)';
        dots.forEach(function (d, i) {
          d.classList.toggle('bg-sky-500', i === current);
          d.classList.toggle('bg-gray-300', i !== current);
        });
      }

      function next() { goTo((current + 1) % total); }

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          goTo(i);
          if (timer) { clearInterval(timer); }
          timer = setInterval(next, 5000);
        });
      });

      goTo(0);
      timer = setInterval(next, 5000);
    });
  })();
</script>
