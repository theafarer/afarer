---
import { getLangFromUrl } from '~/i18n/utils';

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  delay?: number;
}

const { title, subtitle, buttonText, buttonHref, delay = 3000 } = Astro.props;

const currentLocale = getLangFromUrl(Astro.url);
const fr = currentLocale === 'fr';
const es = currentLocale === 'es';
const popupTitle =
  title ??
  (fr
    ? 'Avant de partir — Téléchargez notre guide OEM'
    : es
      ? 'Antes de irte — Descarga nuestra guía OEM'
      : 'Before You Go — Download Our OEM Guide');
const popupSubtitle =
  subtitle ??
  (fr
    ? 'Découvrez comment lancer votre marque de SUP en marque blanche grâce à notre livre blanc complet sur la fabrication. 42 pages couvrant la conception des moules, le contrôle qualité, la conformité et la logistique.'
    : es
      ? 'Descubre cómo lanzar tu marca de SUP de marca privada con nuestro libro blanco completo de fabricación. 42 páginas que cubren diseño de moldes, control de calidad, cumplimiento y logística.'
      : 'Learn how to launch your private label SUP brand with our complete manufacturing white paper. 42 pages covering mold design, QC, compliance, and logistics.');
const popupButtonText =
  buttonText ?? (fr ? 'Télécharger le guide gratuit' : es ? 'Descargar la guía gratis' : 'Download Free Guide');
const popupButtonHref = buttonHref ?? `/${currentLocale}/whitepaper/oem-sup-manufacturing-guide`;
const bullets = fr
  ? [
      '10 chapitres couvrant chaque étape de la production OEM',
      'Check-list d’audit d’usine et modèles de NDA inclus',
      'Études de cas réelles de lancements de marques, avec budgets',
    ]
  : es
    ? [
        '10 capítulos que cubren cada etapa de la producción OEM',
        'Checklist de auditoría de fábrica y plantillas de NDA incluidas',
        'Casos reales de lanzamiento de marcas, con presupuestos',
      ]
    : [
        '10 chapters covering every stage of OEM production',
        'Factory audit checklist & NDA templates included',
        'Real brand launch case studies with budgets',
      ];
---

<div
  id="exit-intent-overlay"
  data-delay={delay}
  class="fixed inset-0 z-[100] bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4"
>
  <div
    class="bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full shadow-2xl overflow-hidden relative animate-fade-in-up"
  >
    <button
      type="button"
      id="exit-intent-close"
      class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 dark:bg-slate-800 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors z-10"
      aria-label="Close"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>

    <div class="p-8 md:p-10">
      <div
        class="w-14 h-14 bg-sky-100 dark:bg-sky-900/40 rounded-2xl flex items-center justify-center text-sky-600 dark:text-sky-400 mb-6"
      >
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path></svg
        >
      </div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{popupTitle}</h3>
      <p class="mt-3 text-gray-500 dark:text-slate-400 leading-relaxed">{popupSubtitle}</p>

      <div class="mt-6 space-y-3">
        {
          bullets.map((b) => (
            <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-slate-300">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{b}</span>
            </div>
          ))
        }
      </div>

      <a
        href={popupButtonHref}
        class="mt-6 block w-full text-center px-6 py-3.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl transition-colors"
      >
        {popupButtonText} →
      </a>
      <button
        type="button"
        id="exit-intent-dismiss"
        class="mt-3 w-full text-center text-sm text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 transition-colors"
      >
        {
          fr
            ? 'Non merci, je vais continuer à explorer le site'
            : es
              ? 'No gracias, seguiré explorando el sitio'
              : 'No thanks, I’ll explore the site'
        }
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.4s ease-out;
  }
</style>

<script is:inline>
  (function () {
    const overlay = document.getElementById('exit-intent-overlay');
    const closeBtn = document.getElementById('exit-intent-close');
    const dismissBtn = document.getElementById('exit-intent-dismiss');
    let shown = false;
    const delayMs = parseInt(overlay.getAttribute('data-delay') || '3000', 10);
    let timer = null;

    function show() {
      if (shown) return;
      shown = true;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    }

    function hide() {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      if (timer) {
        clearTimeout(timer);
        timer = null;
      }
    }

    // Exit intent: mouse leaves viewport from top
    document.addEventListener('mouseleave', function (e) {
      if (shown) return;
      if (e.clientY > 0) return;
      timer = setTimeout(show, 300);
    });

    // Close handlers
    if (closeBtn) closeBtn.addEventListener('click', hide);
    if (dismissBtn) dismissBtn.addEventListener('click', hide);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) hide();
    });

    // Also show after delay if not shown
    setTimeout(function () {
      if (!shown) show();
    }, delayMs * 2);
  })();
</script>
