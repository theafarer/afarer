---
// Photo-forward "On the Water" section for SUP category pages.
// All text props are supplied pre-localized by the caller (root pages pass EN,
// [lang] pages pass their landing-i18n resolved strings) so this component
// stays free of i18n lookups.
export interface ScenarioPhotoProp {
  src: string;
  alt: string;
}

interface Props {
  kicker?: string;
  title: string;
  descriptionTitle?: string;
  description: string;
  instructionsTitle?: string;
  instructions: string;
  photos: ScenarioPhotoProp[];
  href?: string;
  hrefLabel?: string;
}

const {
  kicker = 'On the Water',
  title,
  descriptionTitle = 'Where It Shines',
  description,
  instructionsTitle = 'How to Ride It',
  instructions,
  photos,
  href,
  hrefLabel = 'Learn more',
} = Astro.props;
---

<section class="max-w-6xl mx-auto py-16 md:py-24 px-6">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <span class="text-xs font-semibold text-primary tracking-[0.25em] uppercase">{kicker}</span>
    <h2 class="mt-4 text-4xl md:text-5xl font-bold text-secondary">{title}</h2>
  </div>
  <div class="grid md:grid-cols-2 gap-10 items-center">
    <div class:list={['grid gap-4', photos.length >= 2 ? 'grid-cols-2' : 'grid-cols-1']}>
      {
        photos.map((photo, index) => (
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class:list={[
              'w-full rounded-2xl object-cover',
              photos.length === 1 && 'aspect-[4/3]',
              photos.length === 2 && 'aspect-square',
              photos.length >= 3 && index === 0 && 'col-span-2 aspect-[3/2]',
              photos.length >= 3 && index > 0 && 'aspect-square',
            ]}
          />
        ))
      }
    </div>
    <div class="space-y-6">
      <div class="bg-white border border-gray-200 rounded-2xl p-8">
        <h3 class="text-lg font-bold text-secondary">{descriptionTitle}</h3>
        <p class="mt-3 text-sm text-gray-500 leading-relaxed">{description}</p>
      </div>
      <div class="bg-white border border-gray-200 rounded-2xl p-8">
        <h3 class="text-lg font-bold text-secondary">{instructionsTitle}</h3>
        <p class="mt-3 text-sm text-gray-500 leading-relaxed">{instructions}</p>
      </div>
      {
        href && (
          <a
            href={href}
            class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-[#0088B3] transition-colors"
          >
            {hrefLabel} <span>→</span>
          </a>
        )
      }
    </div>
  </div>
</section>
