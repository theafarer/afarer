---
/* eslint-disable @typescript-eslint/no-explicit-any */

import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import { getLangFromUrl } from '~/i18n/utils';
import { getUiForLang } from '~/i18n/generated/ui-all';

const _locale = getLangFromUrl(Astro.url);
const _ui = (key: string, fallback: string) => getUiForLang(_locale)?.[key] || fallback;

interface FieldOption {
  value: string;
  label: string;
}

interface Field {
  name: string;
  label: string;
  row: number;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  withCountryCode?: boolean;
  rows?: number;
  placeholder?: string;
  optionsKey?: string;
  options?: FieldOption[];
  step?: number;
}

interface ConsentConfig {
  required?: boolean;
  text?: string;
  link_text?: string;
  link_href?: string;
  error_message?: string;
}

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  emailTo?: string;
  submitButton?: string;
  successMessage?: string;
  errorMessage?: string;
  fields?: Field[];
  consent?: ConsentConfig;
  defaultCountryCode?: string;
  countryCodes?: Array<{ code: string; label: string }>;
  countries?: FieldOption[];
  isDark?: boolean;
  classes?: { container?: string };
  bg?: any;
}

const {
  id = 'form',
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  emailTo = '',
  submitButton = _ui('contact.submit', 'Send message'),
  successMessage = _ui('contact.success', 'Thanks! Your message has landed in our inbox.'),
  errorMessage = _ui('contact.error', 'Something went wrong. Please try again.'),
  fields = [],
  consent,
  defaultCountryCode = '+1',
  countryCodes = [],
  countries = [],
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const consentRequired = consent?.required === true;
const consentText =
  consent?.text || _ui('contact.consent', 'I agree to the processing of my personal data in accordance with the');
const consentLinkText = consent?.link_text || _ui('contact.privacyLink', 'Privacy Policy');
const consentLinkHref = consent?.link_href || '/privacy';
const consentError =
  consent?.error_message ||
  _ui('contact.consentError', 'Please confirm that you accept the Privacy Policy before submitting.');

const resolveOptions = (f: Field): FieldOption[] => {
  if (Array.isArray(f.options) && f.options.length > 0) return f.options;
  if (f.optionsKey === 'countries') return countries;
  return [];
};

const maxStep = Math.max(...fields.map((f) => f.step ?? 1), 1);
const steps: { title: string; fields: Field[] }[] = [];
for (let s = 1; s <= maxStep; s++) {
  const stepFields = fields.filter((f) => (f.step ?? 1) === s);
  if (stepFields.length === 0) continue;
  steps.push({ title: '', fields: stepFields });
}
const stepLabels = [
  _ui('contact.step1', 'Project Details'),
  _ui('contact.step2', 'Contact Information'),
  _ui('contact.step3', 'Message'),
];

const grouped: Record<number, Field[]> = {};
for (const f of fields) {
  if (!grouped[f.row]) grouped[f.row] = [];
  grouped[f.row].push(f);
}
const rows = Object.keys(grouped)
  .map((k) => Number(k))
  .sort((a, b) => a - b);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div
    class="flex flex-col max-w-2xl mx-auto rounded-lg backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow p-4 sm:p-6 lg:p-8 w-full"
  >
    <form
      id={id}
      method="POST"
      action="/api/contact"
      class="space-y-7"
      data-contact-form
      data-multistep={steps.length > 1 ? 'true' : 'false'}
      data-success-message={successMessage}
      data-error-message={errorMessage}
    >
      <input type="hidden" name="email_to" value={emailTo} />
      <div
        aria-hidden="true"
        style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"
      >
        <label for={`${id}-email-confirm`}>Do not fill this</label>
        <input id={`${id}-email-confirm`} type="text" name="email_confirm" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Step Indicator -->
      {steps.length > 1 && (
        <div class="flex items-center justify-center gap-2 mb-6" data-step-indicator>
          {steps.map((_, i) => (
            <div class="flex items-center">
              <div
                class={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition-colors ${i === 0 ? 'bg-primary text-white' : 'bg-gray-200 dark:bg-slate-700 text-muted'}`}
                data-step-dot={i + 1}
              >
                {i + 1}
              </div>
              {i < steps.length - 1 && <div class="w-8 h-px bg-gray-200 dark:bg-slate-700" />}
            </div>
          ))}
        </div>
      )}

      <div data-form-fields>
        {steps.length > 1 ? (
          steps.map((step, si) => (
            <div data-step={si + 1} style={{ display: si === 0 ? 'block' : 'none' }}>
              <div class="space-y-7">
                {(() => {
                  const stepRows = [...new Set(step.fields.map((f) => f.row))].sort((a, b) => a - b);
                  return stepRows.map((rowIdx) => {
                    const row = step.fields.filter((f) => f.row === rowIdx);
                    const isWide = row.length === 1 && (row[0].type === 'textarea' || row[0].type === 'text' || row[0].type === 'email');
                    if (isWide) {
                      const f = row[0];
                      if (f.type === 'textarea') {
                        return (
                          <div>
                            <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                            <textarea id={`${id}-${f.name}`} name={f.name} rows={f.rows ?? 4} placeholder={f.placeholder} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                          </div>
                        );
                      }
                      return (
                        <div>
                          <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                          <input id={`${id}-${f.name}`} type={(f.type === 'select' ? 'text' : (f.type ?? 'text')) as any} name={f.name} placeholder={f.placeholder} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                        </div>
                      );
                    }
                    return (
                      <div class={`grid grid-cols-1 sm:grid-cols-${row.length} gap-4`}>
                        {row.map((f) => {
                          if (f.withCountryCode) {
                            return (
                              <div>
                                <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                                <div class="flex gap-2">
                                  <select name={`${f.name}_countryCode`} data-tel-country class="py-2 px-2 block w-40 text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" aria-label={_ui('contact.countryCode', 'Country code')}>
                                    {countryCodes.map((c) => (<option value={c.code} selected={c.code === defaultCountryCode}>{c.label}</option>))}
                                  </select>
                                  <input id={`${id}-${f.name}`} type="tel" name={f.name} inputmode="numeric" placeholder={f.placeholder ?? '555 123 4567'} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                                </div>
                              </div>
                            );
                          }
                          if (f.type === 'select') {
                            const opts = resolveOptions(f);
                            return (
                              <div>
                                <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                                <select id={`${id}-${f.name}`} name={f.name} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" required>
                                  {opts.map((o) => (<option value={o.value}>{o.label}</option>))}
                                </select>
                              </div>
                            );
                          }
                          return (
                            <div>
                              <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                              <input id={`${id}-${f.name}`} type={(f.type === 'email' ? 'email' : f.type === 'tel' ? 'tel' : 'text') as any} name={f.name} placeholder={f.placeholder} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                            </div>
                          );
                        })}
                      </div>
                    );
                  });
                })()}
              </div>
              {si < steps.length - 1 && (
                <div class="mt-6 flex justify-end">
                  <button type="button" data-step-next class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full transition-all text-sm">
                    {stepLabels[si] || `Step ${si + 1}`} →
                  </button>
                </div>
              )}
            </div>
          ))
        ) : (
          <div class="space-y-7">
            {rows.map((rowIdx) => {
              const row = grouped[rowIdx];
              const isWide = row.length === 1 && (row[0].type === 'textarea' || row[0].type === 'text' || row[0].type === 'email');
              if (isWide) {
                const f = row[0];
                if (f.type === 'textarea') {
                  return (
                    <div>
                      <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                      <textarea id={`${id}-${f.name}`} name={f.name} rows={f.rows ?? 4} placeholder={f.placeholder} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                    </div>
                  );
                }
                return (
                  <div>
                    <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                    <input id={`${id}-${f.name}`} type={(f.type === 'select' ? 'text' : (f.type ?? 'text')) as any} name={f.name} placeholder={f.placeholder} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                  </div>
                );
              }
              return (
                <div class={`grid grid-cols-1 sm:grid-cols-${row.length} gap-4`}>
                  {row.map((f) => {
                    if (f.withCountryCode) {
                      return (
                        <div>
                          <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                          <div class="flex gap-2">
                            <select name={`${f.name}_countryCode`} data-tel-country class="py-2 px-2 block w-40 text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" aria-label={_ui('contact.countryCode', 'Country code')}>
                              {countryCodes.map((c) => (<option value={c.code} selected={c.code === defaultCountryCode}>{c.label}</option>))}
                            </select>
                            <input id={`${id}-${f.name}`} type="tel" name={f.name} inputmode="numeric" placeholder={f.placeholder ?? '555 123 4567'} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                          </div>
                        </div>
                      );
                    }
                    if (f.type === 'select') {
                      const opts = resolveOptions(f);
                      return (
                        <div>
                          <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                          <select id={`${id}-${f.name}`} name={f.name} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" required>
                            {opts.map((o) => (<option value={o.value}>{o.label}</option>))}
                          </select>
                        </div>
                      );
                    }
                    return (
                      <div>
                        <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">{f.label}</label>
                        <input id={`${id}-${f.name}`} type={(f.type === 'email' ? 'email' : f.type === 'tel' ? 'tel' : 'text') as any} name={f.name} placeholder={f.placeholder} class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" />
                      </div>
                    );
                  })}
                </div>
              );
            })}
          </div>
        )}
      </div>

      {steps.length > 1 && (
        <div class="flex items-center justify-between pt-4" data-step-nav style="display:none">
          <button type="button" data-step-back class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 text-muted font-medium rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm">
            ← Back
          </button>
          <button type="submit" class="inline-flex items-center gap-2 px-8 py-3 bg-primary hover:bg-[#0088B3] text-white font-semibold rounded-full transition-all text-sm" data-submit-button style="display:none">
            {submitButton}
          </button>
        </div>
      )}

      {consent && (
        <div class="pt-2 border-t border-gray-200 dark:border-gray-700">
          <label class="flex items-start gap-3 text-sm text-muted dark:text-slate-300 cursor-pointer select-none">
            <input type="checkbox" name="consent" data-consent data-consent-error={consentError} required={consentRequired} class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary cursor-pointer" />
            <span class="leading-relaxed">
              {consentText}{' '}
              <a href={consentLinkHref} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2 hover:text-secondary dark:text-blue-400">{consentLinkText}</a>.
            </span>
          </label>
          <p data-consent-error class="hidden mt-1 text-xs text-red-600 dark:text-red-400" />
        </div>
      )}

      {steps.length <= 1 && (
        <div class="pt-2">
          <Button type="submit" variant="primary" data-submit-button>{submitButton}</Button>
        </div>
      )}

      <div data-form-status class="hidden text-sm font-medium"></div>
    </form>
  </div>
</WidgetWrapper>

<script is:inline>
  (function () {
    const FORMS_KEY = 'afarer_partial_form';

    // Abandonment recovery: save partial input to localStorage
    function savePartialData(formEl) {
      const fd = new FormData(formEl);
      const data = {};
      for (const [k, v] of fd.entries()) {
        if (typeof v === 'string' && v.trim()) data[k] = v.trim();
      }
      if (Object.keys(data).length > 0) {
        try { localStorage.setItem(FORMS_KEY, JSON.stringify(data)); } catch (_) {}
      }
    }

    // Restore partial data on load
    function restorePartialData(formEl) {
      try {
        const raw = localStorage.getItem(FORMS_KEY);
        if (!raw) return;
        const data = JSON.parse(raw);
        for (const [name, value] of Object.entries(data)) {
          if (typeof value !== 'string') continue;
          const el = formEl.querySelector(`[name="${name}"]`);
          if (el && (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement)) {
            el.value = value;
          }
        }
      } catch (_) {}
    }

    // Clear saved data after successful submit
    function clearPartialData() {
      try { localStorage.removeItem(FORMS_KEY); } catch (_) {}
    }

    // Warn before leaving with unsaved data
    function hasUnsavedData(formEl) {
      const fd = new FormData(formEl);
      for (const [, v] of fd.entries()) {
        if (typeof v === 'string' && v.trim()) return true;
      }
      return false;
    }

    const forms = document.querySelectorAll('form[data-contact-form]');
    forms.forEach((formEl) => {
      if (!(formEl instanceof HTMLFormElement)) return;
      const isMultiStep = formEl.dataset.multistep === 'true';
      const statusEl = formEl.querySelector('[data-form-status]');
      const successMsg = formEl.dataset.successMessage || 'Thanks!';
      const errorMsg = formEl.dataset.errorMessage || 'Something went wrong.';
      const consentEl = formEl.querySelector('[data-consent]');
      const consentErrorEl = formEl.querySelector('[data-consent-error]');

      // Multi-step navigation
      if (isMultiStep) {
        let currentStep = 1;
        const steps = formEl.querySelectorAll('[data-step]');
        const dots = formEl.querySelectorAll('[data-step-dot]');
        const nav = formEl.querySelector('[data-step-nav]');
        const backBtn = formEl.querySelector('[data-step-back]');
        const submitBtn = formEl.querySelector('[data-submit-button]');
        const nextBtns = formEl.querySelectorAll('[data-step-next]');
        const totalSteps = steps.length;

        function showStep(step) {
          steps.forEach((s, i) => {
            s.style.display = i + 1 === step ? 'block' : 'none';
          });
          dots.forEach((d, i) => {
            d.classList.toggle('bg-primary', i + 1 === step);
            d.classList.toggle('text-white', i + 1 === step);
            d.classList.toggle('bg-gray-200', i + 1 !== step);
            d.classList.toggle('text-muted', i + 1 !== step);
          });
          if (nav) nav.style.display = 'flex';
          if (backBtn) backBtn.style.display = step === 1 ? 'none' : 'inline-flex';
          if (submitBtn) submitBtn.style.display = step === totalSteps ? 'inline-flex' : 'none';
          currentStep = step;
        }

        nextBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            if (currentStep < totalSteps) showStep(currentStep + 1);
          });
        });

        if (backBtn) {
          backBtn.addEventListener('click', () => {
            if (currentStep > 1) showStep(currentStep - 1);
          });
        }

        showStep(1);
      }

      // Abandonment recovery: restore & track
      restorePartialData(formEl);
      formEl.addEventListener('input', function () { savePartialData(formEl); });

      // Warn before leaving
      let formSubmitted = false;
      formEl.addEventListener('submit', function () { formSubmitted = true; });
      window.addEventListener('beforeunload', function (e) {
        if (!formSubmitted && hasUnsavedData(formEl)) {
          e.preventDefault();
          e.returnValue = '';
        }
      });

      formEl.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!(formEl instanceof HTMLFormElement)) return;
        if (consentErrorEl) {
          consentErrorEl.classList.add('hidden');
          consentErrorEl.textContent = '';
        }
        if (consentEl instanceof HTMLInputElement && consentEl.required && !consentEl.checked) {
          if (consentErrorEl) {
            consentErrorEl.textContent =
              consentEl.dataset.consentError || 'Please confirm that you accept the Privacy Policy before submitting.';
            consentErrorEl.classList.remove('hidden');
          }
          consentEl.focus();
          return;
        }

        const submitBtn = formEl.querySelector('[data-submit-button]');
        const submitLabel = submitBtn ? submitBtn.textContent || 'Send message' : 'Send message';
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';
        }

        const fd = new FormData(formEl);
        const data = {};
        for (const [k, v] of fd.entries()) {
          if (typeof v === 'string') data[k] = v.trim();
        }
        const cc = data.tel_countryCode || '';
        if (data.tel) data.tel = `${cc} ${data.tel}`.trim();
        delete data.tel_countryCode;
        if (consentEl instanceof HTMLInputElement) data.consent = consentEl.checked ? 'true' : 'false';

        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 15000);
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
            signal: controller.signal,
          });
          clearTimeout(timeoutId);
          const result = await res.json().catch(() => ({}));
          if (!res.ok || !result.success) {
            console.error('Contact form API error:', res.status, result.error || result);
            showStatus(statusEl, result.error || errorMsg, 'error');
            return;
          }
          showStatus(statusEl, successMsg, 'success');
          console.log('Contact form success:', result);
          clearPartialData();
          formEl.reset();
        } catch (fetchErr) {
          console.error('Contact form fetch error:', fetchErr);
          showStatus(statusEl, 'Network error — please check your connection and try again.', 'error');
        } finally {
          if (submitBtn instanceof HTMLButtonElement) {
            submitBtn.disabled = false;
            submitBtn.textContent = submitLabel;
          }
        }
      });
    });

    function showStatus(el, msg, kind) {
      if (!el) return;
      el.classList.remove('hidden', 'text-green-600', 'text-red-600', 'dark:text-green-400', 'dark:text-red-400');
      if (kind === 'success') {
        el.classList.add('text-green-600', 'dark:text-green-400');
      } else {
        el.classList.add('text-red-600', 'dark:text-red-400');
      }
      el.textContent = msg;
    }
  })();
</script>
