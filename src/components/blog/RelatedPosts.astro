---
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import BlogHighlightedPosts from '../widgets/BlogHighlightedPosts.astro';
import type { Post } from '~/types';
import { getBlogPermalink } from '~/utils/permalinks';
import { getLangFromUrl } from '~/i18n/utils';
import { getUiForLang } from '~/i18n/generated/ui-all';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const _ = (k: string) => getUiForLang(currentLang)?.[k] || getUiForLang('en')?.[k] || '';

const relatedPosts = post.tags ? await getRelatedPosts(post, 4, currentLang) : [];
---

{
  APP_BLOG.isRelatedPostsEnabled ? (
    <BlogHighlightedPosts
      classes={{
        container:
          'pt-0 lg:pt-0 md:pt-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
      }}
      title={_('related.posts') || 'Related Posts'}
      linkText={_('related.viewAll') || 'View All Posts'}
      linkUrl={getBlogPermalink()}
      postIds={relatedPosts.map((post) => post.id)}
    />
  ) : null
}
