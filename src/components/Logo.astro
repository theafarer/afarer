---
/* eslint-disable @typescript-eslint/no-explicit-any */

import cfg from '~/config.yaml';
const branding = (cfg as any)?.branding || {};
const siteName = branding?.site_name?.trim() || 'Afarer';
const logoImage = branding?.logo_image?.trim() || '';
const logoAlt = branding?.logo_alt?.trim() || `${siteName} logo`;
---

<a href="/" class="flex items-center gap-3 group" aria-label={`${siteName} home`}>
  {
    logoImage ? (
      <img
        src={logoImage}
        alt={logoAlt}
        class="h-10 w-10 rounded-lg object-cover shadow-sm group-hover:shadow-md transition-shadow"
        loading="eager"
      />
    ) : (
      <span
        class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary text-white font-black text-lg shadow-sm group-hover:shadow-md transition-shadow"
        aria-hidden="true"
      >
        A
      </span>
    )
  }
  <div class="flex flex-col">
    <span class="text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white tracking-tight leading-none">
      {siteName.toUpperCase()}
    </span>
    <span
      class="text-[10px] font-medium text-gray-500 dark:text-gray-400 tracking-widest uppercase leading-tight mt-0.5"
    >
      Water Adventure Equipment
    </span>
  </div>
</a>
