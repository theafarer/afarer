---
interface FinderProduct {
  slug: string;
  title: string;
  url: string;
  image: string;
  series: string;
  seriesLabel: string;
  length: string;
  width: string;
  maxLoad: string;
  maxLoadLbs: number | null;
  price: string | null;
}

interface Props {
  finder: Record<string, string>;
  specLabels: Record<string, string>;
  products: FinderProduct[];
  compareUrl: string;
}

const { finder = {}, specLabels = {}, products = [], compareUrl = '#' } = Astro.props as Props;

const expOptions = [
  { value: 'beginner', label: finder.exp_beginner || 'Beginner', hint: finder.exp_beginner_hint || '' },
  { value: 'intermediate', label: finder.exp_intermediate || 'Intermediate', hint: finder.exp_intermediate_hint || '' },
  { value: 'advanced', label: finder.exp_advanced || 'Advanced', hint: finder.exp_advanced_hint || '' },
];

const useOptions = [
  { value: 'allaround', label: finder.use_allaround || 'All-Around & Recreation' },
  { value: 'touring', label: finder.use_touring || 'Touring & Distance' },
  { value: 'yoga', label: finder.use_yoga || 'Yoga & Fitness' },
  { value: 'fishing', label: finder.use_fishing || 'Fishing' },
  { value: 'performance', label: finder.use_performance || 'Surf, Race & Whitewater' },
  { value: 'family', label: finder.use_family || 'Family & Multi-Person' },
  { value: 'kids', label: finder.use_kids || 'Kids & Teens' },
];

const weightOptions = [
  { value: 'lt140', label: finder.w_lt140 || 'Under 140 lbs (64 kg)' },
  { value: '140_180', label: finder.w_140_180 || '140-180 lbs (64-82 kg)' },
  { value: '180_230', label: finder.w_180_230 || '180-230 lbs (82-104 kg)' },
  { value: 'gt230', label: finder.w_gt230 || 'Over 230 lbs (104 kg)' },
];

const finderProductsJson = JSON.stringify(products);
const finderStringsJson = JSON.stringify({
  badge_best: finder.badge_best || 'Best Match',
  view_details: finder.view_details || 'View details',
});
const specLabelsJson = JSON.stringify({
  length: specLabels.length || 'Length',
  width: specLabels.width || 'Width',
  max_load: specLabels.max_load || 'Max Load',
});
---

<section
  id="board-finder"
  class="mt-12 p-6 md:p-8 bg-white rounded-2xl border border-gray-200 shadow-sm"
  data-finder-count={products.length}
>
  <h2 class="text-2xl md:text-3xl font-semibold text-gray-900">{finder.title || 'Find Your Board'}</h2>
  <p class="mt-2 text-gray-500">
    {finder.subtitle || 'Answer three quick questions and we will match you with the right board.'}
  </p>

  <div class="mt-8 grid gap-8 lg:grid-cols-3">
    <div data-finder-group="experience">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">
        {finder.q_experience || 'Your paddling experience'}
      </h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          expOptions.map((o) => (
            <button
              type="button"
              data-value={o.value}
              data-group="experience"
              class="finder-chip px-4 py-2 rounded-xl border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:border-sky-400 hover:text-sky-600 transition-colors text-left"
            >
              {o.label}
              {o.hint && <span class="chip-hint block text-xs font-normal text-gray-400">{o.hint}</span>}
            </button>
          ))
        }
      </div>
    </div>

    <div data-finder-group="use">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">
        {finder.q_use || 'How will you use your board?'}
      </h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          useOptions.map((o) => (
            <button
              type="button"
              data-value={o.value}
              data-group="use"
              class="finder-chip px-4 py-2 rounded-xl border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:border-sky-400 hover:text-sky-600 transition-colors text-left"
            >
              {o.label}
            </button>
          ))
        }
      </div>
    </div>

    <div data-finder-group="weight">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">{finder.q_weight || 'Rider weight'}</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          weightOptions.map((o) => (
            <button
              type="button"
              data-value={o.value}
              data-group="weight"
              class="finder-chip px-4 py-2 rounded-xl border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:border-sky-400 hover:text-sky-600 transition-colors text-left"
            >
              {o.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="mt-10 border-t border-gray-100 pt-8">
    <div class="flex items-center justify-between flex-wrap gap-3">
      <h3 class="text-xl font-semibold text-gray-900">{finder.results_title || 'Your matches'}</h3>
      <div class="flex items-center gap-4 text-sm">
        <button type="button" id="finder-reset" class="font-medium text-gray-500 hover:text-gray-700 transition-colors">
          {finder.start_over || 'Start over'}
        </button>
        <a href={compareUrl} class="font-medium text-sky-600 hover:text-sky-700 transition-colors">
          {finder.compare_all || 'Compare all boards'}
        </a>
      </div>
    </div>
    <p id="finder-hint" class="mt-3 text-gray-500">
      {finder.results_hint || 'Select your experience, planned use, and rider weight to see your board matches.'}
    </p>
    <div id="finder-results" class="mt-6 grid gap-6 md:grid-cols-3"></div>
  </div>
</section>

<style>
  .finder-chip[data-selected] {
    border-color: #0ea5e9;
    background: #0ea5e9;
    color: #ffffff;
  }
  .finder-chip[data-selected]:hover {
    color: #ffffff;
  }
  .finder-chip[data-selected] .chip-hint {
    color: rgba(255, 255, 255, 0.75);
  }
</style>
<script is:inline define:vars={{ finderProductsJson, finderStringsJson, specLabelsJson }}>
  (function () {
    const root = document.getElementById('board-finder');
    if (!root) return;
    const P = JSON.parse(finderProductsJson);
    const S = JSON.parse(finderStringsJson);
    const L = JSON.parse(specLabelsJson);
    const state = { experience: null, use: null, weight: null };
    const USE_SERIES = {
      allaround: ['all-around', 'mini', 'yoga'],
      touring: ['touring', 'all-around'],
      yoga: ['yoga', 'all-around'],
      fishing: ['fishing', 'multi-purpose', 'all-around'],
      performance: ['surf', 'race', 'whitewater'],
      family: ['multi-person', 'all-around'],
      kids: ['kids-teens', 'mini'],
    };
    const RIDER = { lt140: 130, '140_180': 160, '180_230': 205, gt230: 255 };
    const BEGINNER_OK = ['all-around', 'mini', 'kids-teens', 'yoga', 'multi-person'];
    const ADV = ['race', 'surf', 'whitewater'];

    function scoreOf(p, strict) {
      const series = USE_SERIES[state.use] || [];
      let s = 0;
      if (series.indexOf(p.series) === 0) s += 4;
      else if (series.indexOf(p.series) > -1) s += 2;
      if (state.experience === 'beginner') {
        if (BEGINNER_OK.indexOf(p.series) > -1) s += 2;
        if (ADV.indexOf(p.series) > -1) s -= 4;
      } else if (state.experience === 'advanced' && ADV.indexOf(p.series) > -1) {
        s += 2;
      }
      if (p.maxLoadLbs) {
        if (p.maxLoadLbs >= RIDER[state.weight] + 25) s += 2;
        else if (p.maxLoadLbs < RIDER[state.weight]) {
          if (strict) return null;
        }
      }
      return s;
    }

    function esc(v) {
      return String(v == null ? '' : v)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function card(p, i) {
      const badge =
        i === 0
          ? '<span class="finder-badge absolute top-3 left-3 z-10 px-2.5 py-1 bg-sky-500 text-white text-xs font-semibold rounded-full">' +
            esc(S.badge_best) +
            '</span>'
          : '';
      return (
        '<a href="' +
        esc(p.url) +
        '" class="block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow">' +
        '<div class="relative">' +
        badge +
        '<img src="' +
        esc(p.image) +
        '" alt="' +
        esc(p.title) +
        '" class="w-full h-40 object-cover" loading="lazy" />' +
        '</div>' +
        '<div class="p-4">' +
        '<div class="text-xs uppercase tracking-wider text-sky-600 font-medium">' +
        esc(p.seriesLabel) +
        '</div>' +
        '<div class="mt-1 font-semibold text-gray-900">' +
        esc(p.title) +
        '</div>' +
        '<div class="mt-3 grid grid-cols-3 gap-2 text-xs">' +
        '<div><div class="text-gray-400">' +
        esc(L.length) +
        '</div><div class="text-gray-700 font-medium">' +
        esc(p.length) +
        '</div></div>' +
        '<div><div class="text-gray-400">' +
        esc(L.width) +
        '</div><div class="text-gray-700 font-medium">' +
        esc(p.width) +
        '</div></div>' +
        '<div><div class="text-gray-400">' +
        esc(L.max_load) +
        '</div><div class="text-gray-700 font-medium">' +
        esc(p.maxLoad) +
        '</div></div>' +
        '</div>' +
        (p.price ? '<div class="mt-3 font-semibold text-gray-900">' + esc(p.price) + '</div>' : '') +
        '<div class="mt-3 text-sm font-medium text-sky-600">' +
        esc(S.view_details) +
        ' &rarr;</div>' +
        '</div></a>'
      );
    }

    const resultsEl = root.querySelector('#finder-results');
    const hintEl = root.querySelector('#finder-hint');

    function render() {
      if (!state.experience || !state.use || !state.weight) return;
      const strict = P.map(function (p) {
        return { p: p, s: scoreOf(p, true) };
      }).filter(function (x) {
        return x.s !== null;
      });
      let list = strict;
      if (list.length === 0) {
        list = P.map(function (p) {
          return { p: p, s: scoreOf(p, false) };
        });
      }
      list.sort(function (a, b) {
        return b.s - a.s;
      });
      resultsEl.innerHTML = list
        .slice(0, 3)
        .map(function (x, i) {
          return card(x.p, i);
        })
        .join('');
      hintEl.style.display = 'none';
    }

    root.querySelectorAll('[data-value]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const group = btn.getAttribute('data-group');
        state[group] = btn.getAttribute('data-value');
        root.querySelectorAll('[data-value][data-group="' + group + '"]').forEach(function (b) {
          b.removeAttribute('data-selected');
        });
        btn.setAttribute('data-selected', 'true');
        render();
      });
    });

    root.querySelector('#finder-reset').addEventListener('click', function () {
      state.experience = null;
      state.use = null;
      state.weight = null;
      root.querySelectorAll('[data-value]').forEach(function (b) {
        b.removeAttribute('data-selected');
      });
      resultsEl.innerHTML = '';
      hintEl.style.display = '';
    });
  })();
</script>
